    <sys:String x:Key="str.Credit.AuthorUrl">https://opencheattables.com</sys:String>
    <sys:String x:Key="str.Credit.RepoPrefix">Repository: </sys:String>
    <sys:String x:Key="str.Credit.RepoUrl">https://github.com/bbfox0703/UE5CEDumper</sys:String>
    <sys:String x:Key="str.Credit.OpenInBrowserTip">Open in default browser</sys:String>

    <!-- Experimental features gate (System-tab credit checkbox) -->
    <sys:String x:Key="str.Experimental.EnableHint">Enable advanced experimental features</sys:String>

    <!-- Snapshot tab (experimental — Phase A) -->
    <sys:String x:Key="str.Snapshot.Intro">捕获指定范围内所有对象的数字UPROPERTY字段并持久化保存为快照。快照可用于序列查询、类数据透视功能。开启原生C选项可一并捕获无反射原生内存数值。</sys:String>
    <sys:String x:Key="str.Snapshot.NativeC">原生C原始内存</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.NativeC">可选功能，默认关闭。除反射属性外，将对象无托管原始内存区块生成虚拟字段，通过数据猜测算法解析为标准数字类型，指针/填充字节会过滤掉。开启后序列查询、数据透视可识别血量这类无反射原生数值。捕获速度变慢、快照体积更大；原始字段依靠偏移匹配快照，极少情况下字段类型识别变化会导致跨快照匹配失败。</sys:String>
    <sys:String x:Key="str.Snapshot.CaptureHeader">捕获快照</sys:String>
    <sys:String x:Key="str.Snapshot.CompareHeader">快照对比</sys:String>
    <sys:String x:Key="str.Snapshot.NotConnected">请先连接游戏进程再捕获快照</sys:String>
    <sys:String x:Key="str.Snapshot.Scope">捕获范围：</sys:String>
    <sys:String x:Key="str.Snapshot.Family">数值类型：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Family">在捕获范围基础上进一步筛选数值。全部数字：捕获所有数字类型；仅整数：只保留各类整型，剔除浮点；仅浮点：只保留单/双精度浮点。属于源头过滤，可大幅缩小快照体积；仅查坐标/血量选浮点，计数/ID选整数。该筛选会丢失另一类数据，如需切换需重新捕获。</sys:String>
    <sys:String x:Key="str.Snapshot.MaxDataset">快照最大容量：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.MaxDataset">捕获过程上限开关，到达上限会停止并保留不完整快照。关闭则无限制。与单游戏配额区分：配额是捕获完成后自动删除旧快照，无法限制单次超大捕获；大型游戏建议开启上限并先预估体积。</sys:String>
    <sys:String x:Key="str.Snapshot.Estimate">预估占用</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Estimate">预检测功能，抽样遍历部分对象，按当前配置推算完整快照磁盘占用，不会写入数据库。超大游戏捕获前可先预估，避免生成数GB文件。</sys:String>
    <sys:String x:Key="str.Snapshot.GameOnly">仅游戏自定义对象</sys:String>
    <sys:String x:Key="str.Snapshot.AutoSkipNoise">自动过滤引擎冗余对象</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.AutoSkipNoise">默认开启，捕获源头直接过滤UI、贴图、粒子、动画等引擎内置类，快照更小、捕获更快。过滤不可逆，关闭后重新捕获才能找回引擎类数据。角色、组件、控制器等游戏实体强制保留，坐标、GAS血量不会被过滤。数值搜索、实例查找共用这套过滤逻辑。</sys:String>
    <sys:String x:Key="str.Snapshot.Label">标签：</sys:String>
    <sys:String x:Key="str.Snapshot.LabelWatermark">选填，留空默认时间戳</sys:String>
    <sys:String x:Key="str.Snapshot.Capture">开始捕获</sys:String>
    <sys:String x:Key="str.Snapshot.Cancel">取消</sys:String>
    <sys:String x:Key="str.Snapshot.Refresh">刷新快照列表</sys:String>
    <sys:String x:Key="str.Snapshot.Delete">删除选中快照</sys:String>
    <sys:String x:Key="str.Snapshot.DeleteAll">删除全部快照</sys:String>
    <sys:String x:Key="str.Snapshot.DeleteAllTip">清空当前游戏所有快照数据库并回收磁盘空间，操作不可逆。</sys:String>
    <sys:String x:Key="str.Snapshot.OpenDbFolder">打开数据库目录</sys:String>
    <sys:String x:Key="str.Snapshot.OpenDbFolderTip">打开当前游戏快照数据库文件夹，21天未连接的游戏会在程序启动时自动删除对应库文件。</sys:String>
    <sys:String x:Key="str.Snapshot.Quota">单游戏存储配额：</sys:String>
    <sys:String x:Key="str.Snapshot.QuotaHint">捕获后若超出配额，自动删除该游戏最早的快照释放空间。</sys:String>
    <sys:String x:Key="str.Snapshot.Usage">已占用：</sys:String>
	
    <!-- Free-disk-space guard (blocks ALL captures) -->
    <sys:String x:Key="str.Snapshot.MinFreeDisk">磁盘最低剩余空间：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.MinFreeDisk">磁盘空间安全阈值。所有快照捕获（手动/自动）执行前，都会校验快照所在磁盘剩余空间，不足则直接终止捕获。
系统会取两项规则里数值更小的一项作为判定标准：磁盘总容量百分比 或是 固定GB下限。
示例：1TB硬盘设置10%+50GB → 最低预留50GB；200GB硬盘设置10%+50GB → 最低预留20GB。
将百分比设为0，即可仅使用固定GB数值作为唯一判定依据。</sys:String>

	
    <!-- Auto snapshot (periodic capture) -->
    <sys:String x:Key="str.Snapshot.Auto.Header">自动快照</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.On">开启</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Off">关闭</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Interval">间隔(秒)：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.Interval">两次自动快照**起始时刻**的目标间隔（默认900秒=15分钟，最小60秒）。若单次捕获耗时超过设定间隔，系统会自动顺延；两次快照结束与开始之间至少预留60秒空闲缓冲，给游戏留出运行余量。自动快照不会压低扫描线程优先级，避免游戏繁忙时捕获进程被抢占停滞。</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Retention">留存规则：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.Retention">
保留最新：持续循环捕获，仅留存最新N份快照，旧快照自动清理；
固定次数：本次会话仅捕获N次后停止，全部快照都会保留，同时仍受单游戏存储配额限制。
</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Count">数量(N)：</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.AdjustQuota">自动扩容配额</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.AdjustQuota">默认关闭：总占用严格遵循单游戏配额；若配额仅够存放一份快照、无法满足你设定的留存数量，自动快照将会暂停。
开启后：当现有配额不足以容纳所需快照数量时，会逐级上调预设配额上限（最高无限制）；磁盘剩余空间限制始终为硬性最高门槛。</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Hint">无人值守定时抓取快照。此开关需要手动开启，连接游戏、重启软件均不会自动启动；仅配置参数会被保存。正在执行的自动快照可点击取消终止。</sys:String>
    <sys:String x:Key="str.Snapshot.Saved">已保存快照列表</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Size">预估大小</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Label">标签</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Captured">捕获时间(世界标准时间)</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Objects">对象总数</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Fields">字段总数</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Scope">捕获范围</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Ue">引擎版本</sys:String>
	
    <!-- Snapshot diff -->
    <sys:String x:Key="str.Snapshot.Diff.Old">旧快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.New">新快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Run">开始对比</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.DeepNote">对比默认开启深层遍历</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.DeepNote">快照差异对比会自动检测嵌套数组、结构体数组内部元素变动（例如 SupportActionGauge[3]，展示格式为 Array[N]），无需额外开启深度选项。深度开关仅存在于分组模式中，用于将数组成员纳入分组匹配范围。</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ClassFilter">类筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.PropFilter">字段筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Dir">变动类型：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.CopyAddr">复制地址</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.OpenWalker">实时查看</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.LocateGWorld">🌍</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.LocateGWorld">GWorld定位：检索从GWorld到当前归属对象的最短指针链路，在实时浏览器打开并跳转至变动字段；仅支持本次游戏会话内的快照对比</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.LocateGameEngine">⚙</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.LocateGameEngine">GameEngine定位：检索从运行中的UGameEngine到归属对象的最短指针路径，跳转至变动字段；可定位GWorld无法触及的引擎层级对象，绝大多数场景实体推荐使用GWorld定位</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ObjectFilter">对象筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Global">全局检索：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.GlobalHint">匹配任意列内容...</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.OldRange">旧值区间：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.NewRange">新值区间：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ApplyRange">应用区间</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ResetRange">重置</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Hint">快照对比依靠对象唯一标识匹配数据，仅限同一次游戏进程启动内的两份快照进行比对。</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Change">变动</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Class">所属类</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Object">对象</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Field">字段</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Old">原值</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.New">新值</sys:String>


    <!-- Snapshot Group Match (Multiple Values over a captured snapshot) -->
    <sys:String x:Key="str.Snapshot.Group.ModeLabel">模式：</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ModeDiff">差异对比</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ModeGroup">多值联合检索</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Snapshot">快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Find">开始检索</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Clear">清空列表</sys:String>
    <sys:String x:Key="str.Snapshot.Group.AddRow">+ 添加数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.RemoveRow">− 移除数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Deep">深度检索（嵌套容器）</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.Deep">可匹配嵌套结构体、数组内部数值（例如深层嵌套 SaveSlotList[1]…Tunes[2]），归属至外层父对象。血量、属性存放在数组/容器内时需要开启；关闭仅检索一级直属字段，速度更快、冗余数据更少。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ValueHint">数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Value2Hint">至</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CompareWith">参照快照：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.CompareWith">选择一份较早快照作为对比基准，即可启用相对判定条件：数值变动/未变动、上升、下降。例：查找当前血量下降、最大血量保持不变的玩家对象。留空则仅在单快照内进行固定数值匹配。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CompareClear">✕</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.CompareClear">清空参照快照，切换回单快照固定数值检索模式。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Hint">检索同时包含2~4组指定数值、且存储在不同内存偏移的游戏对象。参照快照留空：单快照绝对值匹配；选定旧快照：跨时间状态比对，支持血量下降、上限不变这类组合条件。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Class">所属类</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Object">对象实例</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Matched">匹配数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.OpenWalker">实时查看</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CopyAddr">复制地址</sys:String>
    <sys:String x:Key="str.Snapshot.Group.LocateGWorld">🌍</sys:String>
    <sys:String x:Key="str.Snapshot.Group.LocateGameEngine">⚙</sys:String>

	<!-- SPC Query (experimental) -->
	<sys:String x:Key="str.Spc.Intro">依据字段在多份快照里的数值变化趋势链检索内存字段，无需限定具体数值与数据类型。选取两份及以上快照（可跨游戏重启会话），依次设定每份快照相对前一份的变化规则（上升/下降/不变/发生变动）后执行检索。该功能是CE未知初始数值扫描+增减扫描的升级版，支持持久快照存储与游戏重启后接续检索。</sys:String>
	<sys:String x:Key="str.Spc.Join">匹配规则：</sys:String>
	<sys:String x:Key="str.Spc.JoinHint">严格匹配：类一致+标准化字段路径+内存偏移，误报最少；宽松匹配：类+外层层级+字段名称，可找回跨会话重生生成的对象；本次会话内：仅限同一次游戏启动进程，匹配精度最高。</sys:String>
	<sys:String x:Key="str.Spc.ClassFilter">类筛选：</sys:String>
	<sys:String x:Key="str.Spc.PropFilter">字段筛选：</sys:String>
	<sys:String x:Key="str.Spc.ResClass">所属类</sys:String>
	<sys:String x:Key="str.Spc.ResField">字段</sys:String>
	<sys:String x:Key="str.Spc.ResObject">对象</sys:String>
	<sys:String x:Key="str.Spc.ResGlobal">全局检索：</sys:String>
	<sys:String x:Key="str.Spc.ResGlobalHint">匹配列表任意列内容……</sys:String>
	<sys:String x:Key="str.Spc.SeqFirst">数值下限：</sys:String>
	<sys:String x:Key="str.Spc.SeqLast">数值上限：</sys:String>
	<sys:String x:Key="str.Spc.ApplyRange">应用区间</sys:String>
	<sys:String x:Key="str.Spc.ResetRange">重置</sys:String>
	<sys:String x:Key="str.Spc.Run">执行序列检索(SPC)</sys:String>
	<sys:String x:Key="str.Spc.Refresh">刷新列表</sys:String>
	<sys:String x:Key="str.Spc.OpenWalker">实时查看</sys:String>
	<sys:String x:Key="str.Spc.LocateGWorld">🌍</sys:String>
	<sys:String x:Key="str.Tip.Spc.LocateGWorld">GWorld定位：解析从GWorld到目标归属对象的最短指针路径，在实时浏览器打开并跳转至变动字段</sys:String>
	<sys:String x:Key="str.Spc.LocateGameEngine">⚙</sys:String>
	<sys:String x:Key="str.Tip.Spc.LocateGameEngine">GameEngine定位：解析从运行态UGameEngine到归属对象的最短指针链路，跳转至变动字段；可访问GWorld无法覆盖的引擎层级对象，绝大多数场景实体优先选用GWorld定位</sys:String>
	<sys:String x:Key="str.Spc.CopyAddr">复制地址</sys:String>
	<sys:String x:Key="str.Spc.PickerHeader">快照序列配置</sys:String>
	<sys:String x:Key="str.Spc.BaselineHint">勾选的最早快照作为基准快照，其对比规则不生效；后续每份快照均与前一份勾选快照做数值对比。检索命中后，复制地址、实时查看功能会将最新快照的运行内存地址发送至Cheat Engine。</sys:String>
	<sys:String x:Key="str.Spc.Col.Use">选用</sys:String>
	<sys:String x:Key="str.Spc.Col.Label">快照标签</sys:String>
	<sys:String x:Key="str.Spc.Col.Captured">捕获时间(UTC)</sys:String>
	<sys:String x:Key="str.Spc.Col.Session">游戏会话</sys:String>
	<sys:String x:Key="str.Spc.Col.Predicate">对比规则</sys:String>
	<sys:String x:Key="str.Spc.Col.ValueFilter">数值筛选</sys:String>
	<sys:String x:Key="str.Spc.Col.Preview">匹配预览</sys:String>
	<sys:String x:Key="str.Spc.Res.Class">类名</sys:String>
	<sys:String x:Key="str.Spc.Res.Object">对象实例</sys:String>
	<sys:String x:Key="str.Spc.Res.Field">字段名称</sys:String>
	<sys:String x:Key="str.Spc.Res.Type">数据类型</sys:String>
	<sys:String x:Key="str.Spc.Res.Sequence">数值变化序列</sys:String>


	<!-- SPC GROUP (multiple values) — Single/Group toggle + matrix editor -->
	<sys:String x:Key="str.Spc.Group.ModeLabel">检索模式：</sys:String>
	<sys:String x:Key="str.Spc.Group.ModeSingle">单字段序列检索</sys:String>
	<sys:String x:Key="str.Spc.Group.ModeGroup">多字段组合序列检索</sys:String>
	<sys:String x:Key="str.Spc.Group.Intro">查找同时包含2~4处不同内存偏移字段的游戏对象，且每个字段各自遵循独立的数值变化趋势链。示例：当前血量走势：基准→下降→回升；最大血量走势：基准→不变→不变（完整血量→受损→回血）。先勾选上方快照，选中一组数值并为每一段快照设定对比规则与数值区间，依次配置全部条件；执行检索后，会筛选出所有同时满足整套变化规律的对象。</sys:String>
	<sys:String x:Key="str.Spc.Group.Run">开始组合检索</sys:String>
	<sys:String x:Key="str.Spc.Group.Clear">清空配置</sys:String>
	<sys:String x:Key="str.Spc.Group.AddSlot">+ 添加数值条件</sys:String>
	<sys:String x:Key="str.Spc.Group.RemoveSlot">− 移除数值条件</sys:String>
	<sys:String x:Key="str.Spc.Group.Editing">当前编辑项：</sys:String>
	<sys:String x:Key="str.Spc.Group.EditingHint">选定需要在下方快照表格中配置变化序列的数值；每组数值均可独立设置数据位宽范围。</sys:String>
	<sys:String x:Key="str.Spc.Group.SlotsHeader">数值条件列表（每组独立位宽范围）：</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Class">所属类</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Object">对象实例</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Matched">匹配字段序列</sys:String>
	<sys:String x:Key="str.Spc.Group.Detail.Pattern">变化规律</sys:String>


	<!-- N1: per-game class denylist (noise picker) — shared by SPC + Diff -->
	<sys:String x:Key="str.Noise.PanelHeader">冗余类筛选面板 — 当前结果高频类排行</sys:String>
	<sys:String x:Key="str.Noise.PanelHint">勾选你判定为无效冗余的类型（UI控件、动画组件、帧状态类等）。点击应用后会将这些类加入当前游戏黑名单，并重新执行检索。黑名单会同步作用于快照对比、类数据透视功能。</sys:String>
	<sys:String x:Key="str.Noise.Col.Pick">隐藏</sys:String>
	<sys:String x:Key="str.Noise.Col.Class">类名称</sys:String>
	<sys:String x:Key="str.Noise.Col.Hits">匹配数量</sys:String>
	<sys:String x:Key="str.Noise.Col.SampleProps">示例字段</sys:String>
	<sys:String x:Key="str.Noise.Apply">应用并重新检索</sys:String>
	<sys:String x:Key="str.Noise.ActiveHeader">当前游戏生效黑名单：</sys:String>
	<sys:String x:Key="str.Noise.Clear">清空全部黑名单</sys:String>
	<sys:String x:Key="str.Noise.Reset">取消全部勾选</sys:String>
	<sys:String x:Key="str.Noise.RemoveTip">从黑名单中移除</sys:String>


	<!-- Client-side class-noise filter (Instance / Interesting Funcs+Props / Property Search) -->
	<sys:String x:Key="str.ClassFilter.Button">类筛选</sys:String>
	<sys:String x:Key="str.Tip.ClassFilter">将检索结果按类分组，并在列表中屏蔽UI控件、音效、系统组件这类冗余无用类。仅做界面隐藏，不会删除原始数据；取消勾选或清空即可恢复显示。</sys:String>
	<sys:String x:Key="str.ClassFilter.Hint">勾选对应类，下方结果列表就会隐藏该类条目（如UI界面、音效资源、系统内置组件）。该操作仅影响视图展示，底层数据不会变动；取消勾选或清空筛选就能重新显示。</sys:String>
	<sys:String x:Key="str.ClassFilter.Partial">⚠ 统计数值为不完全统计：结果存在条数上限，此处数字仅为最低预估量。</sys:String>
	<sys:String x:Key="str.ClassFilter.Clear">清空筛选（显示全部）</sys:String>
	<sys:String x:Key="str.ClassFilter.AutoDetect">自动识别冗余类</sys:String>
	<sys:String x:Key="str.Tip.ClassFilter.AutoDetect">自动预勾选判定为引擎系统冗余的类型：UI控件、音效、贴图、材质、粒子特效、动画实例以及引擎内置包下所有类。不会误勾选游戏玩法实体类，可手动取消勾选需要保留的类型。</sys:String>

	<!-- Class Pivot: right-click hide + hidden-class chips -->
	<sys:String x:Key="str.Pivot.HideClass">将选中类从透视列表中隐藏</sys:String>
	<sys:String x:Key="str.Pivot.HiddenHeader">已隐藏类（仅作用于数据透视模块）：</sys:String>

	<!-- Class Pivot (experimental) -->
	<sys:String x:Key="str.Pivot.Intro">
		将同一个类的所有实例，依据关键字段数值（例如背包按物品ID分组）或者对象本体进行归类聚合，并展示每组内各项字段数值。系统会自动推荐最优关键字段（结合类型、字段名、数据基数判定）。同一分组内数值不一致时会以冲突形式展示：⟨数量: 值1,值2,+更多⟩。快照仅采集数字数据，因此分组键仅限整型/枚举ID。
		小贴士：临时生成的背包道具对象内存路径完全一致（//Engine/Transient/Item），请选用ItemID这类字段作为分组键；若选用对象本体模式会全部合并为一组。
		数据源切换为快照数组，可对结构体数组（如货舱列表）依照内部ID透视分组，不受数组顺序、游戏会话重启影响；也可选用数据表模式，一键透视运行中DataTable数据表，以行名作为分组键无需额外配置。
	</sys:String>
	<sys:String x:Key="str.Pivot.SourceHeader">⚙ 透视数据源设置 — 来源 · 快照 · 目标类</sys:String>
	<sys:String x:Key="str.Pivot.Source">数据源：</sys:String>
	<sys:String x:Key="str.Pivot.Snapshot">快照：</sys:String>
	<sys:String x:Key="str.Pivot.DataTable">数据表：</sys:String>
	<sys:String x:Key="str.Pivot.ArrayField">数组字段：</sys:String>
	<sys:String x:Key="str.Pivot.RefreshDataTables">🔄 扫描加载数据表</sys:String>
	<sys:String x:Key="str.Pivot.KeyRowName">分组键 = 数据表行名（无需配置）</sys:String>
	<sys:String x:Key="str.Pivot.KeyInnerKey">分组键 = 数组内部键值（不受排序变动影响）</sys:String>
	<sys:String x:Key="str.Pivot.ThisProperty">对该字段执行透视统计…</sys:String>
	<sys:String x:Key="str.Pivot.ClassFilter">筛选类：</sys:String>
	<sys:String x:Key="str.Pivot.ClassFilterHint">输入字符检索，之后选中目标类…</sys:String>
	<sys:String x:Key="str.Pivot.Run">执行数据透视</sys:String>
	<sys:String x:Key="str.Pivot.OpenWalker">在实时内存浏览器打开</sys:String>
	<sys:String x:Key="str.Pivot.CopyAddr">复制内存地址</sys:String>
	<sys:String x:Key="str.Pivot.LocateGWorld">🌍</sys:String>
	<sys:String x:Key="str.Tip.Pivot.LocateGWorld">GWorld定位：解析从GWorld到选中分组代表对象的最短指针路径，并在实时浏览器打开</sys:String>
	<sys:String x:Key="str.Pivot.LocateGameEngine">⚙</sys:String>
	<sys:String x:Key="str.Tip.Pivot.LocateGameEngine">GameEngine定位：从运行态UGameEngine检索至分组代表对象的最短指针链路；可访问GWorld无法覆盖的引擎层级对象，绝大多数场景实体优先使用GWorld定位</sys:String>
	<sys:String x:Key="str.Pivot.ResultFilterHint">筛选结果内容…</sys:String>
	<sys:String x:Key="str.Pivot.GroupBy">分组依据：</sys:String>
	<sys:String x:Key="str.Pivot.KeyField">关键字段：</sys:String>
	<sys:String x:Key="str.Pivot.Col.Key">复合分组键</sys:String>
	<sys:String x:Key="str.Pivot.Col.KeyTip">将此字段加入分组键（仅限字段分组模式）。最终键变为主关键字段+所有勾选字段的组合，例如（阵营 · 背包槽位）进行联合分组；仅单个字段即为普通单键分组。</sys:String>
	<sys:String x:Key="str.Pivot.Col.Project">展示数值</sys:String>
	<sys:String x:Key="str.Pivot.Col.Field">字段名称</sys:String>
	<sys:String x:Key="str.Pivot.Col.Type">数据类型</sys:String>
	<sys:String x:Key="str.Pivot.Col.Distinct">唯一值数量</sys:String>
	<sys:String x:Key="str.Pivot.Col.Insts">实例总数</sys:String>
	<sys:String x:Key="str.Pivot.Col.KeyScore">键适配评分</sys:String>
	<sys:String x:Key="str.Pivot.ResultsHint">勾选上方数值字段即可聚合展示；勾选复合键可搭建多条件分组（如阵营+槽位），仅字段模式可用。对象本体分组模式会将同蓝图生成的多个实例归为一组（BP_Enemy_C_0/_1等）。选中分组后，打开浏览器、复制地址会将该组代表实例内存地址发送至CE。</sys:String>
	<sys:String x:Key="str.Pivot.Res.Count">实例数量</sys:String>
	<sys:String x:Key="str.Pivot.Res.Key">分组键</sys:String>
	<sys:String x:Key="str.Pivot.Res.Values">聚合字段数值</sys:String>

	<!-- Class Pivot: change-driven discovery (the automatic front-door) -->
	<sys:String x:Key="str.Pivot.Discover.Header">🔍 智能推荐目标 — 定位发生变动的数值</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Intro">不清楚需要透视哪个类？在执行游戏操作前后捕获2~4份快照（例如消耗金币、受到伤害），勾选下方快照后点击检索，系统会按照变动可信度对（类、属性）进行排序；评判依据包含字段命名规范性、数值变化特征、冗余干扰程度，筛选出最贴合游戏状态的目标项。选中条目后点击使用，即可直接跳转数据透视页面，无需手动猜测类与关键字段。</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Pick">快照选择（勾选2~4份，从旧到新 = 操作前 … 操作后）：</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Run">🔍 开始智能检索</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Use">选用 → 以此进行透视分析</sys:String>

	<!-- Usage limits, shown on the tab so expectations are clear up front. -->
	<sys:String x:Key="str.Pivot.Discover.Limits">
		运行原理与约束：
		• 在目标操作节点前后捕获2~4份快照；
		• 推荐使用3~4份快照，可区分一次性数值变动和每帧持续刷新的干扰数据（旋转、计时器、坐标等）；仅2份快照会把所有变动统一判定为有效更改；
		• 仅展示数值发生变化的字段，全程无变动的字段不会出现在列表中；
		• 跨游戏重启场景：仅有身份稳定持久的对象可稳定匹配（游戏实例、玩家状态、角色实体、组件、GAS属性集等）；随机生成的场景实体大概率无法正常关联；
		• 检索范围为快照内所有数字字段，运算交由服务端执行；超大快照耗时可达数秒，支持中途取消。
	</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Class">所属类</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Prop">属性字段</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Changed">变动次数</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Dir">变化趋势</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Cat">数据分类</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Shape">变化形态</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Seq">数值序列（最早→最新）</sys:String>
	<sys:String x:Key="str.Pivot.Discover.Col.Score">可信度评分</sys:String>

	<!-- Proxy Deploy -->
	<sys:String x:Key="str.ProxyDeploy.ProxyType">代理DLL文件：</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Type.Version">version.dll</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Type.Dinput8">dinput8.dll</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Type.Dxgi">dxgi.dll</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Type.Winmm">winmm.dll</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Scan">扫描Steam游戏</sys:String>
	<sys:String x:Key="str.ProxyDeploy.RouteOrder">
		DLL载入游戏的四种方案（推荐优先级从高至低）：
		① 部署下方代理DLL：随游戏进程一同加载，重启游戏依旧生效，无需依赖Cheat Engine；
		② 注入正在运行的游戏进程（上方按钮）：无需安装文件，但每次开游戏都要重新注入；
		③ Cheat Engine常驻方案：工具→安装CE自启动助手，可给所有脚本表永久添加ue5_inject()注入函数；工具→添加DLL注入记录，可给当前打开的脚本表插入单次注入条目；
		④ dist\UE5CEDumper.CT：独立脚本表，供开发者备用兜底方案。
	</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Inject">注入至正在运行的游戏进程…</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Refresh">刷新列表</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Deploy">部署代理文件</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Undeploy">卸载代理文件</sys:String>
	<sys:String x:Key="str.ProxyDeploy.UpdateAll">批量更新全部</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Force">强制覆盖写入</sys:String>
	<sys:String x:Key="str.ProxyDeploy.SelectAll">全选</sys:String>
	<sys:String x:Key="str.ProxyDeploy.UnselectAll">取消全选</sys:String>
	<sys:String x:Key="str.ProxyDeploy.InvertSel">反选</sys:String>
	<sys:String x:Key="str.ProxyDeploy.SourceDll">源DLL路径：</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColName">游戏名称</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColPath">二进制程序目录</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColStatus">部署状态</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColSuggested">推荐代理文件名</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColVersion">文件版本</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ColError">错误信息</sys:String>
	<sys:String x:Key="str.ProxyDeploy.SuggestToggle">自动推荐适配代理DLL</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Source">扫描来源：</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Source.Steam">Steam平台</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Source.Drives">全盘扫描</sys:String>
	<sys:String x:Key="str.ProxyDeploy.DriveHint">勾选需要扫描的磁盘分区：</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ScanDrives">开始全盘扫描</sys:String>
	<sys:String x:Key="str.ProxyDeploy.RefreshDrives">刷新磁盘列表</sys:String>
	<sys:String x:Key="str.ProxyDeploy.CancelScan">取消扫描</sys:String>


	<!-- Leftover ("orphan") proxy cleanup. Uninstalling a game leaves its folder behind BECAUSE our-->
	<sys:String x:Key="str.ProxyDeploy.Orphans.Header">残留代理DLL清理</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.Intro">游戏卸载后，若目录内仍存在我们部署的代理DLL，Steam不会删除这份不属于自身管理的文件，从而产生残留文件夹。该功能用于检索这类遗留文件；勾选条目并确认前不会执行任何删除操作。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.Scan">检索残留文件</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ScanTip">遍历所有Steam库目录，查找仅存放代理DLL的空文件夹，同时检索程序日志记录过代理部署的全部路径；仅生成扫描报告，不会自动删除任何文件。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.Report">生成预览报告…</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ReportTip">生成一份试运行文本清单，标注将要删除与保留的全部路径并自动打开，不会对硬盘文件产生任何改动。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.Delete">删除已勾选项（共{0}个）</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.DeleteTip">将勾选的DLL移入回收站，同时清空删除文件后变为空白的文件夹；执行前会完整展示所有文件路径供核对。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.OpenFolder">打开所在文件夹</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.NoneFound">未检索到任何残留代理DLL文件。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.FileOnlyNote">本条仅删除DLL文件，不会处理对应文件夹（下方注释可查看具体缘由）。</sys:String>


	<!-- Confirmation window -->
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmTitle">确认清理残留代理DLL文件？</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmLead">下方列出的DLL文件将会移入回收站，后续可前往回收站撤销恢复。程序会逐层向上尝试删除文件夹，但**仅当文件夹彻底清空时才会被移除**；只要文件夹内还存有任意文件，该文件夹及其上级目录都会完整保留，不会被删除。</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmFilesHeader">即将移入回收站的文件列表</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmDirsHeader">待清理目录顺序：仅目录完全空置才会被删除</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmWhyHeader">判定为残留文件的依据</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmKeptNote">将保留不作处理：{0}</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmYes">移入回收站</sys:String>
	<sys:String x:Key="str.ProxyDeploy.Orphans.ConfirmNo">取消</sys:String>


	<!-- Export -->
	<sys:String x:Key="str.Toolbar.Options">⚙ 设置选项</sys:String>
	<sys:String x:Key="str.Toolbar.Export">导出</sys:String>
	<sys:String x:Key="str.Export.SymbolsX64dbg">符号文件（x64dbg 格式 .dd64）</sys:String>
	<sys:String x:Key="str.Export.SymbolsGhidra">符号文件（Ghidra 文本格式 .txt）</sys:String>
	<sys:String x:Key="str.Export.SymbolsIda">符号脚本（IDA 格式 .idc）</sys:String>
	<sys:String x:Key="str.Export.SdkHeader">SDK 头文件（.h）</sys:String>
	<sys:String x:Key="str.Export.Usmap">UE 映射文件（.usmap）</sys:String>
	<sys:String x:Key="str.Export.DumpAll">导出全部元数据（.jsonl）</sys:String>
	<sys:String x:Key="str.Tip.Export.DumpAll">将所有类、属性、函数（含蓝图生成GC结构）流式导出为JSON Lines文件。可供Python分析脚本analyze_dumps.py解析真实游戏数据，生成关键词库、属性加成表、数值阈值校准数据。单次导出耗时约30~60秒；文件体积随游戏规模浮动，范围50~500MB。</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportHeader">导出头文件(.h)</sys:String>


	<!-- Tools (always-available menu; doesn't depend on a DLL connection) -->
	<sys:String x:Key="str.Toolbar.Tools">工具</sys:String>
	<sys:String x:Key="str.Tools.InjectCeBootstrap">向当前CE脚本表添加「DLL注入」记录</sys:String>
	<sys:String x:Key="str.Tools.InstallCeAutorun">安装CE自启动助手（所有脚本表永久生效）…</sys:String>
	<sys:String x:Key="str.Tools.InjectCeHelperLua">向当前CE脚本表注入辅助运行脚本</sys:String>
	<sys:String x:Key="str.Tools.ExportCeHelperLua">导出CE辅助Lua脚本文件…</sys:String>
