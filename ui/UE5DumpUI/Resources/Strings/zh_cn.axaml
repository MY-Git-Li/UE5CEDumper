	<!-- Interesting Functions Finder -->
	<sys:String x:Key="str.IF.Load">加载全部函数</sys:String>
	<sys:String x:Key="str.IF.GameOnly">仅游戏自定义函数</sys:String>
	<sys:String x:Key="str.IF.FilterHint">名称筛选（函数名/类名）…</sys:String>
	<sys:String x:Key="str.IF.ShowAll">显示全部（含低分函数）</sys:String>
	<sys:String x:Key="str.IF.GameplayActions">游戏交互动作库</sys:String>
	<sys:String x:Key="str.IF.CallableOnly">仅蓝图可调用/执行入口函数</sys:String>
	<sys:String x:Key="str.IF.ClearFilters">重置筛选</sys:String>
	<sys:String x:Key="str.IF.OpenInst">实例</sys:String>
	<sys:String x:Key="str.IF.Props">读写字段</sys:String>
	<sys:String x:Key="str.IF.OpenLive">实时内存浏览</sys:String>
	<sys:String x:Key="str.IF.LocateGWorld">🌍 GWorld定位</sys:String>
	<sys:String x:Key="str.IF.LocateGameEngine">⚙ GameEngine定位</sys:String>
	<sys:String x:Key="str.IF.CopyAaScript">生成AA汇编脚本(B)</sys:String>
	<sys:String x:Key="str.IF.CopyName">复制函数名</sys:String>
	<sys:String x:Key="str.Tip.IF.Load">扫描所有UClass下的UFunction函数。大型游戏（百万对象以上）耗时2~10秒。分数由客户端依据关键词、所属类权重、函数标识综合计算得出</sys:String>
	<sys:String x:Key="str.Tip.IF.GameOnly">排除引擎底层模块：/Script/Engine、/Script/CoreUObject等；正式版游戏结果数量通常缩减5倍。重新勾选并加载即可刷新</sys:String>
	<sys:String x:Key="str.Tip.IF.Filter">模糊匹配函数名或所属类名，大小写不敏感；例：Money、PlayerCharacter</sys:String>
	<sys:String x:Key="str.Tip.IF.ClearFilters">清空名称检索、分类筛选、全部显示开关，恢复默认状态</sys:String>
	<sys:String x:Key="str.Tip.IF.OpenInst">跳转实例查找面板，自动填入当前类名并检索运行实例列表</sys:String>
	<sys:String x:Key="str.Tip.IF.Category">分类筛选；依照函数最高权重关键词划分优先级：属性数值 > 背包物品 > 移动操控 > 战斗逻辑 > 通用工具（同分并列）</sys:String>
	<sys:String x:Key="str.Tip.IF.ShowAll">关闭时隐藏分值低于阈值（默认5分）的条目；开启后展示所有UFunction函数</sys:String>
	<sys:String x:Key="str.Tip.IF.GameplayActions">可选附加词库（默认关闭）：为角色操控、场景交互、商店交易类词汇追加权重：闪避、翻滚、滑铲、攀爬、交互、开启、购买、售卖、商人、交易等。可让OpenShop、Dash、Interact这类函数达标显示；常搭配shop/buy关键词检索。结果冗余会小幅提升，关闭即可恢复偏向修改数值的检索模式</sys:String>
	<sys:String x:Key="str.Tip.IF.CallableOnly">筛选开关（默认关闭）：仅展示标记BlueprintCallable/Exec的函数。游戏操控、商店入口基本均为此类型，打包后标识不会丢失；可过滤原生存取器、引擎底层冗余代码。搭配「游戏交互动作库」+「显示全部」适合浏览交互入口；仅界面筛选，不改动分值</sys:String>
	<sys:String x:Key="str.Tip.IF.Props">解析蓝图字节码，列出该函数读取、修改的属性；原生C++函数无字节码，不会显示内容</sys:String>
	<sys:String x:Key="str.Tip.IF.OpenLive">在实时内存浏览器打开该函数；若无运行实例则跳转类结构体面板，自动展开函数列表并选中目标</sys:String>
	<sys:String x:Key="str.Tip.IF.LocateGWorld">GWorld路径查找：获取该类运行实例，解析从全局GWorld到实例的最短指针链路并展示</sys:String>
	<sys:String x:Key="str.Tip.IF.LocateGameEngine">GameEngine路径查找：从全局UGameEngine解析指针链路，可访问GWorld无法覆盖的引擎层对象；绝大多数场景实体优先选用GWorld定位</sys:String>
	<sys:String x:Key="str.Tip.IF.CopyAaScript">弹出烘焙AA汇编脚本窗口；需要CE脚本内置ue5_invoke_helper.lua（工具→导出CE辅助Lua脚本）</sys:String>
	<sys:String x:Key="str.Tip.IF.CopyName">复制函数名称至剪贴板，方便粘贴到CE脚本或其他逆向工具</sys:String>
	<sys:String x:Key="str.IF.GenerateCT">📦 批量生成CE脚本(.CT)</sys:String>
	<sys:String x:Key="str.Tip.IF.GenerateCT">将选中条目批量导出为单个CT文件，内置函数调用入口。按住Ctrl/Shift多选条目；带参数函数默认参数置零，激活前可自行修改参数列表</sys:String>
	<sys:String x:Key="str.IF.BatchProps">⤋ 批量读取读写字段</sys:String>
	<sys:String x:Key="str.Tip.IF.BatchProps">批量填充选中条目「读写字段」列（未选中则全部条目），无需逐个点开弹窗查看；仅解析单函数字节码速度较快。原生函数大多无结果</sys:String>
	<sys:String x:Key="str.IF.UsesCol">读写字段</sys:String>
	<sys:String x:Key="str.Common.CancelBatch">✕ 取消批量任务</sys:String>
	<sys:String x:Key="str.Common.BatchFuncs">⤋ 批量引用函数检索</sys:String>
	<sys:String x:Key="str.Common.BatchFindFunc">⤋ 批量检索调用函数</sys:String>
	<sys:String x:Key="str.Tip.Common.BatchFindFunc">填充选中条目「调用函数」列：检索所有入参/返回值包含此类的UFunction（含原生函数）。全局扫描耗时较长，建议先筛选范围或多选条目；已扫描条目会缓存跳过</sys:String>
	<sys:String x:Key="str.Common.FuncsCol">关联函数</sys:String>
	<sys:String x:Key="str.Tip.Common.BatchFuncs">批量填充属性对应的引用函数：扫描蓝图字节码查找调用该字段的所有函数。全局扫描开销更高，建议框选条目缩小范围；纯原生访问的字段通常无结果</sys:String>
	
	<!-- Live Funcs (Live ProcessEvent Call Profiler) -->
	<sys:String x:Key="str.LF.Start">● 开始录制</sys:String>
	<sys:String x:Key="str.LF.Stop">■ 停止录制</sys:String>
	<sys:String x:Key="str.LF.Refresh">刷新统计</sys:String>
	<sys:String x:Key="str.LF.Clear">清空记录</sys:String>
	<sys:String x:Key="str.LF.FilterHint">名称筛选（函数名/所属类）…</sys:String>
	<sys:String x:Key="str.LF.OpenLive">实时浏览</sys:String>
	<sys:String x:Key="str.LF.CopyName">复制函数名</sys:String>
	<sys:String x:Key="str.LF.SetBaseline">⚑ 设定基准快照</sys:String>
	<sys:String x:Key="str.LF.Diff">对比基准差值</sys:String>
	<sys:String x:Key="str.LF.NewOnly">仅新增/变动调用</sys:String>
	<sys:String x:Key="str.LF.ClearBaseline">清除基准快照</sys:String>
	<sys:String x:Key="str.LF.HideWidgets">隐藏UI控件类函数</sys:String>
	<sys:String x:Key="str.LF.HideEvents">隐藏事件/委托回调</sys:String>
	<sys:String x:Key="str.LF.PeriodicOnly">仅定时周期函数</sys:String>
	<sys:String x:Key="str.LF.EarliestFirst">按调用先后排序</sys:String>

	<sys:String x:Key="str.Tip.LF.Start">开始捕获游戏经由ProcessEvent分发执行的所有UFunction调用；会自动挂载游戏主线程ProcessEvent钩子。操作流程：点击开始 → 切回游戏执行单一动作（开商店、冲刺、攻击）→ 点击停止。依靠行为差异定位目标函数，即便函数名称完全无法猜测也能精准找到。</sys:String>
	<sys:String x:Key="str.Tip.LF.Stop">终止录制，展示所有被触发的函数，并按照调用次数排序。动作专属入口函数通常调用次数很少、排名靠前；每帧循环Tick/更新类函数调用量极大，会排在末尾。</sys:String>
	<sys:String x:Key="str.Tip.LF.Refresh">无需停止录制即可实时拉取当前调用计数；录制中实时查看，或是停止后重新刷新数据。</sys:String>
	<sys:String x:Key="str.Tip.LF.Filter">函数名/类名字符串模糊匹配，空格代表多关键词同时匹配，大小写不敏感；示例输入：shop、open。</sys:String>
	<sys:String x:Key="str.Tip.LF.OpenLive">在实时内存浏览器打开该函数所属类的运行实例；若无活跃实例则跳转类结构体页面，可直接调用测试函数。</sys:String>
	<sys:String x:Key="str.Tip.LF.CopyName">将函数名称复制到剪贴板，方便写入CE脚本或逆向工具。</sys:String>
	<sys:String x:Key="str.Tip.LF.SetBaseline">将当前闲置状态的调用统计保存为基准参照。标准用法：开始录制 → 原地静置数秒 → 停止 → 设定基准；之后再录制执行游戏动作，列表会计算差值，闲置期间未触发的函数置顶，彻底规避Tick帧更新噪音干扰。</sys:String>
	<sys:String x:Key="str.Tip.LF.Diff">开启差值Δ列，优先排序新增、调用次数上涨的函数（需提前保存基准快照）；关闭则恢复原始调用次数排序。</sys:String>
	<sys:String x:Key="str.Tip.LF.NewOnly">只展示相较基准新增、调用频次提升的函数列表，也就是本次动作专属调用集合，商店开启、冲刺这类函数基本都会出现在这里。</sys:String>
	<sys:String x:Key="str.Tip.LF.HideWidgets">隐藏继承自UUserWidget的UI界面类函数。打开商店/菜单时会批量创建UI控件，大量UI回调会淹没真实入口；UI界面是动作最终呈现结果，并非触发入口。屏蔽后只会保留玩家控制器、UI管理器、交互组件这类可全局调用的开启函数。</sys:String>
	<sys:String x:Key="str.Tip.LF.HideEvents">
		隐藏事件、委托回调函数（类型栏标注Event/Deleg）。这类是引擎事件触发的被动回调，无法主动调用去触发对应行为；关闭后仅保留可主动调用的指令型函数。
		注意：勾选后列表为空代表目标入口未被捕获：入口经由原生C++调用绕过ProcessEvent钩子无法抓取，或是界面尚未完全加载完毕，需完整录制直至面板彻底弹出。
	</sys:String>
	<sys:String x:Key="str.Tip.LF.PeriodicOnly">
		仅展示稳定周期运行的计时器函数（类型标注Timer），周期波动极小，区别于逐帧Tick循环。用于查找冷却、重生、持续掉血这类定时回调：原地闲置录制15~20秒（和动作溯源相反流程），开启此项过滤后仅剩定时任务，周期列会显示实测间隔。
		局限：原生C++ Lambda定时器完全绕过ProcessEvent无法捕获；仅蓝图定时器、SetTimerByFunctionName绑定的UFUNCTION定时器可见。
	</sys:String>
	<sys:String x:Key="str.Tip.LF.EarliestFirst">按照调用时序先后排序，录制期间最先触发的函数排在顶端（查看Order调用序号）。动作入口永远早于后续UI创建、事件回调；搭配「仅新增变动」使用，可抛开函数名称、调用次数干扰，依靠因果顺序锁定真正触发源头。</sys:String>
	
	<!-- Console (UFUNCTION(exec) discovery + invoke) -->
	<sys:String x:Key="str.Con.Load">加载指令列表</sys:String>
	<sys:String x:Key="str.Con.GameOnly">仅游戏自定义指令</sys:String>
	<sys:String x:Key="str.Con.FilterHint">指令名称筛选…</sys:String>
	<sys:String x:Key="str.Con.ClearFilter">清空筛选</sys:String>
	<sys:String x:Key="str.Con.CommandHint">输入指令（例：fly、ghost、god）</sys:String>
	<sys:String x:Key="str.Con.Run">执行</sys:String>
	<sys:String x:Key="str.Con.RunSelected">执行选中项</sys:String>
	<sys:String x:Key="str.Con.RunRow">运行</sys:String>
	<sys:String x:Key="str.Con.OpenLive">实时浏览</sys:String>
	<sys:String x:Key="str.Con.CopyAaScript">生成AA汇编脚本(B)</sys:String>
	<sys:String x:Key="str.Con.HistoryHeader">最近执行记录</sys:String>

	<sys:String x:Key="str.Tip.Con.Load">遍历全部UFunction，提取标记UFUNCTION(exec)的控制台调试指令。多数正式版打包游戏依旧保留这类接口，属于官方原生调试作弊指令集合。</sys:String>
	<sys:String x:Key="str.Tip.Con.GameOnly">默认关闭：会包含引擎底层UCheatManager全局指令（最常用）；开启后只显示游戏项目专属自定义指令。</sys:String>
	<sys:String x:Key="str.Tip.Con.ClearFilter">清空名称检索条件，恢复完整指令列表。</sys:String>
	<sys:String x:Key="str.Tip.Con.Filter">指令名/所属类模糊匹配，大小写不敏感；空白则展示全部指令。</sys:String>
	<sys:String x:Key="str.Tip.Con.CommandInput">输入指令后点击执行；无参数指令直接运行，带参数指令会弹出参数填写窗口；开头斜杠会自动剔除（/fly 等同于 fly）。</sys:String>
	<sys:String x:Key="str.Tip.Con.RunCommand">匹配已加载列表执行指令，大小写不敏感精准匹配函数名；多个类同名指令时，优先命中最先检索到的条目。</sys:String>
	<sys:String x:Key="str.Tip.Con.RunSelected">执行当前选中的控制台指令，和条目点击运行共用一套调用逻辑。</sys:String>
	<sys:String x:Key="str.Tip.Con.RunRow">调用本条exec指令；无参数经由管道直接执行，带参数唤起参数配置弹窗。</sys:String>
	<sys:String x:Key="str.Tip.Con.OpenLive">尝试在实时浏览器打开指令所属类；仅存在CDO默认对象无运行实例时回落至类结构体页面（UCheatManager子类通常要玩家控制器生成后才有实例）。</sys:String>
	<sys:String x:Key="str.Tip.Con.CopyAaScript">为本条控制台指令生成烘焙Auto Assembler脚本，适合打包分享CE修改表。</sys:String>
	<sys:String x:Key="str.Tip.Con.Replay">重复执行该指令；程序重启缓存清空后无法回放。</sys:String>
	
	<!-- Console: Debug Camera state-aware helper (visible only when the
         loaded exec list contains ToggleDebugCamera). ToggleDebugCamera is
         a stateful toggle; these controls read the CheatManager's
         DebugCameraControllerRef to show ON/OFF and drive deterministic
         Force On / Force Off instead of blind toggling. -->
	<sys:String x:Key="str.Con.DbgCam.Label">调试相机</sys:String>
	<sys:String x:Key="str.Con.DbgCam.ForceOn">强制开启</sys:String>
	<sys:String x:Key="str.Con.DbgCam.ForceOff">强制关闭</sys:String>
	<sys:String x:Key="str.Con.DbgCam.Refresh">↻ 刷新</sys:String>
	<sys:String x:Key="str.Con.DbgCam.CopyCe">复制CE脚本</sys:String>
	<sys:String x:Key="str.Tip.Con.DbgCam.State">
		实时读取CheatManager的DebugCameraControllerRef字段判定调试相机状态，ToggleDebugCamera指令正是依据此字段进行分支判断。
		开启：存在激活的调试相机控制器，再次点击原生切换指令会关闭；点击刷新可重新读取状态
	</sys:String>
	<sys:String x:Key="str.Tip.Con.DbgCam.Refresh">重新从CheatManager运行实例读取调试相机当前状态</sys:String>
	<sys:String x:Key="str.Tip.Con.DbgCam.ForceOn">稳定开启调试相机：先读取当前状态，仅在关闭状态时调用ToggleDebugCamera；幂等操作，已开启时无任何动作</sys:String>
	<sys:String x:Key="str.Tip.Con.DbgCam.ForceOff">稳定关闭调试相机：先读取当前状态，仅在开启状态时执行关闭；区别于原生盲切换指令，可稳妥关闭相机</sys:String>
	<sys:String x:Key="str.Tip.Con.DbgCam.CopyCe">
		生成带状态判定的CE汇编脚本（勾选开启相机、取消勾选关闭），底层逻辑与面板强制开关完全一致；
		脚本独立封装，直接和注入的UE5Dumper.dll消息队列通信，无需嵌入ue5_invoke_helper.lua；
		已接入AOBMaker则直接推送至CE，未连接则复制文本至剪贴板
	</sys:String>
	
	<!-- Teleport panel (BugIt-style: marker save/recall + cursor teleport) -->
	<sys:String x:Key="str.TP.PoseHeader">当前姿态坐标</sys:String>
	<sys:String x:Key="str.TP.Refresh">刷新</sys:String>
	<sys:String x:Key="str.TP.Auto">自动刷新（0.5秒间隔）</sys:String>
