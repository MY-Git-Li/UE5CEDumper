<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Toolbar -->
	<sys:String x:Key="str.Connect">连接</sys:String>
	<sys:String x:Key="str.Disconnect">断开连接</sys:String>
	<sys:String x:Key="str.Toolbar.AddressFormat">地址格式：</sys:String>
	<sys:String x:Key="str.Toolbar.CollapsePointers">折叠指针节点</sys:String>
	<sys:String x:Key="str.Toolbar.ArrayLimit">数组上限：</sys:String>
	<sys:String x:Key="str.Toolbar.ArrayLimitWarn">⚠ 内存占用过高 — 可能导致程序崩溃</sys:String>
	<sys:String x:Key="str.Toolbar.DropDownLimit">下拉框上限：</sys:String>
	<sys:String x:Key="str.Toolbar.StringLength">字符串长度：</sys:String>
	<sys:String x:Key="str.Toolbar.Fabricate">自动填充：</sys:String>
	<sys:String x:Key="str.Toolbar.PreviewLimit">预览条数：</sys:String>
	<sys:String x:Key="str.Toolbar.CsxDepth">解析深度：</sys:String>

    <!-- Banners -->
	<sys:String x:Key="str.Banner.GameThreadPaused">⏸ 游戏线程已暂停 — 游戏未执行帧循环（暂停菜单/切窗口/断点）。实时相机与函数调用功能会超时；内存扫描仍可正常运行。切回游戏窗口解除暂停即可恢复完整功能。</sys:String>

    <!-- Tabs -->
	<sys:String x:Key="str.Tab.ClassStruct">类结构</sys:String>
	<sys:String x:Key="str.Tab.Pointers">系统指针</sys:String>
	<sys:String x:Key="str.Tab.ProxyDeploy">代理部署</sys:String>
	<sys:String x:Key="str.Tab.LiveWalker">实时结构查看器</sys:String>
	<sys:String x:Key="str.Tab.InstanceFinder">实例查找</sys:String>
	<sys:String x:Key="str.Tab.PropertySearch">属性搜索</sys:String>
	<sys:String x:Key="str.Tab.InterestingFunctions">关键函数</sys:String>
	<sys:String x:Key="str.Tab.InterestingProperties">关键属性</sys:String>
	<sys:String x:Key="str.Tab.ValueSearch">数值搜索</sys:String>
	<sys:String x:Key="str.Tab.Console">控制台</sys:String>
	<sys:String x:Key="str.Tab.Teleport">传送</sys:String>
	<sys:String x:Key="str.Tab.GameClassFilter">游戏类筛选</sys:String>
	<sys:String x:Key="str.Tab.RelatedObjects">关联对象</sys:String>
	<sys:String x:Key="str.Tab.DumpExplorer">导出文件浏览器</sys:String>
	<sys:String x:Key="str.Tab.LiveFuncs">实时函数</sys:String>
    <!-- Experimental tabs (hidden unless opted in via System-tab credit checkbox) -->
	<sys:String x:Key="str.Tab.DetectStats">玩家数据探测</sys:String>
	<sys:String x:Key="str.Tab.Snapshot">快照</sys:String>
	<sys:String x:Key="str.Tab.SpcQuery">快照序列查询</sys:String>
	<sys:String x:Key="str.Tab.ClassPivot">类数据透视</sys:String>

    <!-- Detect Player Stats panel (experimental, P4) -->
	<sys:String x:Key="str.Detect.Disclaimer">⚠ 仅供参考，准确率较低。所有探测结果均为程序估算值，不能作为准确依据。请在实时结构查看器/数值搜索中核对真实数值与内存地址后再使用。</sys:String>
	<sys:String x:Key="str.Detect.Run">🔎 探测玩家数据</sys:String>
	<sys:String x:Key="str.Detect.UseSnapshot">使用快照对比（先捕获快照 → 游戏内扣血/消耗 → 再次捕获）</sys:String>
	<sys:String x:Key="str.Detect.ColConfirm">探测结果</sys:String>
	<sys:String x:Key="str.Detect.ColCategory">分类</sys:String>
	<sys:String x:Key="str.Detect.ColClass">所属类</sys:String>
	<sys:String x:Key="str.Detect.ColProperty">属性名</sys:String>
	<sys:String x:Key="str.Detect.ColType">类型</sys:String>
	<sys:String x:Key="str.Detect.ColOffset">内存偏移</sys:String>
	<sys:String x:Key="str.Detect.ColSignals">实时/变化标记</sys:String>
	<sys:String x:Key="str.Detect.ColConfidence">可信度</sys:String>
	<sys:String x:Key="str.Detect.ColChange">快照差值 Δ</sys:String>
	<sys:String x:Key="str.Detect.CopyName">复制名称</sys:String>
	<sys:String x:Key="str.Detect.FilterHint">按属性/类名/分类筛选…</sys:String>
    <!-- Detect Stats tooltips -->
	<sys:String x:Key="str.Tip.Detect.Run">自动筛选血量、蓝量、金币(HP/MP/Gold/…)等常见玩家属性，并读取实时数值进行核验，结果仅作参考，使用前务必核对。</sys:String>
	<sys:String x:Key="str.Tip.Detect.UseSnapshot">对比两次快照，优先筛选数值下降的字段。操作流程：捕获快照 → 游戏内消耗资源/受到伤害 → 再次捕获快照后执行探测。至少需要2份可用快照。</sys:String>
	<sys:String x:Key="str.Tip.Detect.Filter">对属性、类名、分类进行模糊检索，大小写不敏感。</sys:String>
	<sys:String x:Key="str.Tip.Detect.GWorld">在GWorld中定位该类的实时实例，打开实时结构查看器，可复制CE字段脚本。</sys:String>
	<sys:String x:Key="str.Tip.Detect.Finder">在实例查找器中查找该类所有实时对象。</sys:String>
	<sys:String x:Key="str.Tip.Detect.Copy">将属性名称复制到剪贴板。</sys:String>

    <!-- Dump Explorer panel — offline browser over a "Dump All" .jsonl file -->
	<sys:String x:Key="str.Dump.Load">📂 加载jsonl导出文件</sys:String>
	<sys:String x:Key="str.Dump.LoadLast">⤓ 上次导出文件</sys:String>
	<sys:String x:Key="str.Dump.Recheck">🔄 重新读取实时数据</sys:String>
	<sys:String x:Key="str.Dump.Cancel">取消</sys:String>
	<sys:String x:Key="str.Dump.SearchHint">关键词检索 — 同时匹配类、属性、函数名称，空格代表且关系</sys:String>
	<sys:String x:Key="str.Dump.MetaNote">ⓘ 列表展示的是类元数据，并非游戏实时实例，不存在GWorld内存路径。跳转打开对应类；实例检索可查找实时对象，再通过关联对象面板定位内存路径。</sys:String>
	<sys:String x:Key="str.Dump.Cat.All">全部</sys:String>
	<sys:String x:Key="str.Dump.Cat.Class">类</sys:String>
	<sys:String x:Key="str.Dump.Cat.Property">属性</sys:String>
	<sys:String x:Key="str.Dump.Cat.Function">函数</sys:String>
	<sys:String x:Key="str.Dump.ColKind">类型分类</sys:String>
	<sys:String x:Key="str.Dump.ColName">名称</sys:String>
	<sys:String x:Key="str.Dump.ColOwner">所属类</sys:String>
	<sys:String x:Key="str.Dump.ColType">类型/签名</sys:String>
	<sys:String x:Key="str.Dump.ColOffset">偏移</sys:String>
	<sys:String x:Key="str.Dump.ColPath">类完整路径</sys:String>
	<sys:String x:Key="str.Dump.Jump">🡒 跳转查看</sys:String>
	<sys:String x:Key="str.Dump.FindInstances">🔍 查找实例</sys:String>
	<sys:String x:Key="str.Dump.CopyPath">复制类路径</sys:String>
    <!-- Dump Explorer tooltips -->
	<sys:String x:Key="str.Tip.Dump.Load">打开“全部导出”生成的jsonl文件，无需连接游戏即可检索所有类、属性、函数。</sys:String>
	<sys:String x:Key="str.Tip.Dump.LoadLast">加载本次会话最近一次导出文件，无需打开文件选择框，未导出过则置灰。</sys:String>
	<sys:String x:Key="str.Tip.Dump.Recheck">读取当前连接游戏的实时类信息，区分“当前游戏存在”与“不存在”两类数据，游戏重启后仍可识别，需要已连接并扫描游戏。</sys:String>
	<sys:String x:Key="str.Tip.Dump.Category">筛选仅展示类/属性/函数，或展示全部。</sys:String>
	<sys:String x:Key="str.Tip.Dump.Jump">在实时查看器打开该类对象。</sys:String>
	<sys:String x:Key="str.Tip.Dump.FindInstances">在实例查找器打开该类实时对象，是跳转关联对象面板定位GWorld内存路径的入口。</sys:String>
	<sys:String x:Key="str.Tip.Dump.CopyPath">将类完整路径复制至剪贴板。</sys:String>

    <!-- Related Objects panel -->
	<sys:String x:Key="str.Related.AddressHint">UObject/角色十六进制地址 — 或从其他面板传入</sys:String>
	<sys:String x:Key="str.Related.Load">加载</sys:String>
	<sys:String x:Key="str.Related.DetectTarget">🎯 自动检测目标角色</sys:String>
	<sys:String x:Key="str.Related.CandidatesHeader">候选目标（匹配度从高到低，点击查看详情）：</sys:String>
	<sys:String x:Key="str.Related.ColRelation">关联关系</sys:String>
	<sys:String x:Key="str.Related.ColObject">对象</sys:String>
	<sys:String x:Key="str.Related.ColField">字段</sys:String>
	<sys:String x:Key="str.Related.ColAddress">地址</sys:String>
	<sys:String x:Key="str.Related.ShowButton">🔗 查看关联对象</sys:String>
	<sys:String x:Key="str.Related.IconButton">🔗</sys:String>
	<sys:String x:Key="str.Tip.Related.Show">打开该对象的关联对象面板，展示组件、控制器与角色绑定、GAS属性集等从属关系。</sys:String>
	<sys:String x:Key="str.Tip.Related.Load">加载当前对象的父类、外层对象、控制器/角色配对、自身所有子组件。</sys:String>
	<sys:String x:Key="str.Tip.Related.DetectTarget">自动读取玩家控制器绑定的当前目标实体，无需手动填写类名。</sys:String>
	<sys:String x:Key="str.Tip.Related.GWorld">在GWorld中查找最短指针路径，在实时查看器展示。</sys:String>
	<sys:String x:Key="str.Tip.Related.GameEngine">从GameEngine根对象查找路径，可访问引擎、游戏实例、本地玩家等GWorld无法遍历的对象，但绝大多数世界实体请使用GWorld定位。</sys:String>
	<sys:String x:Key="str.Tip.Related.Walk">在实时结构查看器逐字段查看该对象。</sys:String>
	<sys:String x:Key="str.Tip.Related.Find">查找该类所有实时实例（实例查找器）。</sys:String>
	<sys:String x:Key="str.Tip.Related.Copy">复制对象地址到剪贴板。</sys:String>

    <!-- Value Search -->
	<sys:String x:Key="str.VS.Banner">原生C++无反射字段无法被检索，仅能扫描UPROPERTY字段。如需完整内存扫描请使用Cheat Engine原生扫描。勾选下方原生C选项可读取原始内存字节。</sys:String>
	<sys:String x:Key="str.VS.NativeBanner">已开启原生C扫描：额外读取对象内无反射原始内存块，初次扫描噪音较多，建议搭配“仅游戏类”“优先新实例”过滤，再使用增量扫描收敛结果。仅支持数字类型。</sys:String>
	<sys:String x:Key="str.VS.DataType">数据类型：</sys:String>
	<sys:String x:Key="str.VS.ScanType">扫描模式：</sys:String>
	<sys:String x:Key="str.VS.Value">数值：</sys:String>
	<sys:String x:Key="str.VS.Value2">至</sys:String>
	<sys:String x:Key="str.VS.Rounding">取整模式：</sys:String>
	<sys:String x:Key="str.Tip.VS.Rounding">浮点数转为整数时的处理规则：四舍五入（默认）、截断、向上取整。浮点原值不受影响，仅对比整数目标值时生效。</sys:String>
    <!-- Rounding-mode label reused by the Snapshot + SPC panels (same picker; the
         per-panel hint TextBlock carries the explanation, so no separate tooltip). -->
	<sys:String x:Key="str.Snapshot.Rounding">取整模式：</sys:String>
	<sys:String x:Key="str.Spc.Rounding">取整模式：</sys:String>
	<sys:String x:Key="str.VS.GameOnly">仅游戏自定义类</sys:String>
	<sys:String x:Key="str.VS.Parallel">多线程并行扫描</sys:String>
	<sys:String x:Key="str.VS.BatchRead">批量读取内存</sys:String>
	<sys:String x:Key="str.VS.Deep">深度遍历嵌套容器</sys:String>
	<sys:String x:Key="str.Tip.VS.Deep">可选功能，默认关闭。会同时扫描结构体数组、结构体Map、多层TArray/TSet深层内部数值，例如SaveSlotList[1].MsTuneData.MsTunes[0].WeaponTuneList[0].Tunes[N]这种深层数据也能检索到。单对象扫描开销更大，浅层检索找不到目标时再开启。分组模式下每个数组元素会单独生成匹配条目，可在同一个对象内匹配多条数值条件。</sys:String>
	<sys:String x:Key="str.VS.NativeC">原生C原始内存</sys:String>
	<sys:String x:Key="str.Tip.VS.NativeC">可选功能，默认关闭。除UPROPERTY反射字段外，额外扫描对象头部到类大小之间无属性覆盖的原始内存区块，按指定宽度解析原始字节，可找到血量、蓝量等无反射原生C变量。仅支持数字类型，字符串/向量/布尔会被忽略。初次原始扫描干扰项极多，任意4字节匹配都会被列出，需要增量扫描不断缩小范围。开启后自动勾选「优先新实例」；同时开启深度遍历的情况下，还能扫描结构体数组内部无UPROPERTY原生字段，代价更高、噪音更大，建议搭配特殊数值多次筛选。</sys:String>
	<sys:String x:Key="str.Tip.VS.NativeC.Group">分组模式专用选项，默认关闭。除反射字段外，将对象原始内存数值纳入分组匹配条件，多个数值只要在同一个对象不同偏移处存在即可匹配成功。仅处理对象顶层数据，不进入深层容器；单个对象最多保留64条原始匹配记录。独特数值筛选效果最好，0、1、100这类通用数值会产生大量干扰，仅支持数字字段。</sys:String>
	<sys:String x:Key="str.VS.AutoSkipNoise">过滤引擎冗余对象</sys:String>
	<sys:String x:Key="str.Tip.VS.AutoSkipNoise">可选前置过滤，默认关闭。扫描源头直接跳过UI控件、贴图、音效、粒子、动画实例等引擎内置类，扫描速度更快、结果列表更干净。和扫描后筛选类功能不同，本功能在检索前拦截数据。角色、组件、玩家控制器等游戏业务类会强制保留，角色坐标、GAS血量不会被过滤。快照面板共用这套过滤逻辑，仅首次全量扫描生效，修改后需重新扫描。</sys:String>
	<sys:String x:Key="str.VS.NewestFirst">优先新生成实例</sys:String>
	<sys:String x:Key="str.Tip.VS.NewestFirst">从最新创建的对象开始遍历，结果达到上限时优先保留新生成实体。适用场景：刚刷新怪物、战斗临时实体，这类对象索引很高，普通从旧到新扫描会被截断。不勾选适合开局创建永久角色（索引低不会被截断）。开启原生C时自动勾选，关闭原生C自动取消；仅反射扫描也可单独启用。</sys:String>
	<sys:String x:Key="str.VS.CrossObject">跨从属组件（分组模式）</sys:String>
	<sys:String x:Key="str.Tip.VS.CrossObject">分组模式可选，默认关闭。会读取角色自有组件、GAS属性集内的数值，实现「角色血量+背包金币」分属不同组件同时匹配的检索效果。仅追踪Outer链归属的子对象，依靠多条件同时匹配筛选，而非类名过滤。匹配条目会显示完整路径，点击可跳转对应子对象。</sys:String>
	<sys:String x:Key="str.VS.MaxResults">最大条数：</sys:String>
	<sys:String x:Key="str.Tip.VS.MaxResults">扫描全局匹配结果上限，统计所有对象、全部数组元素。达到上限扫描直接终止，状态栏会提示截断。提高上限或缩小检索条件查看完整数据。单个数组内所有索引都会遍历，仅长度超千万的异常数组会跳过做安全保护；扫描同时受超时限制（10~60秒，默认15秒）。</sys:String>
	<sys:String x:Key="str.VS.Timeout">扫描超时：</sys:String>
	<sys:String x:Key="str.VS.PerSlot">单对象匹配上限：</sys:String>
	<sys:String x:Key="str.Tip.VS.Group.Matched">仅展示一组匹配示例，单个对象通常有多组匹配关系。优先选取同一结构体下的配对，开启筛选后会优先展示匹配字段。数值后(+35)代表该对象还有35个匹配字段未展示，选中行点击「全部字段」可查看完整列表。</sys:String>
	<sys:String x:Key="str.VS.Group.AllFields">查看全部匹配字段</sys:String>
	<!-- Snapshot Group / SPC Group show the same "(+N)" annotation from their own
         offset lists, but have no live session and so no "All fields" button — this
         tooltip must therefore explain the annotation WITHOUT pointing at a control
         those panels do not have. -->
	<sys:String x:Key="str.Tip.Group.MatchedOffline">
		仅展示一组匹配样例，并非全部匹配关系。
		单个对象通常能满足多条匹配规则，本列每种数值仅展示一条匹配记录，优先选取同一结构体下的字段。
		数值后方"(+35)"代表该对象还有35个字段同样匹配此数值，只是未展示。展开行可查看每种数值的匹配数量；如需列出完整字段名，切换至数值搜索面板执行同组检索，可读取游戏实时对象完整数据。
	</sys:String>

	<sys:String x:Key="str.Tip.VS.Group.AllFields">
		列出当前对象中匹配该数值的所有字段名称，不局限表格展示的单条配对。再次点击折叠列表。
		单行表格仅能展示一组配对，会造成部分匹配字段看似缺失。例如一次「变化+不变」扫描，第一条匹配为生命值，同时存在36条冻结整数匹配项，表格只会显示生命值配对，但两组匹配均真实有效。列表内每条字段都支持实时查看、复制地址、数据透视、GWorld定位等操作。
	</sys:String>

	<sys:String x:Key="str.Tip.VS.PerSlotCap">
		分组扫描专用参数，控制每个对象每种数值最多保留匹配字段数量，区间8-4096，默认256。
		该设置不影响扫描速度。后续增减扫描只会读取此处保留的字段；读取顺序为父类字段优先，数值设置过小会隐藏对象自身字段，仅显示继承字段。
		仅当日志提示截断匹配数据时，再调高此数值。
	</sys:String>

	<sys:String x:Key="str.Tip.VS.Mode">切换单数值扫描 / 多条件分组扫描。单数值类似CE传统扫描；分组模式可同时匹配2-4个不同偏移的数值，精准定位目标角色实体。</sys:String>

	<sys:String x:Key="str.Tip.VS.Timeout">首次/分组扫描最大运行时长，超时自动终止并返回已匹配数据，状态栏会提示截断。范围10-90秒，默认25秒。40万以上海量游戏对象可延长时长；小型游戏缩短提升响应速度。仅首次/分组全扫描生效，增量扫描只读取已有结果，速度极快不受限制。</sys:String>

	<sys:String x:Key="str.VS.FirstScan">首次全量扫描</sys:String>
	<sys:String x:Key="str.VS.NextScan">增量筛选</sys:String>
	<sys:String x:Key="str.VS.NewScan">新建扫描会话</sys:String>
	<sys:String x:Key="str.VS.OpenLive">实时查看</sys:String>
	<sys:String x:Key="str.VS.OpenInst">实例</sys:String>

	<sys:String x:Key="str.Tip.VS.OpenInst">跳转实例查找面板，自动填充当前匹配所属类并执行检索。</sys:String>

	<sys:String x:Key="str.VS.CopyAddr">地址</sys:String>
	<sys:String x:Key="str.VS.PivotThis">📊 数据透视</sys:String>
	<sys:String x:Key="str.VS.LocateGWorld">🌍</sys:String>

	<sys:String x:Key="str.Tip.VS.LocateGWorld">GWorld定位：查找从GWorld到该数值所属对象最短指针路径，并在实时查看器打开。</sys:String>

	<sys:String x:Key="str.VS.LocateGameEngine">⚙</sys:String>

	<sys:String x:Key="str.Tip.VS.LocateGameEngine">GameEngine定位：从引擎根对象查找最短指针路径，可访问GWorld无法遍历的引擎、游戏实例、本地玩家对象；绝大多数世界实体请使用GWorld定位。</sys:String>

	<sys:String x:Key="str.VS.CaseSensitive">区分大小写</sys:String>
	<sys:String x:Key="str.VS.Filter">筛选：</sys:String>
	<sys:String x:Key="str.VS.FilterWatermark">全局筛选（不区分大小写，匹配所有列）…</sys:String>
	<sys:String x:Key="str.VS.Sort">排序：</sys:String>
	<sys:String x:Key="str.VS.SortDesc">降序</sys:String>
	<sys:String x:Key="str.VS.LoadMore">加载更多</sys:String>

	<sys:String x:Key="str.Tip.VS.Sort">筛选与排序逻辑在DLL服务端执行，表格分页展示。点击加载更多获取下一页数据；点击列表表头切换升降序，下拉框同步更新排序规则。</sys:String>

	<sys:String x:Key="str.VS.Cancel">终止扫描</sys:String>

	<sys:String x:Key="str.Tip.VS.Cancel">立即终止正在执行的扫描，界面停止等待；DLL会在设定超时后自动结束检索。</sys:String>

	<sys:String x:Key="str.Tip.VS.CaseSensitive">勾选后，字符串（FString/FName/FText）检索严格区分大小写，默认关闭兼容CE模糊匹配规则，仅对字符串类型生效。</sys:String>

	<sys:String x:Key="str.Tip.VS.Parallel">开启后首次扫描使用多线程并发遍历，速度大幅提升；关闭强制单线程读取内存，规避部分游戏反作弊拦截跨线程内存读取。仅首次全扫描支持并行，增量扫描始终单线程。</sys:String>

	<sys:String x:Key="str.Tip.VS.BatchRead">默认开启，对象固定宽度字段合并单次内存读取，减少IO开销、提升缓存命中率，加快扫描速度。读取失败或收益不足时DLL自动降级为单字段读取；字符串、数组、映射数据始终单独读取，仅首次扫描生效。</sys:String>

	<sys:String x:Key="str.Tip.VS.DataType">
		选择要扫描的UE属性类型。
		纯数字无字节：一次性扫描整型/浮点，排除1字节与布尔，避免海量微小数值干扰结果。
		全数字：包含8位字节字段，适合血量这类单字节数值。
		同时支持单数字、字符串、向量、旋转体；FTransform暂不支持检索。
		可扫描指定类型的TArray数组，数组内每条元素独立匹配；长度超千万的数组会跳过防止程序崩溃。可查看「最大条数」提示了解全局匹配上限。
	</sys:String>

	<sys:String x:Key="str.Tip.VS.FirstScan">遍历所有游戏对象对应类型的UPROPERTY字段（含数组元素），执行匹配生成初始结果池，供增量筛选使用。字符串支持包含/开头/结尾匹配，向量输入X,Y,Z格式检索。</sys:String>

	<sys:String x:Key="str.Tip.VS.NextScan">重读已有匹配项，按新条件过滤。增减/不变规则会对比上一轮扫描数值。</sys:String>

	<sys:String x:Key="str.Tip.VS.NewScan">关闭当前扫描会话，清空所有结果，重新开始一轮全新检索。</sys:String>

	<!-- Multiple values group scan (build 1276) -->
	<sys:String x:Key="str.VS.Mode.Single">单数值模式</sys:String>
	<sys:String x:Key="str.VS.Mode.Group">多条件分组模式</sys:String>
	<sys:String x:Key="str.VS.Group.Hint">查找同时包含全部输入数值的游戏对象（例如力量、耐力、敏捷、智力在同一个属性对象中），数值输入顺序无影响，筛选精度远高于单数值检索，支持输入2~4个数值。</sys:String>
	<sys:String x:Key="str.VS.Group.AddRow">+ 添加数值条件</sys:String>
	<sys:String x:Key="str.VS.Group.RemoveRow">− 删除数值条件</sys:String>
	<sys:String x:Key="str.VS.Group.FirstScan">分组全量扫描</sys:String>
	<sys:String x:Key="str.VS.Group.NextScan">分组增量筛选</sys:String>
	<sys:String x:Key="str.VS.Group.NewScan">新建分组扫描</sys:String>
	<sys:String x:Key="str.VS.Group.FilterWatermark">筛选匹配对象：类/实例/字段/数值，空格代表且关系，示例："tickcount frozenint"…</sys:String>
	<sys:String x:Key="str.Tip.VS.Group.Filter">
		在服务端对全部结果进行过滤。**空格代表多条件同时满足**：每个关键词都要匹配对象内任意内容，但可对应不同字段。
		同时该筛选可锁定指定配对关系：一次扫描可能生成数十组匹配，表格仅随机展示一组；输入两个字段名可强制该行展示二者配对，方便定位目标数据。
		仅输入单个关键词时，会匹配类名、实例名、字段名、数值任意一项。
	</sys:String>
	<sys:String x:Key="str.Tip.VS.Group.FirstScan">遍历所有对象，筛选在不同数字字段偏移处同时存在所有输入数值的实体，数值默认匹配各类整型、浮点。使用分组增量扫描可进一步缩小范围并锁定对应字段偏移。</sys:String>
	<sys:String x:Key="str.Tip.VS.Group.ScanType">单条数值匹配规则：全量扫描支持等于/大于/小于；增量扫描额外支持变化/无变化/上升/下降，该模式下无需填写目标数值，会对比上一轮扫描结果。</sys:String>

	<!-- Object Tree -->
	<sys:String x:Key="str.ObjectTree.Title">对象树</sys:String>
	<sys:String x:Key="str.ObjectTree.Search">检索对象（空格代表多条件同时匹配）...</sys:String>
	<sys:String x:Key="str.ObjectTree.Reload">重新加载</sys:String>
	<sys:String x:Key="str.ObjectTree.Loading">加载中...</sys:String>
	<sys:String x:Key="str.ObjectTree.CopyClassName">复制类名</sys:String>
	<sys:String x:Key="str.ObjectTree.CopyObjectName">复制对象名</sys:String>
	<sys:String x:Key="str.ObjectTree.CopyAddress">复制内存地址</sys:String>
	<sys:String x:Key="str.ObjectTree.FindInstancesByType">按类查找实例</sys:String>
	<sys:String x:Key="str.ObjectTree.FindInstancesByTypeAndName">按类+名称查找实例</sys:String>
	<sys:String x:Key="str.ObjectTree.OpenInLiveWalker">在实时查看器打开</sys:String>
	<sys:String x:Key="str.ObjectTree.ShowRelated">查看关联对象</sys:String>
	<sys:String x:Key="str.ObjectTree.LocateInGWorld">在GWorld中定位</sys:String>
	<sys:String x:Key="str.ObjectTree.LocateInGameEngine">在GameEngine中定位</sys:String>
	<sys:String x:Key="str.ObjectTree.FilterHint">筛选（空格=且，例如 BP 角色）</sys:String>
	<sys:String x:Key="str.ObjectTree.ClassFilter">类筛选：</sys:String>
	<sys:String x:Key="str.ObjectTree.InstancesOnly">仅显示实例（隐藏反射元数据）</sys:String>
	<sys:String x:Key="str.ObjectTree.Cancel">取消</sys:String>


	<!-- Instance Finder -->
	<sys:String x:Key="str.InstanceFinder.CopyAddress">复制地址</sys:String>
	<sys:String x:Key="str.InstanceFinder.FindFunc">查找函数</sys:String>

    <!-- Live Walker -->
	<sys:String x:Key="str.LiveWalker.SearchHint">检索字段…</sys:String>
	<sys:String x:Key="str.LiveWalker.MatchPrev">▲ 上一条匹配</sys:String>
	<sys:String x:Key="str.LiveWalker.MatchNext">▼ 下一条匹配</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.MatchPrev">跳转到上一个匹配字段，到达头部自动循环至末尾</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.MatchNext">跳转到下一个匹配字段，到达末尾自动循环至头部</sys:String>
