	<sys:String x:Key="str.TP.MarkersHeader">坐标标记点</sys:String>
	<sys:String x:Key="str.TP.Save">保存点位</sys:String>
	<sys:String x:Key="str.TP.Recall">传送至标记</sys:String>
	<sys:String x:Key="str.TP.Force">强制跨关卡传送</sys:String>
	<sys:String x:Key="str.TP.Clear">清空标记</sys:String>

	<sys:String x:Key="str.TP.CursorHeader">光标传送（适配2.5D、45度俯视角游戏）</sys:String>
	<sys:String x:Key="str.TP.ToCursor">传送到鼠标光标处</sys:String>
	<sys:String x:Key="str.TP.ZOffset">Z轴高度偏移：</sys:String>
	<sys:String x:Key="str.TP.Channel">碰撞检测通道：</sys:String>
	<sys:String x:Key="str.TP.FallbackCenter">无光标时改用屏幕中心落点</sys:String>
	<sys:String x:Key="str.TP.CursorHotkey">全局光标传送热键（保持游戏窗口焦点即可触发）</sys:String>

	<sys:String x:Key="str.TP.BugHeader">BugItGo 互通功能</sys:String>
	<sys:String x:Key="str.TP.CopyBugItGo">转为BugItGo格式复制</sys:String>
	<sys:String x:Key="str.TP.RunBugItGo">执行坐标传送</sys:String>
	<sys:String x:Key="str.TP.BugHint">粘贴格式支持：BugItGo X Y Z、纯XYZ坐标、?BugLoc=(坐标)?BugRot=(旋转)字符串</sys:String>

	<sys:String x:Key="str.TP.LastHeader">上一位置（系统自动存档）</sys:String>
	<sys:String x:Key="str.TP.LastHint">
		每次执行召回、强制传送、BugItGo、光标传送前，工具都会自动记录当前位置，用于传送失误后撤销；
		该存储位由系统管理，无法手动存入，仅可撤回调用
	</sys:String>
	<sys:String x:Key="str.TP.RecallLast">返回上一位置</sys:String>

	<sys:String x:Key="str.TP.HkHeader">热键设置</sys:String>
	<sys:String x:Key="str.TP.HkHint">
		全局热键配置：标记保存/召回/回退、BugItGo、调试相机、无敌模式/超级跳跃/移速/重力开关、各类传送动作；
		游戏处于前台时即可触发。绑定方式：点击设置，按下组合键（Ctrl/Alt/Shift+按键）或单键；Esc取消绑定。
		暂仅支持键盘，鼠标侧键、手柄无效；配置自动保存。带⚠标识代表热键已被其他程序占用，需释放或更换组合键
	</sys:String>

	<sys:String x:Key="str.TP.ExpHkHeader">实验性功能热键</sys:String>
	<sys:String x:Key="str.TP.ExpHkHint">前台常驻开关、飞行模式切换等实验功能全局热键；仅开启实验功能后生效，关闭则自动解绑（含紧急后台退出热键）；绑定方式同上</sys:String>
	<sys:String x:Key="str.TP.HkClear">清空热键绑定</sys:String>

	<sys:String x:Key="str.TP.CeHeader">导出至CE</sys:String>
	<sys:String x:Key="str.TP.AddActions">批量添加动作记录至CE地址列表</sys:String>
	<sys:String x:Key="str.TP.SaveCt">保存CE修改表(.CT)…</sys:String>

	<!-- Global pointers (CE) — DLL-invoke GWorld / GameEngine as CE symbols -->
	<!-- 全局指针 → 注入CE符号映射 -->
	<sys:String x:Key="str.TP.PtrHeader">全局指针 → Cheat Engine 符号注册</sys:String>
	<sys:String x:Key="str.TP.PtrHint">
		创建CE内存条目，由已注入的UE5Dumper.dll读取运行时全局指针，并注册为CE全局符号，可直接在指针链中调用。
		启用条目：注册符号（UE_GWorld / UE_GameEngine）；
		关闭条目：注销符号并释放占用缓冲区。
		符号可直接作为指针基址使用：[UE_GWorld]+偏移 / [UE_GameEngine]+偏移，支持冻结数值、任意CE条目读取调用。
		GWorld绑定稳定的 GWorld内存槽位，切换关卡自动跟随更新；
		GameEngine为UEngine*引擎实例快照，需手动刷新获取最新值。
		数据通过AOBMaker插件推送至Cheat Engine；未连接插件时，会将CE内存条目XML复制到剪贴板，右键CE地址列表选择粘贴即可导入。
		依赖DLL注入与游戏正常运行。
	</sys:String>

	<sys:String x:Key="str.TP.PtrGWorld">获取 GWorld 指针</sys:String>
	<sys:String x:Key="str.TP.PtrGameEngine">获取 GameEngine 指针</sys:String>

	<sys:String x:Key="str.Tip.TP.PtrGWorld">
		创建CE条目，经由DLL解析稳定 GWorld内存槽，注册为符号 UE_GWorld；
		使用 [UE_GWorld]+偏移 即可自动解引用获取当前UWorld实例，切换场景全程自动适配，不会停留在旧快照。
		启用=注册符号，关闭=注销（槽位属于游戏原生地址，无需额外释放内存）。
		有AOBMaker则直接推送CE；无插件则生成可粘贴的CE内存条目XML。
		基于内部消息队列CMD_QUERY_PTR实现，规避executeCodeEx无法读取导出函数返回值的限制。
	</sys:String>

	<sys:String x:Key="str.Tip.TP.PtrGameEngine">
		创建CE条目，DLL遍历GObjects全局对象表解析实时UEngine*引擎实例，注册符号 UE_GameEngine；
		[UE_GameEngine]+偏移可直接遍历引擎内部结构，无需依赖静态GEngine导出槽。
		启用=注册符号；关闭=注销符号+释放缓冲区。
		推送/剪贴板逻辑同上，底层均调用消息队列CMD_QUERY_PTR。
	</sys:String>

	<sys:String x:Key="str.TP.Warning">⚠ 仅单机可用；联机游戏会触发服务器回弹修正，瞬移还可能触发反作弊风控</sys:String>
	<sys:String x:Key="str.TP.BestEffort">
		ℹ 容错执行机制（遵循 teleport-spec.md 设计规范）：
		依靠反射解析玩家Pawn对象，优先调用引擎原生接口完成位移，调用失败则降级为直接内存写入；
		绝大多数虚幻游戏均可适配，但部分游戏角色、相机由独立内部系统驱动：可能出现角色瞬移但视角不跟随的情况。
	</sys:String>

	<sys:String x:Key="str.Tip.TP.Refresh">读取当前玩家世界坐标与控制旋转（DLL通过反射链路：本地PlayerController → Pawn → 根组件解析）</sys:String>
	<sys:String x:Key="str.Tip.TP.Auto">每0.5秒自动刷新坐标与相机视角；无相机反射字段的游戏会静默跳过视角读取；默认关闭；断开注入后自动停止刷新</sys:String>
	<sys:String x:Key="str.Tip.TP.Locate">
		在实时内存浏览器定位当前Pawn对象：跳转Live Walker，沿GWorld链路逐层寻址定位角色实体；
		先刷新最新坐标获取实时Pawn地址；
		启用世界分区/关卡流送的游戏，会依托关卡反向引用寻址（浏览器标注via level）；刚生成、暂无引用的临时实体无法检索
	</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateGameEngine">
		从GameEngine结构查找Pawn：不通过GWorld，直接遍历引擎实例图谱检索角色；
		备注：Pawn属于世界Actor，层级隶属于GWorld之下，绝大多数场景无法访问，角色寻址优先使用上方🌍GWorld定位按钮；仅作功能对称保留
	</sys:String>
	<sys:String x:Key="str.Tip.TP.LocatePos">
		GWorld内定位坐标矢量：沿GWorld链路直达根组件RelativeLocation三维向量(X/Y/Z)，一键生成完整指针链指向坐标；刷新最新姿态后执行；
		父子绑定角色存储的是相对父物体的偏移坐标
	</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateVel">
		GWorld内定位速度矢量：寻址CharacterMovement组件Velocity三维速度向量，生成指针链读取运动速率；
		无移动组件的载具、自定义移动框架不可用
	</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateAccel">定位加速度矢量：直达CharacterMovement.Acceleration输入加速度字段；刷新姿态后寻址；无移动组件不支持</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateSpeed">速度无独立存储字段，由速度矢量模长计算得出；此按钮跳转Velocity矢量地址查看三轴分量；刷新姿态后寻址</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateCamLoc">定位相机缓存视角坐标：APlayerCameraManager.CameraCachePrivate.POV.Location；刷新视角后寻址；视角布局未开放反射时失效</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateCamFov">定位相机视野FOV浮点值：APlayerCameraManager.CameraCachePrivate.POV.FOV；刷新视角后寻址；布局无反射则不可用</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateRot">定位操控旋转值：直达控制器ControlRotation俯仰/偏航/翻滚旋转体，控制瞄准与视角朝向；刷新姿态后寻址</sys:String>
	<sys:String x:Key="str.Tip.TP.LocateCamRot">定位相机缓存旋转：APlayerCameraManager.CameraCachePrivate.POV.Rotation；刷新视角后寻址；无反射布局失效</sys:String>
	<sys:String x:Key="str.Tip.TP.Velocity">实时速度(厘米/秒)、加速度(厘米/秒²)：直接读取角色移动组件数据，无需引擎函数调用；开启自动刷新可实时观测数值变化；载具/自定义移动框架会显示无数据</sys:String>
	<sys:String x:Key="str.Tip.TP.Save">将当前坐标姿态存入标记位；标记存储于DLL内存，重启UI只要游戏进程不关闭就不会丢失</sys:String>
	<sys:String x:Key="str.Tip.TP.Recall">瞬移回该标记点位：调用K2_SetActorLocation开启强制传送，同步恢复旋转姿态并清空速度；切换关卡后禁止召回，需勾选强制方可执行</sys:String>
	<sys:String x:Key="str.Tip.TP.Force">跨关卡强制召回标记点位；可能被传送至未加载区域，谨慎使用</sys:String>
	<sys:String x:Key="str.Tip.TP.Clear">清空当前标记存储数据</sys:String>
	<sys:String x:Key="str.Tip.TP.HkClear">清空本条快捷键绑定</sys:String>
	<sys:String x:Key="str.Tip.TP.ToCursor">角色瞬移至鼠标指向的世界位置；无鼠标界面则默认屏幕中心；调用K2_TeleportTo规避模型嵌入地形问题</sys:String>
	<sys:String x:Key="str.Tip.TP.ZOffset">落点额外抬高高度，防止角色胶囊体穿模卡地面（默认100单位）</sys:String>
	<sys:String x:Key="str.Tip.TP.Channel">碰撞检测通道ETraceTypeQuery字节值：0=可见通道（引擎默认）；部分游戏重映射碰撞通道，落点异常时可修改此项</sys:String>
	<sys:String x:Key="str.Tip.TP.FallbackCenter">无鼠标画面（HD-2D类游戏）时，统一从屏幕中心发射碰撞射线</sys:String>
	<sys:String x:Key="str.Tip.TP.CursorHotkey">绑定全局系统快捷键触发鼠标瞬移，游戏窗口保持前台聚焦、鼠标不会切出；自动分配空闲组合键：优先Ctrl+F8~F5，其次Alt+F8~F5；绑定按键会显示在输入框旁</sys:String>
	<sys:String x:Key="str.Tip.TP.CopyBugItGo">
		读取当前坐标，生成 BugItGo X Y Z 格式字符串存入剪贴板，可直接粘贴输入框一键传送；
		BugIt调试指令无法向DLL回传数据，因此由程序直接读取姿态拼接坐标
	</sys:String>
	<sys:String x:Key="str.Tip.TP.RunBugItGo">解析粘贴的坐标字符串执行瞬移；无需开启CheatManager，底层逻辑与标记召回完全一致</sys:String>
	<sys:String x:Key="str.Tip.TP.RecallLast">撤销上一次瞬移：返回瞬移前自动备份的坐标；仅单向回退，重复点击可反复撤销最近一次传送；系统自动占用该存储位，无法手动保存点位</sys:String>
	<sys:String x:Key="str.Tip.TP.HkSet">快捷键录制：点击后按下想要绑定的按键组合（Ctrl/Alt/Shift修饰键+普通按键，或单键）；ESC取消录制；全局注册，游戏前台内均可触发</sys:String>
	<sys:String x:Key="str.Tip.TP.AddActions">
		批量导入17组瞬发烫点记录（标记保存1-3、标记召回1-3、撤销上次瞬移、BugIt、BugItGo、鼠标瞬移、获取视角、读取坐标、朝向瞬移、指定坐标传送、鼠标瞬移开关、清空全部标记）
		外加3项移动属性开关（移速、重力、超级跳跃，数值取当前滑块倍率，勾选生效、取消关闭），经由AOBMaker写入CE修改表；
		瞬发烫点触发一次自动取消勾选；移速开关勾选期间DLL持续锁定数值；方向/坐标类记录固化当前参数；需要AOBMaker插件在线连接
	</sys:String>
	<sys:String x:Key="str.Tip.TP.SaveCt">离线备份：导出包含17组瞬移记录+3项移动开关的CE .CT修改表，适配当前滑块参数；未连接AOBMaker时使用，CE通过文件-打开载入</sys:String>

	<!-- Teleport: Debug Camera (free-look) -->
	<sys:String x:Key="str.TP.DcHeader">调试自由视角相机</sys:String>
	<sys:String x:Key="str.TP.DcHint">
		调用UCheatManager::ToggleDebugCamera脱离角色视角自由飞行；即便正式版打包删除关闭逻辑，DLL也会强制切回玩家控制器；
		需要生成玩家控制器实例，先进入游戏游玩界面；仅保留ToggleDebugCamera指令的游戏可用
	</sys:String>
	<sys:String x:Key="str.TP.DcState">当前状态：</sys:String>
	<sys:String x:Key="str.TP.DcOn">强制开启</sys:String>
	<sys:String x:Key="str.TP.DcOff">强制关闭</sys:String>
	<sys:String x:Key="str.TP.DcRefresh">↻ 刷新状态</sys:String>
	<sys:String x:Key="str.Tip.TP.DcOn">确定性开启：先读取状态，关闭才执行切换；幂等重复点击无效果</sys:String>
	<sys:String x:Key="str.Tip.TP.DcOff">确定性关闭并归还视角控制权；正式版阉割关闭逻辑时，DLL直接替换本地玩家控制器恢复视角</sys:String>
	<sys:String x:Key="str.Tip.TP.DcRefresh">重新读取相机状态：1开启 / 0关闭 / 无CheatManager实例则未知</sys:String>
	
	<!-- God Mode (Solitar — force AActor.bCanBeDamaged) -->
	<sys:String x:Key="str.TP.GmHeader">无敌模式</sys:String>
	<sys:String x:Key="str.TP.GmHint">
		强制将玩家Actor受伤害标识bCanBeDamaged设为false，引擎标准ApplyDamage伤害流程会直接丢弃伤害；
		开启后定时器定时刷新标识，复活后依旧保持无敌；需进入游戏生成角色；
		自研血条伤害系统会绕过该标识，需改用数值搜索冻结血量或属性检索查找游戏专属无敌开关；仅单机可用，联机该标识由服务器同步校验
	</sys:String>
	<sys:String x:Key="str.TP.GmState">当前状态：</sys:String>
	<sys:String x:Key="str.TP.GmOn">强制开启</sys:String>
	<sys:String x:Key="str.TP.GmOff">强制关闭</sys:String>
	<sys:String x:Key="str.TP.GmRefresh">↻ 刷新状态</sys:String>
	<sys:String x:Key="str.TP.GmCopyScript">添加至CE脚本</sys:String>
	<sys:String x:Key="str.Tip.TP.GmOn">开启无敌，清除可受伤害标记；DLL每300毫秒刷新一次，角色复活不会失效</sys:String>
	<sys:String x:Key="str.Tip.TP.GmOff">关闭无敌，恢复受伤害标识，停止后台定时刷新</sys:String>
	<sys:String x:Key="str.Tip.TP.GmRefresh">读取角色无敌状态：1免疫伤害 / 0可受伤 / 无角色实例则未知</sys:String>
	<sys:String x:Key="str.Tip.TP.GmCopyScript">
		生成独立CE汇编脚本，勾选开启无敌、取消关闭；经由DLL消息队列运行；
		接入AOBMaker直接推送CE，未连接则复制XML剪贴板粘贴使用；无需UI在线连接即可运行
	</sys:String>
	
	<!-- Player Stealth meter (Solide — auto-find + hold a stealth/visibility float at 0) -->
	<sys:String x:Key="str.TP.StHeader">潜行警戒条</sys:String>
	<sys:String x:Key="str.TP.StState">状态：</sys:String>
	<sys:String x:Key="str.TP.StHint">自动检索玩家角色及其附属组件上代表可见度、噪音、探测值、警觉度的数值变量，并强制锁定为0，让游戏侦测进度永远不会上涨。
	虚幻引擎不存在统一通用的潜行侦测总开关，仅游戏开放了可反射的潜行/可视字段时才可生效。
	使用步骤：点击检测 → 核对识别到的目标字段 → 开启永久归零锁定。
	检索无果时，可前往属性检索面板搜索关键词（visib、detect、noise），手动将浮点数值强制置0。仅限单机游戏使用。</sys:String>
	<sys:String x:Key="str.TP.StDetect">检测警戒数值</sys:String>
	<sys:String x:Key="str.TP.StHold">锁定数值为0</sys:String>
	<sys:String x:Key="str.TP.StReset">重置解除锁定</sys:String>
	<sys:String x:Key="str.Tip.TP.StDetect">解析玩家角色及全部挂载组件，通过关键词权重打分筛选匹配潜行、可视、侦测相关的可反射数字字段；仅读取预览，不会修改内存，将最优候选值展示出来供你确认。</sys:String>
	<sys:String x:Key="str.Tip.TP.StHold">遍历该字段所属类的所有运行实例，统一强制赋值0，并依靠定时器循环覆写持续锁定；面板会显示当前已锁定的实例总数量。</sys:String>
	<sys:String x:Key="str.Tip.TP.StReset">解除数值锁定，恢复最初记录的原始数值，停止后台定时覆写。</sys:String>

	<sys:String x:Key="str.TP.FgHeader">保持前台运行</sys:String>
	<sys:String x:Key="str.TP.FgState">状态：</sys:String>
	<sys:String x:Key="str.TP.FgHint">强制游戏始终判定自身处于前台激活窗口，切后台后游戏主线程不会休眠暂停（屏蔽IdleWhenNotForeground逻辑）。
	部分切后台就暂停的游戏（例如女神异闻录3 Reload），需要开启此项才能正常预览视角、调用引擎函数；默认关闭。</sys:String>
	<sys:String x:Key="str.TP.FgOn">强制开启</sys:String>
	<sys:String x:Key="str.TP.FgOff">强制关闭</sys:String>
	<sys:String x:Key="str.TP.FgRefresh">↻</sys:String>
	<sys:String x:Key="str.Tip.TP.FgOn">开启前台锁定：DLL挂钩系统API GetForegroundWindow，欺骗游戏窗口永久处于激活状态。即便你切到本工具、Cheat Engine界面，游戏依旧持续帧刷新，可正常调用函数、查看游戏视角。</sys:String>
	<sys:String x:Key="str.Tip.TP.FgOff">关闭前台锁定，恢复系统原生窗口焦点逻辑，切出后台游戏会正常暂停休眠。</sys:String>
	<sys:String x:Key="str.Tip.TP.FgRefresh">重新读取前台锁定当前运行状态（开启/关闭）。</sys:String>
	<sys:String x:Key="str.TP.FgCopyScript">添加至CE</sys:String>
	<sys:String x:Key="str.Tip.TP.FgCopyScript">生成独立Cheat Engine汇编条目（勾选开启锁定、取消勾选关闭），经由DLL消息队列控制前台常驻功能。
	已连接AOBMaker则直接推送至CE地址列表；未连接会生成可粘贴的CE内存条目XML，右键CE地址列表选择粘贴即可；离线可独立运行，无需和工具保持连接。</sys:String>

	<!-- Standalone trainer export (no-DLL CE Lua .CT via AOBMaker) -->
	<sys:String x:Key="str.TP.TrainerHeader">独立离线修改器（无需注入DLL）</sys:String>
	<sys:String x:Key="str.TP.TrainerExport">导出至CE（适配当前游戏版本）</sys:String>
	<sys:String x:Key="str.Tip.TP.TrainerExport">
		将当前游戏GWorld指针链路与内存偏移封装为完整独立的CE Lua修改脚本，包含移速、重力、超级跳跃、无敌模式、坐标瞬移功能，经由AOBMaker插件直接推送进Cheat Engine。
		导出完成后无需注入DLL即可运行；仅适配当前游戏程序版本，游戏更新补丁后需要重新生成；必须依赖AOBMaker插件。
	</sys:String>
	
	<!-- Move Speed multiplier (Laufen — force UCharacterMovementComponent.MaxWalkSpeed) -->
	<sys:String x:Key="str.TP.MsHeader">移动速度</sys:String>
	<sys:String x:Key="str.TP.MsState">状态：</sys:String>
	<sys:String x:Key="str.TP.MsHint">通过滑块倍率缩放角色行走最大速度（区间10%~1000%，对数刻度，100%为原版默认速度）。首次启用时DLL记录原始数值，每250毫秒循环覆写锁定，角色复活、游戏逐帧重置均不会失效。引擎仅统一规范普通步行速度，冲刺、疾跑属于游戏自定义逻辑，可前往属性检索面板自行查找；需要角色正常生成并挂载角色移动组件，载具、自定义移动框架不支持；仅限单机游玩，联机游戏移动数据由服务器同步校验。</sys:String>
	<sys:String x:Key="str.TP.MsApply">应用倍率</sys:String>
	<sys:String x:Key="str.TP.MsReset">重置恢复默认</sys:String>
	<sys:String x:Key="str.TP.MsRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.MsLocate">🌍 内存定位</sys:String>
	<sys:String x:Key="str.Tip.TP.MsApply">将最大行走速度强制设定为 原始数值 × 滑块倍率，定时器持续锁定，冲刺系统、技能效果无法覆盖改写。</sys:String>
	<sys:String x:Key="str.Tip.TP.MsReset">恢复预先保存的原生行走速度，终止定时锁定，滑块同步复位至100%。</sys:String>
	<sys:String x:Key="str.Tip.TP.MsRefresh">重新读取当前角色移动组件实时最大行走速度与锁定状态。</sys:String>
	<sys:String x:Key="str.Tip.TP.MsLocate">在GWorld内存链路中找到MaxWalkSpeed浮点字段，跳转至实时内存浏览器选中，可直接冻结、查看内存详情。</sys:String>

	<!-- Time dilation (Hemmung) — global slow-mo / freeze / speed-up -->
	<sys:String x:Key="str.TP.TdHeader">时间缩放</sys:String>
	<sys:String x:Key="str.TP.TdSubtitle">慢动作 / 子弹时间 / 时间静止 / 倍速</sys:String>
	<sys:String x:Key="str.TP.TdState">状态：</sys:String>
	<sys:String x:Key="str.TP.TdHint">修改可反射时间浮点数值，实现减速、冻结、加速游戏全局时间；两组参数相互独立、同步生效：
	「全局世界时间」修改AWorldSettings.TimeDilation：影响全体敌人、弹道、物理系统；
	「玩家个体时间」修改角色AActor.CustomTimeDilation：仅改变自身时间流速。
	玩家最终时间倍率 = 全局倍率 × 个体倍率；示例：全局0.5倍速 + 玩家2倍速 = 世界慢速、自身正常（子弹时间效果）。
	首次开启会记录原始数值，每250ms定时覆写锁定，游戏自带慢动作技能、动画序列无法将其重置。
	1倍为正常速度，0.5倍慢速，直接填0容易造成部分游戏物理系统崩溃，推荐使用0.05近似静止；游戏暂停状态下无法微调时间流速；仅限单机使用。</sys:String>
	<sys:String x:Key="str.TP.TdWorldHeader">全局世界时间（AWorldSettings.TimeDilation）</sys:String>
	<sys:String x:Key="str.TP.TdPawnHeader">玩家独立时间（AActor.CustomTimeDilation）</sys:String>
	<sys:String x:Key="str.TP.TdApply">应用设置</sys:String>
	<sys:String x:Key="str.TP.TdReset">重置</sys:String>
	<sys:String x:Key="str.TP.TdRefreshBoth">↻ 刷新两项数值</sys:String>
	<sys:String x:Key="str.TP.TdFreeze">时间静止</sys:String>
	<sys:String x:Key="str.TP.TdQuarter">0.25倍速</sys:String>
	<sys:String x:Key="str.TP.TdHalf">0.5倍速</sys:String>
	<sys:String x:Key="str.TP.TdNormal">1倍正常</sys:String>
	<sys:String x:Key="str.TP.TdDouble">2倍速</sys:String>
	<sys:String x:Key="str.Tip.TP.TdApply">锁定当前滑块设定的时间倍率，后台定时持续覆写，游戏无法自动还原；全局与玩家参数互不干扰，修改其一不会影响另一项。</sys:String>
	<sys:String x:Key="str.Tip.TP.TdReset">恢复本组时间倍率至初始原生数值，关闭锁定，滑块归位1倍；另一组时间参数保持不变。</sys:String>
	<sys:String x:Key="str.Tip.TP.TdRefresh">同时读取全局、玩家两组实时时间缩放数值与运行状态。</sys:String>
	<sys:String x:Key="str.Tip.TP.TdEffective">玩家实际时间流速=全局倍率×个体倍率；全局减速会连带玩家一同变慢。想要子弹时间效果：全局调0.5倍、玩家设2倍相互抵消。</sys:String>

	<!-- Gravity multiplier (Laufen — force UCharacterMovementComponent.GravityScale) -->
	<sys:String x:Key="str.TP.GrHeader">重力系数</sys:String>
	<sys:String x:Key="str.TP.GrState">状态：</sys:String>
	<sys:String x:Key="str.TP.GrHint">滑块缩放角色重力系数（10%~1000%对数刻度，100%原版默认）。低于100%下落缓慢、浮空轻盈、跳跃更高；高于100%下坠沉重快速。后台定时循环锁定数值，抵御游戏逐帧覆盖改写。仅作用于玩家单人，不会修改场景全局重力；极值过大容易出现穿地板、坠落伤害异常问题。暂未支持UE5.4及以上新版本的自定义重力方向功能；需要角色挂载角色移动组件；仅限单机。</sys:String>
	<sys:String x:Key="str.TP.GrApply">应用重力倍率</sys:String>
	<sys:String x:Key="str.TP.GrReset">重置默认重力</sys:String>
	<sys:String x:Key="str.TP.GrRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.GrLocate">🌍 内存定位</sys:String>
	<sys:String x:Key="str.Tip.TP.GrApply">重力系数 = 原始值 × 滑块倍率，定时器持续锁定生效。</sys:String>
	<sys:String x:Key="str.Tip.TP.GrReset">重力恢复初始默认数值，滑块复位100%，停止锁定。</sys:String>
	<sys:String x:Key="str.Tip.TP.GrRefresh">读取当前角色移动组件重力系数与锁定状态。</sys:String>
	<sys:String x:Key="str.Tip.TP.GrLocate">在GWorld内存中找到GravityScale重力浮点变量，跳转实时内存浏览器选中查看。</sys:String>

	<!-- Super Jump toggle (Laufen — force UCharacterMovementComponent.JumpZVelocity) -->
	<sys:String x:Key="str.TP.SjHeader">超级跳跃</sys:String>
	<sys:String x:Key="str.TP.SjState">状态：</sys:String>
	<sys:String x:Key="str.TP.SjHint">常驻高跳跃开关：强制修改角色起跳竖直初速度JumpZVelocity并持续锁定。滑块代表跳跃高度百分比（10%~3000%，100%原版）；跳跃最高点高度与起跳速度呈平方关系，因此速度倍率 = √(高度倍率)；例：400%高度 = 起跳速度翻倍。虚幻引擎没有直接的跳跃高度参数，依靠修改起跳冲量实现效果。开启后永久锁定；关闭恢复原始数值；重置会同步将滑块切回默认。需要角色搭载角色移动组件；仅限单机。</sys:String>
	<sys:String x:Key="str.TP.SjOn">强制开启</sys:String>
	<sys:String x:Key="str.TP.SjOff">强制关闭</sys:String>
	<sys:String x:Key="str.TP.SjReset">重置</sys:String>
	<sys:String x:Key="str.TP.SjRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.SjLocate">🌍 内存定位</sys:String>
	<sys:String x:Key="str.TP.SjHotkeyHint">可在上方标记快捷键区域绑定全局热键，游戏内一键切换超级跳跃开关。</sys:String>
	<sys:String x:Key="str.Tip.TP.SjOn">开启超级跳跃：起跳速度=原始值 × √(高度百分比)，定时器持续锁定，角色复活依旧生效。</sys:String>
	<sys:String x:Key="str.Tip.TP.SjOff">关闭超级跳跃，起跳速度恢复原版默认数值。</sys:String>
	<sys:String x:Key="str.Tip.TP.SjReset">关闭超级跳跃，高度滑块复位至100%初始状态。</sys:String>
	<sys:String x:Key="str.Tip.TP.SjRefresh">读取当前起跳竖直速度数值与开关运行状态。</sys:String>
	<sys:String x:Key="str.Tip.TP.SjLocate">在GWorld内存链路找到JumpZVelocity起跳速度浮点字段，跳转实时内存浏览器选中。</sys:String>

	<!-- Fly (Dunste — no-gravity keyboard-driven 3D flight) -->
	<sys:String x:Key="str.TP.FlyHeader">飞行模式（无重力3D飞行）</sys:String>
	<sys:String x:Key="str.TP.FlyState">状态：</sys:String>
	<sys:String x:Key="str.TP.FlyHint">
		无重力自由飞行：强制将角色移动模式切换为飞行模式MOVE_Flying，依靠键盘操控移动。按键输入由游戏内部读取，请保持游戏窗口处于前台聚焦。
		操控以相机视角为准：前后、左右平移均朝向镜头看向的方向（鼠标/手柄正常转动视角）；升降按键垂直上下移动。
		先选择按键方案、设定飞行速度，再开启/关闭飞行，也可绑定全局热键一键切换。
		默认开启碰撞检测，不会穿墙；勾选穿墙模式即可关闭角色碰撞，穿透场景几何体。
		需要角色正常生成并挂载角色移动组件；仅单机可用；少数服务器权威移动机制游戏（如最终幻想7重生）会持续覆写速度，飞行无法生效。
	</sys:String>
	<sys:String x:Key="str.TP.FlyPreset">按键方案：</sys:String>
	<sys:String x:Key="str.TP.FlyNoclip">穿墙模式（穿透墙体）</sys:String>
	<sys:String x:Key="str.Tip.TP.FlyNoclip">关闭：保留碰撞，飞行会被墙壁阻挡；开启：关闭角色全局碰撞，可直接穿过地形模型。两种模式移动速率一致，仅碰撞逻辑有区别；关闭穿墙或飞行时会自动恢复角色碰撞。</sys:String>
	<sys:String x:Key="str.TP.FlyOn">开启飞行</sys:String>
	<sys:String x:Key="str.TP.FlyOff">关闭飞行</sys:String>
	<sys:String x:Key="str.TP.FlyRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.FlyHotkeyHint">可在上方快捷键设置区绑定「飞行切换」全局热键，无需切出窗口即可在游戏内开关飞行。</sys:String>
	<sys:String x:Key="str.Tip.TP.FlyPreset">可选操控按键：WASD（Q/E转向、Z/C升降）、数字小键盘、方向键（Ins/Del转向、PgUp/PgDn升降）</sys:String>
	<sys:String x:Key="str.Tip.TP.FlyOn">开启飞行：强制锁定飞行移动模式，持续读取键盘输入，抵御游戏帧循环自动还原移动模式。</sys:String>
	<sys:String x:Key="str.Tip.TP.FlyOff">关闭飞行：恢复开启前记录的角色移动模式，终止飞行操控。</sys:String>
	<sys:String x:Key="str.Tip.TP.FlyRefresh">重新读取当前角色移动组件的飞行状态与移动模式。</sys:String>
	
	<!-- See-through occluders (Schlacht) -->
	<sys:String x:Key="str.TP.SeeThroughHeader">透视功能（遮挡物体透明）</sys:String>
	<sys:String x:Key="str.TP.SeeThroughState">状态：</sys:String>
	<sys:String x:Key="str.TP.SeeThroughHint">
		消除遮挡视野的障碍物：每帧从相机沿视线发射射线，若最近阻挡物为场景墙体、立柱等地形几何体，则将其临时隐藏。
		敌人、NPC、玩家自身永远不会被隐藏，仅对非角色类场景物体生效。
		一档仅隐藏视线最近一处遮挡物；转动视角会自动恢复物体显示，关闭功能后全部物体复原。
		依赖正常角色与相机组件；仅单机、容错运行。
		适用前提：场景碰撞体与可视网格为同一个Actor（绝大多数游戏）；部分游戏将碰撞与模型拆分独立实体（FF7重生CollisionAssetActor），射线命中隐形碰撞代理，透视无效果。
		注意：切出窗口游戏暂停时无法恢复物体，切回游戏会自动复原；开启上方「保持前台」可彻底避免暂停问题。
	</sys:String>
	<sys:String x:Key="str.TP.SeeThroughOn">开启透视</sys:String>
	<sys:String x:Key="str.TP.SeeThroughOff">关闭透视</sys:String>
	<sys:String x:Key="str.TP.SeeThroughRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.SeeThroughAddCe">添加至CE</sys:String>
	<sys:String x:Key="str.TP.SeeThroughPierce">透视层数：</sys:String>
	<sys:String x:Key="str.Tip.TP.SeeThroughPierce">视线方向需要透明的最近物体数量：1=仅第一层遮挡墙体；2=第一层+后方墙体，以此类推。射线途经敌人、玩家会跳过不计入层数；透视开启时修改数值即时生效。</sys:String>
	<sys:String x:Key="str.TP.SeeThroughHotkeyHint">可在上方实验快捷键区域绑定「透视切换」全局热键，游戏内一键开关无需切窗。</sys:String>
	<sys:String x:Key="str.Tip.TP.SeeThroughOn">启动透视后台线程：持续视线射线检测，隐藏最近非角色遮挡物体。</sys:String>
	<sys:String x:Key="str.Tip.TP.SeeThroughOff">关闭透视，恢复所有隐藏物体，终止检测线程。</sys:String>
	<sys:String x:Key="str.Tip.TP.SeeThroughRefresh">刷新透视运行状态、生效目标数量。</sys:String>
	<sys:String x:Key="str.Tip.TP.SeeThroughAddCe">经由AOBMaker推送独立CE勾选脚本（勾选开启/取消关闭），通过DLL消息队列驱动透视功能，添加后无需工具常驻连接；未检测到AOBMaker插件则不可用。</sys:String>
	
	<!-- Gravity Direction (Laufen — UE5.4+ UCharacterMovementComponent.GravityDirection) -->
	<sys:String x:Key="str.TP.GdHeader">重力方向（UE5.4+）</sys:String>
	<sys:String x:Key="str.TP.GdState">状态：</sys:String>
	<sys:String x:Key="str.TP.GdHint">
		自定义任意倾斜重力朝向，三轴范围 -100% ~ +100%（对应矢量 -1.0 ~ 1.0）。
		仅控制重力朝向，不改变重力大小：DLL会自动归一化为单位向量；例如仅Z轴-62%会被修正为垂直向下(0,0,-1)。
		如需斜向重力必须搭配多轴数值：X+100% + Z-100% = 斜向重力；默认(0,0,-100%)垂直向下；X+100%、Z=0可实现墙面行走。
		点击应用锁定朝向；重置恢复游戏默认参数，滑块回归垂直向下。
		仅支持UE5.4及以上版本且重力字段开放反射，旧版游戏显示不可用；仅限单机。
	</sys:String>
	<sys:String x:Key="str.TP.GdApply">应用设置</sys:String>
	<sys:String x:Key="str.TP.GdReset">重置</sys:String>
	<sys:String x:Key="str.TP.GdRefresh">↻</sys:String>
	<sys:String x:Key="str.TP.GdLocate">🌍 内存定位</sys:String>
	<sys:String x:Key="str.TP.GdHotkeyHint">快捷键设置区可绑定「重力方向切换」热键，游戏内快速启用关闭。</sys:String>
	<sys:String x:Key="str.Tip.TP.GdApply">将三轴滑块数值归一化后锁定为重力方向，定时器持续覆写；三轴全部置零则关闭自定义重力。</sys:String>
	<sys:String x:Key="str.Tip.TP.GdReset">恢复原生重力朝向，滑块复位垂直向下(0,0,-100%)。</sys:String>
	<sys:String x:Key="str.Tip.TP.GdRefresh">读取角色移动组件实时重力方向与锁定状态（UE5.4+）。</sys:String>
	<sys:String x:Key="str.Tip.TP.GdLocate">在GWorld结构中找到重力方向三维矢量FVector，跳转实时内存浏览器选中查看。</sys:String>
	
	<!-- Teleport: Camera POV (read-only) -->
	<sys:String x:Key="str.TP.PovHeader">相机视角参数（只读）</sys:String>
	<sys:String x:Key="str.TP.GetPov">获取视角</sys:String>
	<sys:String x:Key="str.TP.Fov">视野FOV：</sys:String>
	<sys:String x:Key="str.TP.PovHint">
		读取画面主相机APlayerCameraManager数据：世界坐标、旋转角度、视野大小，调用引擎原生接口获取。
		该数据和角色姿态相互独立：HD-2D、固定视角游戏相机与角色位置会出现明显偏差。
		仅支持查看，无通用统一修改视角接口（画面每帧自动重新运算）；如需操控相机请使用下方调试相机功能。
	</sys:String>
	<sys:String x:Key="str.Tip.TP.GetPov">主线程调用相机接口读取当前坐标、旋转、FOV数值；菜单/加载界面主线程休眠无法读取。可对比相机与角色坐标，差值大且瞬移后不跟随代表相机独立运算。</sys:String>
	<sys:String x:Key="str.Tip.TP.PovSource">视角读取方式：invoke=调用相机管理器接口；raw=直接读取缓存视角（接口失效游戏备用方案，如八方旅人2）</sys:String>
	
	<!-- Teleport: directional / coordinate / cursor force -->
	<sys:String x:Key="str.TP.RelHeader">朝向视角瞬移</sys:String>
	<sys:String x:Key="str.TP.RelGo">向前瞬移</sys:String>
	<sys:String x:Key="str.TP.RelDist">距离（虚幻单位uu）：</sys:String>
	<sys:String x:Key="str.TP.RelHoriz">仅水平面移动（高度不变）</sys:String>
	<sys:String x:Key="str.Tip.TP.RelGo">沿角色面朝方向位移设定距离；负数向后移动。朝向优先读取角色前向矢量，无数据则取用操控旋转；可通过撤销上次瞬移回退。</sys:String>
	<sys:String x:Key="str.Tip.TP.RelDist">位移距离单位：虚幻单位（1uu≈1厘米）；负值向后移动。</sys:String>
	<sys:String x:Key="str.Tip.TP.RelHoriz">开启：仅水平方向移动，固定当前高度，等同于沿罗盘方向行走；关闭：跟随俯仰视角上下移动，飞行穿墙手感。</sys:String>

	<sys:String x:Key="str.TP.CoordHeader">定点坐标瞬移</sys:String>
	<sys:String x:Key="str.TP.CoordXyz">X / Y / Z 坐标：</sys:String>
	<sys:String x:Key="str.TP.CoordPyr">俯仰/偏航/翻滚：</sys:String>
	<sys:String x:Key="str.TP.CoordGo">传送至坐标</sys:String>
	<sys:String x:Key="str.TP.CoordFill">填入当前坐标</sys:String>
	<sys:String x:Key="str.TP.CoordSetRot">同步设置旋转</sys:String>
	<sys:String x:Key="str.Tip.TP.CoordGo">强制将角色传送至输入的精准世界XYZ坐标，不校验关卡，可在当前场景任意位置跳转；支持撤销上次瞬移。</sys:String>
	<sys:String x:Key="str.Tip.TP.CoordFill">读取角色当前姿态，自动填充XYZ坐标与旋转数值，方便微调点位。</sys:String>
	<sys:String x:Key="str.Tip.TP.CoordSetRot">勾选后瞬移同时套用下方俯仰偏航旋转；取消则保留原有朝向。</sys:String>
	
	<!-- Coordinate Library (P1) — docs/teleport-coord-library-spec.md -->
	<sys:String x:Key="str.TP.LibHint">分游戏独立存储无限量带备注坐标点位；和上方3个临时标记位区分：临时标记存放于DLL、适合热键调用；收藏库持久保存，游戏更新补丁后数据不会丢失。</sys:String>
	<sys:String x:Key="str.TP.LibSaveCurrent">＋保存当前位置</sys:String>
	<sys:String x:Key="str.TP.LibAddFields">＋录入上方坐标</sys:String>
	<sys:String x:Key="str.TP.LibDuplicate">复制条目</sys:String>
	<sys:String x:Key="str.TP.LibDelete">删除条目</sys:String>
	<sys:String x:Key="str.TP.LibClear">清空全部</sys:String>
	<sys:String x:Key="str.TP.LibClear.ConfirmTitle">确认清空当前游戏全部坐标收藏？</sys:String>
	<sys:String x:Key="str.TP.LibClear.ConfirmMessage">
		将删除该游戏总计 {0} 条坐标记录并删除存储文件。
		清空前会自动生成 .preclear.bak 备份文件，可手动前往程序目录恢复。
	</sys:String>
	<sys:String x:Key="str.TP.LibClear.ConfirmYes">确认清空</sys:String>
	<sys:String x:Key="str.TP.LibClear.Empty">收藏库暂无坐标数据</sys:String>
	<sys:String x:Key="str.TP.LibClear.Result">已清空 {0} 条坐标记录</sys:String>
	<sys:String x:Key="str.TP.LibClear.ResultBackedUp">已清空 {0} 条记录，备份文件存放于：{1}</sys:String>
	<sys:String x:Key="str.TP.LibFilter">搜索筛选：</sys:String>
	<sys:String x:Key="str.TP.LibFilterPlaceholder">空格分隔多条件：备注/分组/关卡名</sys:String>
	<sys:String x:Key="str.TP.LibGroup">分组：</sys:String>
	<sys:String x:Key="str.TP.LibCurrentMapOnly">仅显示当前关卡点位</sys:String>
	<sys:String x:Key="str.TP.LibGo">传送至选中点位</sys:String>
	<sys:String x:Key="str.TP.LibForceGo">跨关卡强制传送</sys:String>
	<sys:String x:Key="str.TP.LibToFields">→填入上方坐标框</sys:String>
	<sys:String x:Key="str.TP.LibEditLabel">备注名称：</sys:String>
	<sys:String x:Key="str.TP.LibEditGroup">所属分组：</sys:String>
	<sys:String x:Key="str.TP.LibApplyEdit">保存修改</sys:String>
	<sys:String x:Key="str.TP.LibUpdateCoords">用当前位置更新坐标</sys:String>
	<sys:String x:Key="str.Tip.TP.LibSaveCurrent">读取实时坐标姿态，以当前关卡命名存入收藏库。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibAddFields">将上方定点坐标框内填写的数值新建为收藏点位。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibGo">传送至选中收藏点位；点位所属关卡与当前不一致会拒绝执行，工具无法加载新场景，仅可在当前关卡内传送。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibForceGo">无视关卡校验强制传送；仅关卡更名但场景一致时可用；跨关卡坐标大概率会掉入场景外部虚空。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibCurrentMapOnly">隐藏其他关卡坐标（默认开启）；不同关卡坐标数值极易重合，混用会导致坠地穿模。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibUpdateCoords">保留条目备注与分组，用当前角色坐标覆盖原有点位数据。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibClear">清空当前游戏所有坐标收藏，操作附带确认弹窗与备份文件，可手动恢复。</sys:String>

	<sys:String x:Key="str.TP.LibExportCsv">导出CSV表格</sys:String>
	<sys:String x:Key="str.TP.LibExportTemplate">下载CSV模板</sys:String>
	<sys:String x:Key="str.TP.LibImportCsv">导入CSV文件…</sys:String>
	<sys:String x:Key="str.TP.LibImportReplace">覆盖原有数据（非合并）</sys:String>
	<sys:String x:Key="str.TP.LibImportApply">确认导入</sys:String>
	<sys:String x:Key="str.TP.LibImportCancel">取消导入</sys:String>
	<sys:String x:Key="str.Tip.TP.LibExportCsv">完整导出全部收藏坐标为UTF-8带BOM编码CSV，Excel可正常打开中文备注。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibExportTemplate">生成示例CSV模板，包含表头与3条示范点位，可自行编辑填写。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibImportCsv">读取CSV文件预览变更内容，点击确认导入才会写入数据；按表头匹配字段，列顺序调换、多余列均兼容。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibImportReplace">开启：导入文件完全替换现有收藏库，未出现在文件中的条目全部删除；关闭（默认）：仅新增条目、更新同名条目。</sys:String>

	<sys:String x:Key="str.TP.LibExportLua">推送至CE</sys:String>
	<sys:String x:Key="str.TP.LibSaveLua">保存为Lua脚本</sys:String>
	<sys:String x:Key="str.Tip.TP.LibExportLua">将全套坐标收藏打包为带筛选列表的CE汇编脚本，经由AOBMaker推送；无插件则复制脚本XML至剪贴板粘贴使用。脚本依赖UE5Dumper.dll注入，通过消息队列完成瞬移。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibSaveLua">将上述脚本导出保存为本地.lua文件。</sys:String>

	<sys:String x:Key="str.TP.LibImportLua">粘贴脚本解析坐标</sys:String>
	<sys:String x:Key="str.TP.LibImportLuaFile">导入Lua脚本文件…</sys:String>
	<sys:String x:Key="str.TP.LibPastePlaceholder">粘贴导出的坐标完整脚本（仅解析@UE5CD:COORDS区块，其余内容忽略）</sys:String>
	<sys:String x:Key="str.Tip.TP.LibImportLua">读取过往导出、手动修改过的Lua脚本坐标；仅识别指定标记区块，不会执行脚本代码。</sys:String>
	<sys:String x:Key="str.Tip.TP.LibImportLuaFile">功能同上，直接读取本地Lua文件。</sys:String>

	<sys:String x:Key="str.TP.LibExportLuaNoDll">推送至CE（无需注入DLL）</sys:String>
	<sys:String x:Key="str.Tip.TP.LibExportLuaNoDll">
		界面与筛选逻辑一致，瞬移依靠直接内存写入实现，不需要UE5Dumper.dll注入。
		必须安装AOBMaker插件，无剪贴板备用方案；脚本依赖离线修改器初始化条目。
		局限性：无关卡安全校验（关卡名称读取需要DLL）；游戏更新补丁后内存偏移直接失效，稳定性弱于DLL驱动模式；脚本归入「UE5CEDumper 离线修改器」分组，使用前需启用初始化条目。
	</sys:String>

	<sys:String x:Key="str.TP.LibZTol">落地高度补偿：</sys:String>
	<sys:String x:Key="str.Tip.TP.LibZTol">瞬移抵达时Z轴额外抬高的虚幻单位，避免精准落地时直接穿地板；0代表关闭。仅瞬移瞬间生效，收藏点位原始坐标不变；导出Lua脚本会同步带入该参数，保证效果统一；CSV导出不包含此项设置。</sys:String>

	<sys:String x:Key="str.TP.CursorForceHeader">强制控制鼠标光标</sys:String>
	<sys:String x:Key="str.TP.CursorForceHint">
		修改玩家控制器bShowMouseCursor变量，强制系统光标显示或隐藏；多用于游戏默认隐藏光标、需要鼠标点选瞬移的场景。
		单次生效：游戏逐帧刷新该参数会自动复原；输入模式锁定也可能重新隐藏光标。
	</sys:String>
	<sys:String x:Key="str.TP.CursorStateLabel">当前状态：</sys:String>
	<sys:String x:Key="str.TP.CursorOn">强制显示</sys:String>
	<sys:String x:Key="str.TP.CursorOff">强制隐藏</sys:String>
	<sys:String x:Key="str.TP.CursorRefresh">↻</sys:String>
	<sys:String x:Key="str.Tip.TP.CursorOn">开启本地玩家控制器光标显示开关。</sys:String>
	<sys:String x:Key="str.Tip.TP.CursorOff">关闭光标显示。</sys:String>
	<sys:String x:Key="str.Tip.TP.CursorRefresh">读取当前光标显示状态；无玩家控制器则显示未知。</sys:String>
	
	<!-- Interesting Properties Finder (B' / Unusual Location) -->
	<sys:String x:Key="str.IP.Load">开始检索</sys:String>
	<sys:String x:Key="str.IP.GameOnly">仅游戏自定义类</sys:String>
	<sys:String x:Key="str.IP.FilterHint">按属性名/类名筛选...</sys:String>
	<sys:String x:Key="str.IP.UnusualOnly">⚠ 仅非常规位置</sys:String>
	<sys:String x:Key="str.IP.ShowAll">显示全部（含低分条目）</sys:String>
	<sys:String x:Key="str.IP.ClearFilters">重置筛选</sys:String>
	<sys:String x:Key="str.IP.OpenInst">实例</sys:String>
	<sys:String x:Key="str.IP.OpenLive">实时内存</sys:String>
	<sys:String x:Key="str.IP.LocateGWorld">🌍</sys:String>
	<sys:String x:Key="str.IP.LocateGameEngine">⚙</sys:String>
	<sys:String x:Key="str.IP.CopyName">复制名称</sys:String>
	<sys:String x:Key="str.Tip.IP.Load">基于预设关键词库（生命值、伤害、金币、移速等）批量遍历检索，客户端算法对结果打分标记；专门高亮存放于非常规容器的属性（LocalPlayer、HUD、游戏视口客户端），这类数据是CE使用者只查找角色/玩家状态类时极易遗漏的作弊相关字段。</sys:String>
	<sys:String x:Key="str.Tip.IP.GameOnly">过滤引擎内置模块（/Script/Engine、/Script/CoreUObject等）；建议勾选，游戏专属属性才是制作修改表的目标。</sys:String>
	<sys:String x:Key="str.Tip.IP.Filter">模糊匹配属性名称或所属类名，大小写不敏感；示例：Health、PlayerState均可检索。</sys:String>
	<sys:String x:Key="str.Tip.IP.ClearFilters">清空文本检索框、分类筛选、非常规/显示全部开关，恢复初始默认状态。</sys:String>
	<sys:String x:Key="str.Tip.IP.OpenInst">跳转至实例查找标签页，自动填充当前行所属类名并检索运行实例列表。</sys:String>
	<sys:String x:Key="str.Tip.IP.Category">属性分类筛选：属性数值、战斗、资源、移动、杂项、其他。</sys:String>
	<sys:String x:Key="str.Tip.IP.UnusualOnly">仅展示归属非常规容器的属性：本地玩家、视口客户端、HUD、调试管理器；开发者没有放在角色、Pawn、PlayerState标准容器内的数据。</sys:String>
	<sys:String x:Key="str.Tip.IP.ShowAll">关闭时：隐藏低于分值阈值（默认4分）的低相关条目；开启后：无论评分高低，全部检索结果都展示。</sys:String>
	<sys:String x:Key="str.Tip.IP.OpenLive">在实时内存浏览器打开该属性所属类；若无运行实例，则跳转类结构体查看布局。</sys:String>
	<sys:String x:Key="str.Tip.IP.LocateGWorld">从GWorld全局对象追溯最短指针链定位该实例，在实时浏览器展示完整路径；未解析出GWorld前按钮禁用。</sys:String>
	<sys:String x:Key="str.Tip.IP.LocateGameEngine">从UGameEngine引擎根对象追溯指针路径，可访问GWorld无法覆盖的引擎层对象；绝大多数场景实体优先使用GWorld定位。</sys:String>
	<sys:String x:Key="str.Tip.IP.CopyName">将当前属性名称复制到剪贴板。</sys:String>
	<sys:String x:Key="str.IP.GenerateCT">📦 生成CE修改表</sys:String>
	<sys:String x:Key="str.Tip.IP.GenerateCT">将勾选的多条属性批量生成带锁定功能的.CT文件；按住Ctrl/Shift多选条目生效。脚本依赖ue5_freeze_helper.lua：可通过工具菜单注入锁定辅助脚本，或用CE打开CT后自行修改锁定数值；结构体、数组、非基础数值类型会自动跳过不生成。</sys:String>
	
	<!-- Proxy DLL / Deferred Scan -->
	<sys:String x:Key="str.Toolbar.StartScan">启动后台扫描</sys:String>

	<!-- Errors -->

	<!-- Tooltips: MainWindow toolbar -->
	<sys:String x:Key="str.Tip.Connect">通过命名管道与注入的DLL建立通信连接</sys:String>
	<sys:String x:Key="str.Tip.Disconnect">断开与DLL管道服务端的连接</sys:String>
	<sys:String x:Key="str.Tip.StartScan">触发代理DLL模式下的延迟遍历扫描</sys:String>
	<sys:String x:Key="str.Tip.AddressFormat">地址展示格式：绝对地址 / 模块偏移地址</sys:String>
	<sys:String x:Key="str.Tip.CollapsePointers">导出CE XML时压缩折叠多层指针链节点</sys:String>
	<sys:String x:Key="str.Tip.ArrayLimit">单行读取数组最大元素数量（2的N次方）</sys:String>
	<sys:String x:Key="str.Tip.DropDownLimit">CE下拉列表最大条目数（2的N次方）</sys:String>
	<sys:String x:Key="str.Tip.StringLength">CE字符串字段最大显示字符长度（2的N次方，区间16~4096）；作用于复制CE字段、导出XML。长度预留充足不会截断短字符串（CE以空字符判定结尾），适配游戏运行中动态变长的字符串。</sys:String>
	<sys:String x:Key="str.Tip.Fabricate">仅复制CE字段时生效：0=关闭。设置数值(2~4096，2的幂次)后，选中的顶层TArray数组会自动填充空占位行；依据数组元素布局生成空指针条目，提前预留游戏后续新增数据的插槽。仅作用于选中的一级数组，不会递归填充内部嵌套数组；仅支持TArray，Map/Set稀疏容器不适用。超出当前数组长度的条目会读取边界外内存（无安全风险）；数值超过256需谨慎，会造成CE表格体积臃肿、加载卡顿甚至超出导出上限。</sys:String>
	<sys:String x:Key="str.Tip.PreviewLimit">数值列展开展示结构体子字段数量（0=关闭预览）</sys:String>
	<sys:String x:Key="str.Tip.CsxDepth">指针递归解析深度（0=平铺不展开）；适用于CSX导出、CE XML复制；0~4为常规深度，5~6为深层递归，层级越高导出体积呈指数暴涨，UWorld深度6会生成数MB的XML文件。</sys:String>
	<sys:String x:Key="str.Tip.Toolbar.Options">导出全局配置：指针折叠、数组/下拉/预览上限、指针解析深度；单次打开软件永久生效。</sys:String>
	<sys:String x:Key="str.Tip.Export">多种格式导出游戏对象内存数据</sys:String>
	<sys:String x:Key="str.Tip.Tools">无需DLL在线连接的辅助工具：脚本导出注入、工具配置等</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectCeBootstrap">
		四种注入方案第③种：为当前打开的CE修改表一键添加注入记录。长期使用CE推荐方案②：工具菜单安装CE开机自动加载脚本，所有修改表永久拥有注入函数。
		①：代理DLL部署页安装；②：直接注入运行中游戏；④：独立UE5CEDumper.CT修改表。
		一键添加启用/禁用条目，自动注入UE5Dumper并启动管道通信；不会固定等待15秒，实时检测DLL就绪状态，失败弹出具体报错。依赖AOBMaker插件；无插件则将XML复制至剪贴板手动粘贴。独立CT文件依旧保留供开发者调试使用。
	</sys:String>
	<sys:String x:Key="str.Tip.Tools.InstallCeAutorun">
		将ue5_autorun.lua写入CE开机目录，CE启动自动加载；此后所有修改表内置ue5_inject()、ue5_shutdown()函数，CE主菜单新增注入入口。
		唯一无需独立CT与AOBMaker插件的方案，重度CE使用者首选。检测到CE正在运行直接安装；未运行则手动选择目录。挪动工具程序后需要重新安装，脚本内固化了DLL路径；重启CE生效。
	</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectCeHelperLua">一键推送ue5_invoke_helper.lua至当前CE表格，存在旧文件直接覆盖；免去手动导出文件再添加至表格的步骤。需要预先打开CE并加载AOBMaker插件；无插件自动降级适配。</sys:String>
	<sys:String x:Key="str.Tip.Tools.ExportCeHelperLua">导出ue5_invoke_helper.lua本地文件，放置于CT同目录，通过CE菜单添加至表格；所有预制汇编调用脚本均依赖该文件，每张修改表仅需配置一次。</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectFreezeHelperLua">一键推送ue5_freeze_helper.lua锁定脚本至CE表格；属性检索批量锁定功能必备，可与调用辅助脚本共存。</sys:String>
	<sys:String x:Key="str.Tip.Tools.ExportFreezeHelperLua">导出锁定脚本本地文件，AOBMaker不可用时手动添加至CE表格备用。</sys:String>
	
	<!-- Tooltips: Object Tree -->
	<sys:String x:Key="str.Tip.ObjectTree.Reload">重新从游戏进程读取全部UObject对象</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.Cancel">终止当前加载读取任务</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.Search">按名称/类名检索游戏内对象</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.SearchField">输入关键词回车或点击放大镜检索服务端全部对象；空格分隔多个关键词为与逻辑，同时匹配名称或类名。受结果上限限制，条目过多会提示精简关键词；清空内容检索则重载全部对象。输入时自动联想历史检索记录。</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.ClassFilter">依据父类类型筛选对象</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.Collapse">收起左侧对象树，右侧面板铺满窗口宽度</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.Expand">展开显示左侧对象树列表</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.TextFilter">本地二次文本筛选；空格分隔多关键词全部命中才显示，匹配名称、类名、内存地址。清空检索框重载恢复全量列表。</sys:String>
	<sys:String x:Key="str.Tip.ObjectTree.InstancesOnly">隐藏反射元数据（UClass、UFunction、结构体、枚举、资源包等），仅保留游戏运行实体实例；同时作用于顶部服务端检索与底部本地筛选。重载+底部筛选可无上限遍历全量对象；顶部检索速度更快但有数量封顶。</sys:String>
	
	<!-- Tooltips: Instance Finder -->
	<sys:String x:Key="str.Tip.InstanceFinder.ClassName">待检索类名称：默认模糊匹配（例如Character）；勾选精确匹配则完整字符一致才命中。可搭配对象名称联合检索，二选一填写即可检索。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.AddressField">地址反向解析：十六进制绝对地址 / 模块+偏移格式；查找该地址归属的UObject容器。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.Search">依据类名、对象名称检索运行实例，至少填写一项条件</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.ObjectName">可选附加条件：对象名称模糊匹配，大小写无关；与类名条件为交集逻辑；类名留空则仅检索对象名。检索逻辑运行于游戏进程内部，不会遗漏深层实例；结果存在数量上限，状态栏提示封顶时请缩小检索范围。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.ExactMatch">类名开启完整字符精确匹配，关闭为模糊包含匹配</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.NewestFirst">从最新创建实例开始遍历（InternalIndex数值最大），优先抓取刚生成的敌人、道具，规避数量上限截断最新条目；关闭则从最早实例排序（蓝图默认模板、初始实体）。也可点击列表表头Index手动切换排序。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.MaxResults">单次返回最大条目数：100~50000；游戏内部遍历是完整全量，该数值仅限制回传列表大小。出现封顶提示时调高数值；数值越大传输与本地筛选耗时越长。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.Keyword">检索结果本地二次过滤；空格分隔关键词为与逻辑，匹配名称、类名、地址，即时生效不会突破数量上限。想要获取上限外条目：缩小类名范围重新检索，或者调高最大返回数。</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.Lookup">输入地址查询对应的UObject对象详情</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.CopyAddr">复制实例内存绝对地址至剪贴板</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.OpenWalker">在实时内存浏览器打开该实例</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.LocateGWorld">从GWorld追溯最短指针链，在实时浏览器展示完整路径</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.LocateGWorldContainer">GWorld追溯容器归属对象，展开直达数组/容器内部元素</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.LocateGameEngine">从UGameEngine引擎根对象追溯指针路径，可访问GWorld无法覆盖的引擎层对象；场景实体优先选用GWorld定位</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.LocateGameEngineContainer">UGameEngine追溯容器上级，直达容器内数据元素</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.ExportCE">将实例指针链导出为CE XML格式</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.CopyFieldAddr">复制字段偏移绝对地址</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.AA">生成CE汇编调用脚本</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.CopyName">复制对象名称至剪贴板</sys:String>
	<sys:String x:Key="str.Tip.InstanceFinder.FindFunc">检索所有以该类为入参/返回值的UFunction函数；完整反射扫描包含原生C++函数，区别于仅字节码交叉引用检索</sys:String>
	
	<!-- Tooltips: Property Search -->
	<sys:String x:Key="str.Tip.PropertySearch.Query">检索属性名称：模糊匹配大小写不敏感，示例：Health、Mana、Gold；搭配类型筛选缩小范围，回车执行检索</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.Search">全类遍历检索属性；名称或类型至少填写一项，多类型用英文逗号分隔</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.TypeFilter">限定FProperty属性类型；输入字符快速筛选下拉列表，多类型逗号分隔为或逻辑</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ResultFilter">检索结果本地二次筛选，匹配类名、属性名、类型、父类、预览内容，无需和DLL通信</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.GameOnly">仅展示游戏自定义类，排除引擎官方内置类</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.Deep">递归遍历嵌套结构体、数组内部成员（结构体TArray/TSet/TMap），可以检索深埋多层的数据；检索速度变慢，结果会标注完整层级路径。关闭仅检索顶层直属属性，速度更快。</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.FindInstances">跳转实例查找器，自动填充当前类名检索所有运行实例</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.CopyOffset">复制属性内存偏移值至剪贴板</sys:String>

	<!-- Tooltips: Game Class Filter -->
	<sys:String x:Key="str.Tip.GameClassFilter.Load">读取游戏进程全部类列表</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.GameOnly">仅显示游戏项目自定义类，过滤引擎内置类</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.SuperFilter">按照父类/基类筛选</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.PackageFilter">依据UE资源包名称筛选</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.Clear">清空全部筛选条件</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.FindInstances">检索该类所有运行实体实例</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.WalkClass">打开类结构体面板，完整查看属性布局、内存偏移</sys:String>
	<sys:String x:Key="str.Tip.GameClassFilter.FindFunc">检索入参/返回值包含此类的全部UFunction，包含原生C++底层函数</sys:String>
	
	<!-- Live Walker: Functions -->
	<sys:String x:Key="str.LiveWalker.Functions">函数调用</sys:String>
	<sys:String x:Key="str.LiveWalker.FuncGenScript">INV</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FuncGenScript">INV：生成独立CE汇编+Lua调用脚本，推送至CE（无AOBMaker则复制剪贴板）；依托DLL管道解析实例地址、调用ProcessEvent引擎函数，无需提前加载辅助脚本。带参数函数会弹出输入框填写运行参数；返回值存入管道缓冲区默认不展示；CE控制台输入UE5_DEBUG=1，或修改脚本DEBUG开关，即可打印解析后的返回值并保留Lua窗口。</sys:String>
	<sys:String x:Key="str.LiveWalker.FuncPipeInvoke">PIPE</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FuncPipeInvoke">PIPE：软件内直接通过管道调用函数，由注入DLL执行ProcessEvent；弹出参数填写窗口，执行后直接展示解析完毕的返回结果，用于调试测试函数效果；需要分发固化脚本选用INV/固化AA模式。</sys:String>
	<sys:String x:Key="str.LiveWalker.FuncCopyBaked">AA(固化版)</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FuncCopyBaked">AA(固化版)：参数数值生成时直接写入脚本，勾选启用后固定参数仅调用一次；体积约为INV脚本1/5，方便分享分发。必须提前将ue5_invoke_helper.lua添加进CE表格。弹窗勾选校验返回值可对比调用前后内存快照；开启UE5_DEBUG=1打印返回数据。</sys:String>
	
	<sys:String x:Key="str.LiveWalker.GuessWhat">智能识别?</sys:String>

	<!-- Tooltips: Live Walker -->
	<sys:String x:Key="str.Tip.LiveWalker.StartWorld">跳转至GWorld全局根对象，展开顶层场景实体列表</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.StartGameEngine">以运行态UGameEngine引擎对象为根节点浏览；可向下遍历游戏实例、视口客户端、世界场景。依靠成员反射定位，非类名查找；该根路径无法生成AOB特征码，仅支持固定绝对地址</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.Back">后退至上一个浏览对象，还原选中条目与滚动位置；快捷键：Alt+左方向键、鼠标侧键4、浏览器后退键（仅当前标签激活时生效）</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.Forward">前进回到后退前的对象，还原选中状态与滚动位置；快捷键：Alt+右方向键、鼠标侧键5、浏览器前进键。前进会重新读取游戏内存：若原对象已释放/内存复用，会清空选中并提示；打开新地址会清空前进历史，逻辑和浏览器完全一致</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.Refresh">重新从游戏内存读取当前对象所有字段数据</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FindRefs">检索所有持有当前对象指针的UObject真实所有者；Outer/父层级仅代表资源命名打包层级，并非实际内存引用关系</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.AddressInput">地址跳转输入框：支持纯十六进制(0x7FF… / 7FF…)、CE模块偏移格式Game.exe+1A2B3C；兼容CE复制带引号格式"Game.exe"+1A2B，程序会自动剔除引号，适配含空格模块名。输入后回车或点击前往</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.Go">跳转至输入的内存地址</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FieldInst">跳转实例查找标签页，自动填充当前字段所属类名并检索全部运行实例</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportCE">将完整多级指针链以CE XML格式复制到剪贴板</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportCEField">仅复制选中字段的CE XML（Ctrl/Shift多选可批量导出）</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CancelExport">终止正在执行的导出任务（CE XML/字段导出/CSX结构体脚本），停止对象图谱解析，剪贴板与文件均不会生成内容</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.AobToggle">使用AOB特征码扫描获取GWorld基址，替代硬编码固定地址；游戏重启后指针依旧有效</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportOptions">CE导出全局设置：内存记录描述格式（附加偏移/类型）、AOB开关、指针折叠、智能识别选项</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.DescShowOffset">CE条目描述末尾追加十六进制字段偏移，示例：AbilitySystemComponent (7E0)；关闭则仅显示名称</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.DescShowType">CE条目末尾追加类/结构体/元素类型，示例：AbilitySystemComponent (LSAbilitySystemComponent)、[0] (ShieldAttributeSet)；折叠指针主干不会附加类型；关闭仅展示名称</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.DedupShared">共享对象去重：多处引用的同一对象首次展开完整层级，后续仅显示扁平「(共享)」指针；避免遍历World这类高关联对象时导出体积爆炸、内存溢出。关闭则每次引用都完整递归展开，深度过高文件会极其庞大</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExcludeSysComponents">默认开启。递归解析指针/结构体子项时，过滤引擎系统资源类（控件、音效、贴图、材质、粒子、尼亚加拉、动画实例），让CE导出聚焦游戏玩法数据；手动勾选的字段始终保留，仅自动解析子项会被过滤。角色、控制器、玩家状态、游戏实例等玩法类不会被屏蔽；数组、映射容器内元素不参与过滤。过滤后底部会提示隐藏系统字段数量；关闭则导出所有字段</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CollapseChain">将GWorld到目标的多级跳转合并为CE单层多级指针条目，保留基址、合并主干节点与目标字段；仅作用于完整XML导出与选中字段导出</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FlattenGas">GAS游戏属性扁平化（仅作用CE导出）：原本嵌套结构GameplayAttributeData（生命值、法力值等）包含基础值/当前值子节点，开启后平铺为同级条目「生命值 ▸ 基础值」，合并总偏移，CE编辑更简洁；仅适配GAS属性结构体，其余结构体维持嵌套层级。▸分隔符附带偏移信息，结构体类型统一标注在末尾；关闭保留嵌套分组</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FlattenLeafStructs">基础叶子结构体全局扁平化（GAS扁平化超集）：结构体全部由数字、浮点、布尔、枚举基础类型构成时（向量、旋转体、最大最小值结构体等），子字段平铺为同级「结构体 ▸ 字段」，合并偏移；若结构体包含对象指针、字符串、数组容器，则维持嵌套。▸附带偏移，类型统一后置；关闭保留嵌套</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.FlattenLeafRecords">存档记录结构体扁平化（叶子结构体扁平化升级版）：除基础数值外，FName、FString文本字段也视为叶子节点；存档数据{分数、时长、段位、ID、角色名}会全部平铺展开，数组/映射内每条记录都会拆分为扁平条目。结构体包含对象指针、富文本、容器则不扁平化；▸附带偏移，类型后置；关闭维持嵌套文件夹结构</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.RecordColors">记录配色设置：数组/映射扁平化导出后，奇偶行赋予不同文字底色，取消文件夹层级后依旧能区分每条存档记录；偶数行、奇数行可自定义十六进制色值，支持预设配色，重置恢复CE原生主题。默认：偶数天蓝、奇数无配色；配置永久保存</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CollapseLeafPointers">叶子指针折叠：指针指向的对象仅存有单个可监视数值（数字、FName、字符串）时，合并为「指针 ▸ 字段」单条记录，附带多级偏移；目标对象包含2个及以上字段则保留文件夹嵌套。关闭维持指针嵌套结构</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportCsx">导出CE结构体解析脚本(.csx)，下拉选择CE版本格式</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportCsxPre77">CE7.7旧版兼容格式：位域布尔值整体导出为字节，位索引标注在描述内，无独立位开关控件</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportCsx77">CE7.7及以上新版格式：位域布尔生成原生二进制类型，精准配置起始位、位宽，结构体解析面板可直接切换开关</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.ExportHeader">导出C++结构体SDK头文件(.h)</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CeAA">生成CE汇编脚本，将当前对象注册为CE全局符号。GWorld根路径生成重启可用脚本：启用时Lua自动遍历GWorld链路寻址，游戏重启依旧生效；勾选AOB则依托特征码定位GWorld，未勾选则为固定基址，重启需手动更新。非GWorld路径仅生成固定绝对地址，重启失效</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.GuessWhat">字段空白区间自动推测数据类型（指针、浮点、整型等）填充内存布局</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CopyFieldAddr">复制字段绝对内存地址</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CopyFieldName">复制字段名称至剪贴板</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.Search">按名称检索并高亮字段；检索记录会话内最多保存8条，输入首字母快速唤起；切换对象、后退、返回父级会清空输入框；切换标签页、刷新页面保留检索记录</sys:String>
	
	<!-- Tooltips: Pointer Panel -->
	<sys:String x:Key="str.Tip.Pointers.Copy">复制内存地址到剪贴板</sys:String>
	<sys:String x:Key="str.Tip.Pointers.CopyScan">复制AOB特征码扫描结果地址</sys:String>
	<sys:String x:Key="str.Tip.Pointers.ExtraScan">激进兜底扫描，尝试搜寻缺失指针特征码</sys:String>
	<sys:String x:Key="str.Tip.Pointers.TestExtraScan">模拟扫描进度界面，仅供开发者调试使用</sys:String>
	<sys:String x:Key="str.Tip.Pointers.ClearGameCache">清空当前游戏的扫描特征缓存，下次扫描会遍历全部特征模式</sys:String>
	<sys:String x:Key="str.Tip.Pointers.ResetAllCache">缓存文件重命名备份(001~010)，清空全局缓存从头生成</sys:String>
	
	<!-- Tooltips: Proxy Deploy -->
	<sys:String x:Key="str.Tip.ProxyDeploy.Scan">扫描Steam库内已安装虚幻引擎游戏</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Inject">四种部署方案第②种：游戏已经运行、无法重启时选用；无需提前部署代理、不用CE，通过CreateRemoteThread注入UE5Dumper.dll。选中进程即可注入并自动建立连接；游戏以管理员运行会弹出UAC授权；仅支持64位单机离线游戏，反作弊大概率拦截</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Refresh">刷新已检测游戏的代理部署状态</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Deploy">四种部署方案第①种（最优方案）：可以重启游戏首选；DLL随游戏启动加载，重启永久生效，全程无需CE。将代理文件部署至勾选的游戏目录</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Undeploy">清理工具部署的全部版本代理文件（version/dinput8/dxgi/winmm）；仅单选框控制部署类型，卸载会全量清理。第三方工具（ReShade、MOD加载器）自带的同名文件会保留并提示，不会删除</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.UpdateAll">将所有已部署游戏的代理更新至最新版本</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Force">强制覆盖文件，版本一致或已存在其他代理时也进行替换</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Type.Version">劫持version.dll：兼容性最强，几乎所有Windows程序都会加载</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Type.Dinput8">劫持dinput8.dll：version.dll与安装程序/防篡改冲突时备选方案</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Type.Dxgi">劫持dxgi.dll：适配D3D11/D3D12虚幻游戏，程序未导入前两个库时选用（绝大多数Windows虚幻游戏首选）</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Type.Winmm">劫持winmm.dll：dxgi、version被占用时备用通用插槽（ReShade普遍占用dxgi，部分游戏自带version.dll）；覆盖范围和dxgi完全一致，兼容性兜底选项</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.SuggestToggle">显示游戏推荐代理列：记录上一次部署的劫持类型，仅注入则标注注入；默认推荐version.dll，同时展示程序可加载的全部劫持库。仅参考提示，不会自动修改选型与部署</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.Source">Steam：扫描Steam商店游戏；全盘扫描：检索选定盘符内非Steam游戏（Epic、GOG、绿色版、手动安装）</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.ScanDrives">扫描选中硬盘分区查找非Steam虚幻游戏；同一块磁盘分区串行扫描，多块物理硬盘并行扫描；跳过Steam库目录与系统文件夹</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.RefreshDrives">重新枚举电脑可用磁盘驱动器</sys:String>
	<sys:String x:Key="str.Tip.ProxyDeploy.CancelScan">终止正在运行的全盘扫描任务</sys:String>

</ResourceDictionary>
