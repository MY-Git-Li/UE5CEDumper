	<sys:String x:Key="str.Pointers.InvokeTimeoutOverrideBadge">自定义超时</sys:String>
	<sys:String x:Key="str.Pointers.InvokeTimeoutOverrideTooltip">当前游戏使用自定义调用超时</sys:String>
