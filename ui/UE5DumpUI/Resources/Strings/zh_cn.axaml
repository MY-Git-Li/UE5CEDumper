	<sys:String x:Key="str.Tools.ExportFreezeHelperLua">导出数值冻结Lua脚本文件…</sys:String>

	<!-- Property Search -->
	<sys:String x:Key="str.PropertySearch.QueryHint">属性名称（示例：Health、Mana、Gold）</sys:String>
	<sys:String x:Key="str.PropertySearch.TypeHint">类型筛选（输入关键词检索，例：opt、weak）</sys:String>
	<sys:String x:Key="str.PropertySearch.ResultFilterLabel">结果筛选：</sys:String>
	<sys:String x:Key="str.PropertySearch.ResultFilterHint">精简当前列表（无需重新检索）</sys:String>
