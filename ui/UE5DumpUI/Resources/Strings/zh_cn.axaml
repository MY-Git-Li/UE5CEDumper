	<sys:String x:Key="str.ProxyDeploy.ConfirmKeptNote">保留不删除：{0}</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ConfirmYes">确认删除</sys:String>
	<sys:String x:Key="str.ProxyDeploy.ConfirmNo">取消</sys:String>
	<!-- 导出菜单 -->
	<sys:String x:Key="str.Toolbar.Options">⚙ 全局选项</sys:String>
	<sys:String x:Key="str.Toolbar.Export">导出功能</sys:String>
	<sys:String x:Key="str.Export.SymbolsX64dbg">x64dbg符号文件</sys:String>
	<sys:String x:Key="str.Export.SymbolsGhidra">Ghidra符号文本</sys:String>
	<sys:String x:Key="str.Export.SymbolsIda">IDA自动脚本</sys:String>
	<sys:String x:Key="str.Export.SdkHeader">C++头文件</sys:String>
	<sys:String x:Key="str.Export.Usmap">USMAP反射文件</sys:String>
	<sys:String x:Key="str.Export.DumpAll">完整元数据JSONL导出</sys:String>
	<sys:String x:Key="str.Tip.Export.DumpAll">导出游戏全部类、属性、函数，用于外部脚本分析，体积较大</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportHeader">导出头文件</sys:String>

	<!-- 主窗口顶部工具栏 提示 -->
	<sys:String x:Key="str.Tip.Connect">通过命名管道连接注入的DLL</sys:String>
	<sys:String x:Key="str.Tip.Disconnect">断开与DLL管道服务端的连接</sys:String>
	<sys:String x:Key="str.Tip.StartScan">触发代理DLL模式下的延迟全局扫描</sys:String>
	<sys:String x:Key="str.Tip.AddressFormat">内存地址展示格式：绝对地址 / 模块相对偏移</sys:String>
	<sys:String x:Key="str.Tip.CollapsePointers">导出CE XML时折叠多层指针链节点</sys:String>
	<sys:String x:Key="str.Tip.ArrayLimit">单行读取数组最大元素数量（2的幂次）</sys:String>
	<sys:String x:Key="str.Tip.DropDownLimit">CE下拉列表最大条目数（2的幂次）</sys:String>
	<sys:String x:Key="str.Tip.StringLength">CE字符串字段展示字符长度（2的幂，范围16-4096），仅作用于复制CE脚本功能。数值足够大不会截断短字符串（CE以空终止符截断），预留空间适配游戏运行中变长字符串。</sys:String>
	<sys:String x:Key="str.Tip.Fabricate">仅复制单字段CE脚本生效：0=关闭。设置数值(2~4096)后，选中顶层数组会自动填充空占位条目，依照元素布局补齐空指针与超出当前长度的索引。仅填充选中数组，不会递归填充内部嵌套数组；仅支持TArray，Map/Set为稀疏结构无法填充。超出游戏当前数组长度的条目会读取尾后内存（无崩溃风险）。数值大于256慎用，会生成超大CE表格，造成CE卡顿或触发表格条目上限。</sys:String>
	<sys:String x:Key="str.Tip.PreviewLimit">数值列展示的结构体子字段数量（0=关闭预览）</sys:String>
	<sys:String x:Key="str.Tip.CsxDepth">指针递归解析深度（0=平铺无层级），CSX导出、CE脚本导出均生效。0~4常规，5~6深层遍历，层级越高导出文件体积指数级增长，UWorld深度6会生成数MB的XML文件。</sys:String>
	<sys:String x:Key="str.Tip.Toolbar.Options">导出格式全局设置：指针折叠、数组/下拉/预览上限、递归深度，会话内永久生效</sys:String>
	<sys:String x:Key="str.Tip.Export">多种格式导出游戏对象内存结构</sys:String>
	<sys:String x:Key="str.Tip.Tools">独立工具集，无需连接游戏DLL即可使用（辅助脚本导出、注入功能等）</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectCeBootstrap">部署方案第三种：为当前打开的CE表格添加一次性注入记录。频繁使用CE推荐自动启动脚本替代。对应四类方案：①代理DLL部署、②运行时注入、③本条临时注入、④独立CT表。会直接在当前表格添加启用/禁用注入记录，一键加载DLL并启动管道通信，无需先打开独立CT文件。勾选后自动轮询DLL就绪状态，固定15秒等待改为实时检测，失败会弹出明确报错。依赖AOBMaker插件，无插件则复制脚本至剪贴手动粘贴。</sys:String>
	<sys:String x:Key="str.Tip.Tools.InstallCeAutorun">将ue5_autorun.lua写入CE自动启动目录，CE打开任意表格都会内置ue5_inject()、ue5_shutdown()函数，主菜单新增快捷入口。唯一无需代理DLL、独立CT、AOB插件的方案，重度CE用户首选。检测到运行中的CE直接写入；未运行则选择保存路径，重启CE生效。迁移程序后需重新安装，脚本内会固化DLL完整路径。</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectCeHelperLua">一键注入核心调用脚本ue5_invoke_helper.lua至当前CE表格，已有文件会覆盖。依赖AOBMaker插件，未安装会降级提示手动导出。</sys:String>
	<sys:String x:Key="str.Tip.Tools.ExportCeHelperLua">导出ue5_invoke_helper.lua文件，可放到CT表同级目录，通过CE菜单添加文件。所有固化AA脚本均依赖此脚本，每张CT仅需配置一次。</sys:String>
	<sys:String x:Key="str.Tip.Tools.InjectFreezeHelperLua">一键注入冻结字段辅助脚本至当前CE表格，属性搜索冻结功能依赖，可与调用辅助脚本共存。</sys:String>


		<!-- 对象树提示 -->
		<sys:String x:Key="str.Tip.ObjectTree.Reload">重新扫描全部游戏对象</sys:String>
		<sys:String x:Key="str.Tip.ObjectTree.Cancel">终止加载扫描</sys:String>
		<sys:String x:Key="str.Tip.ObjectTree.Search">关键词检索对象，空格为与条件</sys:String>
		<sys:String x:Key="str.Tip.ObjectTree.ClassFilter">按类过滤对象列表</sys:String>
		<sys:String x:Key="str.Tip.Collapse">收起对象树，扩大右侧面板</sys:String>
		<sys:String x:Key="str.Tip.Expand">展开对象树</sys:String>
		<sys:String x:Key="str.Tip.ObjectTree.TextFilter">列表快速文本过滤</sys:String>
		<sys:String x:Key="str.Tip.ObjectTree.InstancesOnly">仅显示游戏实体，隐藏反射类模板</sys:String>
		<!-- 实例查找面板提示 -->
		<sys:String x:Key="str.Tip.InstanceFinder.ClassName">要检索的类名，默认模糊匹配；勾选精确匹配则完整名称一致才命中。可与对象名称组合（逻辑与），也可清空类名仅按对象名检索。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.AddressField">反向检索地址，支持十六进制、模块+偏移格式，程序会查找该地址所属UObject或最近容器对象。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.Search">根据类名/对象名检索实例，至少填写一项条件才可执行</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.ObjectName">可选，要求对象名称包含指定文本（大小写不敏感），与类名同时生效为且关系；清空类名可仅按名称检索。过滤逻辑在游戏进程内执行，不会遗漏被其他对象包裹的实例，但列表有最大条数限制，提示截断时请缩小筛选条件。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.ExactMatch">仅类名开启完整精确匹配，不再模糊检索</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.NewestFirst">从最新创建的实例开始遍历（内部索引值最大），能抓到刚生成的怪物等实体，避免结果上限截断新对象；关闭则优先最早生成的实例（蓝图默认模板等）。可点击索引列表头切换排序。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.MaxResults">单次返回实例最大行数，区间100~50000。游戏端会完整遍历所有对象，仅限制前端展示条数；出现截断提示时调高数值，数值越大数据传输与渲染越慢。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.Keyword">对已加载结果做本地临时过滤，空格分隔关键词为且关系，匹配类名/对象名/地址。仅客户端筛选，不会突破最大条数限制；如需找回被截断实例，需在类过滤器屏蔽无用类重新检索，或调高最大条数。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.Lookup">根据输入地址反向查找所属游戏对象</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.CopyAddr">复制当前实例内存地址至剪贴板</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.OpenWalker">在实时结构查看器打开该实例</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.LocateGWorld">GWorld定位：查找从GWorld到该实例最短指针路径，跳转实时查看器并停在父对象层级</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.LocateGWorldContainer">容器GWorld定位：查找GWorld到该数组容器的路径，自动展开容器并定位到目标元素旁</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.LocateGameEngine">GameEngine定位：从引擎根对象查找最短指针路径，可访问GWorld无法遍历的引擎层对象；大世界实体请使用GWorld定位。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.LocateGameEngineContainer">容器引擎定位：从GameEngine根定位容器所属对象，自动展开容器定位目标元素；引擎专属对象适用，世界实体优先GWorld定位。</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.ExportCE">导出该实例完整指针链为CE内存记录XML</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.CopyFieldAddr">复制字段绝对内存地址</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.A">生成CE自动汇编AOB脚本</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.CopyName">复制对象名称到剪贴板</sys:String>
		<sys:String x:Key="str.Tip.InstanceFinder.FindFunc">检索所有入参/返回值为此类的UFunction，包含原生C++函数（区别于单字段字节码交叉引用）</sys:String>

		<!-- 属性搜索面板提示 -->
		<sys:String x:Key="str.Tip.PropertySearch.Query">按属性名模糊检索（大小写不敏感），例如 生命值(Health)、魔力(Mana)、金币(Gold)，可搭配类型筛选缩小范围，回车或点击检索执行。</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.Search">遍历所有类检索属性，名称或类型至少填写一项，多类型使用英文逗号分隔。</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.TypeFilter">限定FProperty属性类型，输入字符筛选下拉建议（输入opt匹配OptionalProperty），多类型逗号分隔为或关系。</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.ResultFilter">本地过滤当前检索结果，匹配类名/属性/类型/父类/预览字段，无需与DLL通信。</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.GameOnly">仅显示游戏自定义类，过滤引擎内置属性</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.Deep">递归检索嵌套结构体、结构体数组（TArray/TSet/TMap）内部字段，可检索存档结构体深层属性；开启后检索速度变慢，匹配项会显示完整层级路径。关闭仅检索对象一级直属字段。</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.FindInstances">跳转实例查找面板，自动填充当前类名并检索全部实时实例</sys:String>
		<sys:String x:Key="str.Tip.PropertySearch.CopyOffset">复制该属性内存偏移至剪贴板</sys:String>

		<!-- 类筛选提示 -->
		<sys:String x:Key="str.Tip.GameClassFilter.Load">加载全部游戏类列表</sys:String>
		<sys:String x:Key="str.Tip.GameClass.GameOnly">仅显示业务游戏类</sys:String>
		<sys:String x:Key="str.Tip.GameClass.Filter">按父类/包名过滤</sys:String>
		<sys:String x:Key="str.Tip.GameClass.Clear">清空筛选条件</sys:String>
		<sys:String x:Key="str.Tip.GameClass.FindInstances">查找该类全部实例</sys:String>
		<sys:String x:Key="str.Tip.GameClass.WalkClass">打开类结构面板查看字段布局</sys:String>
		<sys:String x:Key="str.Tip.GameClass.FindFunc">查找参数/返回值包含此类的函数</sys:String>
		<!-- 实时查看器：函数面板 -->
		<sys:String x:Key="str.LiveWalker.Functions">函数列表</sys:String>
		<sys:String x:Key="str.LiveWalker.FuncGenScript">INV</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FuncGenScript">INV：生成独立CE自动汇编Lua脚本并发送至Cheat Engine（未安装AOBMaker则复制到剪贴板）。通过DLL管道读取游戏实例与目标UFunction，直接调用ProcessEvent，无需额外辅助文件。带输入参数的函数会弹出CE参数输入窗口，返回值默认不展示；在CE Lua控制台设置UE5_DEBUG=1，或修改脚本DEBUG开关，即可打印解析后的返回值并保持Lua窗口。</sys:String>
		<sys:String x:Key="str.LiveWalker.FuncPipeInvoke">PIPE</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FuncPipeInvoke">PIPE：在本软件内直接调用该函数，经由DLL管道执行ProcessEvent，无需依赖Cheat Engine。弹窗填写参数后执行，可直接在界面查看解析后的返回值。适合即时测试；如需分发可复用脚本请使用INV或固化AA功能。</sys:String>
		<sys:String x:Key="str.LiveWalker.FuncCopyBaked">固化AA</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FuncCopyBaked">固化AA：生成参数预填充的CE自动汇编脚本，生成时填入的数值直接写死，启用内存记录就会一次性执行，运行时无需弹窗。体积约为INV脚本的1/5，便于分享。要求CT表嵌入ue5_invoke_helper.lua（可通过工具-导出CE辅助Lua获取）。弹窗勾选“校验返回值”可对比调用前后内存，或设置UE5_DEBUG=1打印返回数据。</sys:String>

		<sys:String x:Key="str.LiveWalker.GuessWhat">自动猜测字段</sys:String>

		<!-- 实时查看器 提示文本 -->
		<sys:String x:Key="str.Tip.LiveWalker.StartWorld">跳转至GWorld并展示顶层游戏对象</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.StartGameEngine">以GameEngine（引擎根对象）作为浏览起点，可逐层查看游戏实例、视口、世界。依靠反射成员定位，而非类名，无法生成AOB锚定脚本，仅支持固定地址记录。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.Back">返回上一个浏览对象，恢复之前选中行与滚动位置。快捷键：Alt+左箭头、鼠标侧键4、浏览器后退键（仅当前标签激活时生效）。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.Forward">前进至后退前的对象，恢复选中项与滚动位置。快捷键：Alt+右箭头、鼠标侧键5、浏览器前进键。前进会重新读取游戏内存；若对象已释放/复用，会清空选中并提示。浏览新对象时清空前进历史，逻辑和浏览器一致。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.Refresh">从内存重新读取当前对象所有字段</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FindRefs">查找所有持有该对象指针的UObject（真正逻辑所有者，Outer/父级仅代表命名层级包结构）</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.AddressInput">输入跳转地址，支持纯十六进制（0x7FF… / 7FF…）、CE模块偏移格式 Game.exe+1A2B3C，带引号格式"Game.exe"+1A2B也可自动去除引号，支持带空格模块名，输入回车或点击跳转。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.Go">跳转到输入的内存地址</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FieldInst">在实例查找器打开该字段对应类，自动填充类名并检索所有实例</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportCE">将完整指针链复制为CE内存记录XML到剪贴板</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportCEField">仅导出选中字段为CE XML，Ctrl/Shift多选批量导出</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CancelExport">终止正在执行的导出（复制CE脚本/导出CSX），剪贴板与文件不会生成内容</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.AobToggle">启用AOB特征码锚定GWorld，不用固定地址，游戏重启后记录仍有效</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportOptions">CE导出设置：内存记录描述格式、偏移/类型后缀开关、AOB锚定、指针链折叠、原生字段猜测选项</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.DescShowOffset">CE记录名称末尾追加十六进制字段偏移，例如 AbilitySystemComponent (7E0)；关闭则只显示字段名</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.DescShowType">CE记录末尾追加类/结构体类型，例如 AbilitySystemComponent (LSAbilitySystem)；折叠指针链时不会附加类型，关闭仅显示名称</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.DedupShared">去重共享对象：同一个实体被多处引用时仅完整展开一次，后续仅显示(共享)指针。避免遍历世界等高密度对象时导出数据爆炸、内存溢出；关闭则每条引用完整展开，深度过高文件极大。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExcludeSysComponents">默认开启，遍历导出时跳过UI、贴图、粒子、动画等引擎系统类，只保留游戏业务数据。手动选中字段不会过滤，仅自动遍历子对象生效。Actor/角色/控制器等游戏实体永远保留；数组元素不做过滤。过滤时底部提示隐藏系统字段数量；关闭则导出全部字段。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CollapseChain">多层GWorld指针链合并为单条CE多级指针记录，仅保留基址、合并路径与目标字段，仅作用于完整/单字段导出功能</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FlattenGas">扁平化GAS属性结构体，HP/MP这类属性原本会拆分为父节点+BaseValue/CurrentValue子项；开启后合并为同级条目 生命值 ▸ 基础值，层级更少更易编辑。仅对GameplayAttributeData生效，其他结构体保持嵌套。关闭恢复分组结构。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FlattenLeafStruct">扁平化所有基础原生结构体，是GAS扁平化的扩展。仅由数字、布尔、枚举构成的结构体（坐标、旋转、数值区间）会拆分为同级条目；结构体内部包含对象、字符串、数组时保持嵌套。关闭恢复分组结构。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.FlattenLeafRecords">扁平化带名字符串的存储结构体，在基础结构体扁平化之上支持FName/FString文本字段。存档类结构体可全部平铺展示，数组内每条记录独立展开；包含对象/文本容器的结构体不扁平化。关闭恢复分组结构。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.RecordColors">记录配色设置面板，数组每条记录奇偶行区分颜色，CE导出后易区分条目；支持自定义十六进制色值或重置默认配色，设置自动保存。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CollapseLeafPointers">单值指针折叠：指针目标仅单个数字/名字/字符串时直接合并为 指针 ▸ 数值 单条记录，不生成文件夹；目标存在多个字段则保留分组。关闭恢复嵌套文件夹结构。</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportCsx">导出CE结构体解析脚本(.csx)，可选择对应CE版本格式</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportCsxPre77">兼容CE7.7旧版格式：位域布尔整体存为字节，描述标注比特位，无独立位切换控件</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportCsx77">CE7.7及以上新版：原生二进制位域，CE内可直接开关比特</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.ExportHeader">导出C++结构体头文件(.h)</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CeAA">生成CE自动汇编脚本，以GWorld为根的记录支持重启稳定锚定；非GWorld路径仅固定地址，重启失效</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.GuessWhat">自动填充未知内存间隙，猜测指针、数字等基础数据类型</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CopyFieldAddr">复制当前字段绝对内存地址</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.CopyFieldName">复制字段名称到剪贴板</sys:String>
		<sys:String x:Key="str.Tip.LiveWalker.Search">按名称检索高亮字段，检索记录最多保存8条，切换对象清空，切换标签页保留检索词</sys:String>

		<!-- 系统指针面板 提示 -->
		<sys:String x:Key="str.Tip.Pointers.Copy">复制地址到剪贴板</sys:String>
		<sys:String x:Key="str.Tip.Pointers.CopyScan">复制AOB特征码匹配地址</sys:String>
		<sys:String x:Key="str.Tip.Pointers.ExtraScan">执行深度兜底扫描，尝试读取未识别全局指针</sys:String>
		<sys:String x:Key="str.Tip.Pointers.TestExtraScan">模拟扫描界面，仅开发调试使用，不读取真实内存</sys:String>
		<sys:String x:Key="str.Tip.Pointers.ClearGameCache">清空当前游戏缓存特征码，下次完整扫描全部模式</sys:String>
		<sys:String x:Key="str.Tip.Pointers.ResetAllCache">全部缓存文件重命名备份，重新生成扫描缓存</sys:String>

		<!-- 代理部署面板 提示 -->
		<sys:String x:Key="str.Tip.ProxyDeploy.Scan">扫描Steam库内虚幻游戏</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Inject">方案2：游戏已运行时临时注入DLL，无需部署代理，重启失效。通过远程线程注入UE5Dumper，仅单机离线可用，反作弊可能拦截。需要管理员权限会弹出UAC授权弹窗。</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Refresh">刷新游戏部署状态列表</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Deploy">方案1（推荐）：部署代理DLL，游戏启动自动加载，重启永久生效，无需CE。将选中代理写入勾选游戏目录</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Undeploy">卸载本工具所有代理文件，其他MOD/工具的dll不会删除。仅清理当前工具部署的文件</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.UpdateAll">批量更新所有已部署游戏的代理至最新版本</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Force">强制覆盖现有同版本或第三方同名文件</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Type.Version">劫持version.dll，兼容性最广，几乎所有Windows程序都会加载</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Type.Dinput8">劫持dinput8.dll，version冲突时备选方案</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Type.Dxgi">劫持dxgi.dll，适用于D3D11/12虚幻游戏，绝大多数UE程序导入该库</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Type.Winmm">劫持winmm.dll，dxgi被ReShade占用时备用通用插槽，全部虚幻游戏均可加载</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.SuggestToggle">显示推荐代理列，记录你上次部署的类型；从未部署默认version.dll，仅参考不自动修改你的选择</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.Source">Steam：仅扫描Steam游戏；全盘：扫描本地磁盘所有虚幻游戏（Epic/手动安装等）</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.ScanDrives">扫描选中磁盘分区，单硬盘顺序扫描，多硬盘并行，跳过系统目录与Steam库</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.RefreshDrives">重新读取本机可用磁盘列表</sys:String>
		<sys:String x:Key="str.Tip.ProxyDeploy.CancelScan">终止正在执行的全盘扫描</sys:String>
	</ResourceDictionary>
