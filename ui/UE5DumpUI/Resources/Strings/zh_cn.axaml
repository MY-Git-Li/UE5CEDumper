    <!-- Live Walker -->
	<sys:String x:Key="str.LiveWalker.StartWorld">从GWorld开始</sys:String>
	<sys:String x:Key="str.LiveWalker.StartGameEngine">从GameEngine开始</sys:String>
	<sys:String x:Key="str.LiveWalker.Back">后退</sys:String>
	<sys:String x:Key="str.LiveWalker.Forward">前进</sys:String>
	<sys:String x:Key="str.LiveWalker.Parent">上级 ↑</sys:String>
	<sys:String x:Key="str.LiveWalker.FindRefs">查找引用</sys:String>
	<sys:String x:Key="str.LiveWalker.Refresh">刷新</sys:String>
	<sys:String x:Key="str.LiveWalker.AddressHint">地址（十六进制 / 程序名+偏移）</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.GWorldDepth">使用GWorld定位时向下遍历指针的最大层数（默认7），数值越大能找到深层对象，但检索速度越慢。</sys:String>
	<sys:String x:Key="str.Toolbar.GWorldDepth">GWorld定位深度</sys:String>
	<sys:String x:Key="str.Toolbar.GWorldDeep">深层容器遍历</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.GWorldDeep">GWorld深层定位开关，默认关闭，功能等同于数值搜索的深度遍历。开启后检索路径会进入结构体数组、映射内部的对象指针（例如Inventory[3].ItemActor），可以定位常规路径找不到的实体；也能把深层容器内的数值归属到所属对象而非检索失败。代价更高，每个数组元素都会读取内存。</sys:String>
	<sys:String x:Key="str.Toolbar.DeepScanElemCap">深层容器遍历上限</sys:String>
	<sys:String x:Key="str.Tip.Toolbar.DeepScanElemCap">实例反向检索的递归遍历单容器最大元素数，浅层查找无果时才会递归扫描。数值越高能读取下标更大的元素，但速度变慢，默认256。</sys:String>
	<sys:String x:Key="str.LiveWalker.Go">跳转</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportCE">复制CE XML</sys:String>
	<sys:String x:Key="str.LiveWalker.CancelExport">取消导出</sys:String>
	<sys:String x:Key="str.LiveWalker.AobToggle">AOB锚定</sys:String>
	<sys:String x:Key="str.LiveWalker.CollapseChain">折叠指针链</sys:String>
	<sys:String x:Key="str.LiveWalker.FlattenGas">扁平化GAS属性</sys:String>
	<sys:String x:Key="str.LiveWalker.FlattenLeafStructs">扁平化基础结构体</sys:String>
	<sys:String x:Key="str.LiveWalker.FlattenLeafRecords">扁平化文本记录结构体</sys:String>
	<sys:String x:Key="str.LiveWalker.RecordColors">记录配色设置…</sys:String>
	<sys:String x:Key="str.LiveWalker.CollapseLeafPointers">折叠单值指针</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportOptions">导出选项</sys:String>
	<sys:String x:Key="str.LiveWalker.DedupShared">共享对象去重</sys:String>
	<sys:String x:Key="str.LiveWalker.ExcludeSysComponents">排除系统组件</sys:String>
	<sys:String x:Key="str.LiveWalker.DescShowOffset">附加偏移</sys:String>
	<sys:String x:Key="str.LiveWalker.DescShowType">附加类型</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportCsx">导出CSX</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportCsxPre77">CSX — CE7.7旧版</sys:String>
	<sys:String x:Key="str.LiveWalker.ExportCsx77">CSX — CE7.7及新版</sys:String>
	<sys:String x:Key="str.LiveWalker.Value">数值</sys:String>
	<sys:String x:Key="str.LiveWalker.CopyAddress">复制地址</sys:String>
	<sys:String x:Key="str.LiveWalker.CopyName">复制名称</sys:String>
	<sys:String x:Key="str.LiveWalker.CopyClass">复制类名</sys:String>
	<sys:String x:Key="str.LiveWalker.CeAAShort">AA</sys:String>
	<sys:String x:Key="str.LiveWalker.PtrValue">[指针]</sys:String>
	<sys:String x:Key="str.LiveWalker.CopyPtr">复制指针</sys:String>
	<sys:String x:Key="str.LiveWalker.AutoRefresh">自动刷新</sys:String>
	<sys:String x:Key="str.LiveWalker.HexFieldTip">跳转CE十六进制视图至当前字段（依赖AOBMaker插件）</sys:String>
	<sys:String x:Key="str.LiveWalker.HexPtrTip">跳转指针目标CE十六进制视图（依赖AOBMaker插件）</sys:String>
	<sys:String x:Key="str.LiveWalker.HexObjectTip">跳转当前对象CE十六进制视图（依赖AOBMaker插件）</sys:String>
	<sys:String x:Key="str.LiveWalker.HexOuterTip">跳转外层对象CE十六进制视图（依赖AOBMaker插件）"</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CopyClass">将类名复制到剪贴板</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CopyOuterName">复制外层对象名称</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.CopyOuterClass">复制外层类名</sys:String>
	<sys:String x:Key="str.LiveWalker.AddToCe">+CE</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.AddFieldToCe">将此字段以带名称的结构化记录添加至CE地址列表，需2026-06-07及以后版本AOBMaker插件才能跳转十六进制窗口。</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.AddPtrToCe">把指针目标作为8字节十六进制记录添加到CE（AOBMaker插件）</sys:String>
	<sys:String x:Key="str.LiveWalker.PushCeField">批量添加CE字段(平铺)</sys:String>
	<sys:String x:Key="str.Tip.LiveWalker.PushCeField">多选字段批量生成CE结构化记录；如需分层指针链请使用复制CE XML功能。</sys:String>

