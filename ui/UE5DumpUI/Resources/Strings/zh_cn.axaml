	<sys:String x:Key="str.PropertySearch.CopyOffset">复制内存偏移</sys:String>
	<sys:String x:Key="str.PropertySearch.Freeze">冻结数值</sys:String>

	<!-- Force field (Solide) — hold a discovered field across live instances -->
	<sys:String x:Key="str.PropertySearch.ForceMenu">强制锁定字段（所有实例统一管控）</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceOn">开启强制锁定</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceOff">关闭强制锁定</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceNull">强制置空(null)</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceValue">自定义强制数值…</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedHeader">已锁定字段列表：</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedClearAll">清空全部锁定</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedClearAll">解除所有字段锁定，尽力恢复字段原始捕获基准值</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedRemove">取消本条锁定，恢复初始数值并停止持续改写</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedCapped">⚠ 已达上限</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedCapped">实例池数量抵达DLL预设上限，当前锁定数为下限值；该类仍存在更多运行实例并未被锁定。遍历顺序依照GObjects升序排列，最晚生成的实例会被舍弃</sys:String>

	<!-- Game Class Filter -->
	<sys:String x:Key="str.GameClassFilter.Load">加载类数据</sys:String>
	<sys:String x:Key="str.GameClassFilter.GameOnly">仅游戏自定义类</sys:String>
