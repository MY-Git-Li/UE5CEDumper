	<sys:String x:Key="str.TP.LocateVel">🌍 定位速度字段</sys:String>
	<sys:String x:Key="str.TP.LocateAccel">🌍 定位加速度字段</sys:String>
	<sys:String x:Key="str.TP.LocateSpeed">🌍 定位速率</sys:String>
