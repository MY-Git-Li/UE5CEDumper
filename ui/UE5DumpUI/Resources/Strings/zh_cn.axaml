	<sys:String x:Key="str.System.Header">诊断信息</sys:String>
    <sys:String x:Key="str.System.UiBuild">UI编译版本</sys:String>
    <sys:String x:Key="str.System.DllBuild">注入DLL版本</sys:String>
    <sys:String x:Key="str.System.BuildMatch">✓ 版本匹配</sys:String>
    <sys:String x:Key="str.System.BuildMismatch">⚠ DLL版本过旧，请关闭游戏后前往代理部署页面重新部署</sys:String>
    <sys:String x:Key="str.System.BuildUnknown">⚠ 无法读取DLL版本号，判定为旧版</sys:String>
