	<sys:String x:Key="str.Tools.ExportCeHelperLua">Export CE Helper Lua File...</sys:String>
	<sys:String x:Key="str.Tools.InjectFreezeHelperLua">Inject Freeze Helper into Current CE Table</sys:String>
	<sys:String x:Key="str.Tools.ExportFreezeHelperLua">Export Freeze Helper Lua File...</sys:String>

	<!-- Property Search -->
	<sys:String x:Key="str.PropertySearch.QueryHint">Property name (e.g. Health, Mana, Gold)</sys:String>
	<sys:String x:Key="str.PropertySearch.TypeHint">Type filter (start typing — e.g. opt, weak)</sys:String>
	<sys:String x:Key="str.PropertySearch.ResultFilterLabel">Filter results:</sys:String>
	<sys:String x:Key="str.PropertySearch.ResultFilterHint">Refine current results (no re-query)</sys:String>
	<sys:String x:Key="str.PropertySearch.Search">Search</sys:String>
	<sys:String x:Key="str.PropertySearch.GameOnly">Game classes only</sys:String>
	<sys:String x:Key="str.PropertySearch.Deep">Deep (structs/containers)</sys:String>
	<sys:String x:Key="str.PropertySearch.FindInstances">finder</sys:String>
	<sys:String x:Key="str.PropertySearch.CopyOffset">Copy Offset</sys:String>
	<sys:String x:Key="str.PropertySearch.Freeze">Freeze</sys:String>
	<!-- Force field (Solide) — hold a discovered field across live instances -->
	<sys:String x:Key="str.PropertySearch.ForceMenu">Force field (hold across instances)</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceOn">Force ON</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceOff">Force OFF</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceNull">Force → null</sys:String>
	<sys:String x:Key="str.PropertySearch.ForceValue">Force value…</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedHeader">Forced fields:</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedClearAll">Clear all</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedClearAll">Release every forced-field hold (best-effort restore each field's captured base).</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedRemove">Release this hold (restore the captured base) and stop re-asserting it.</sys:String>
	<sys:String x:Key="str.PropertySearch.ForcedCapped">⚠ capped</sys:String>
	<sys:String x:Key="str.Tip.PropertySearch.ForcedCapped">The instance pool hit the DLL's cap, so the held count is a FLOOR — more live instances of this class exist and are NOT being held. The pool is walked in ascending GObjects order, so the ones dropped are the most recently spawned.</sys:String>

	<!-- Game Class Filter -->
	<sys:String x:Key="str.GameClassFilter.Load">Load</sys:String>
	<sys:String x:Key="str.GameClassFilter.GameOnly">Game classes only</sys:String>
	<sys:String x:Key="str.GameClassFilter.FilterHint">Filter by name...</sys:String>
	<sys:String x:Key="str.GameClassFilter.FindInstances">inst</sys:String>
	<sys:String x:Key="str.GameClassFilter.WalkClass">Walk Class</sys:String>
	<sys:String x:Key="str.GameClassFilter.FindFunc">Find Func</sys:String>
	<sys:String x:Key="str.GameClassFilter.SuperLabel">Super:</sys:String>
	<sys:String x:Key="str.GameClassFilter.SuperHint">(All)</sys:String>
	<sys:String x:Key="str.GameClassFilter.PackageLabel">Package:</sys:String>
