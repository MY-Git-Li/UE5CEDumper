    <sys:String x:Key="str.Credit.AuthorUrl">https://opencheattables.com</sys:String>
    <sys:String x:Key="str.Credit.RepoPrefix">Repository: </sys:String>
    <sys:String x:Key="str.Credit.RepoUrl">https://github.com/bbfox0703/UE5CEDumper</sys:String>
    <sys:String x:Key="str.Credit.OpenInBrowserTip">Open in default browser</sys:String>

    <!-- Experimental features gate (System-tab credit checkbox) -->
    <sys:String x:Key="str.Experimental.EnableHint">Enable advanced experimental features</sys:String>

    <!-- Snapshot tab (experimental — Phase A) -->
    <sys:String x:Key="str.Snapshot.Intro">捕获指定范围内所有对象的数字UPROPERTY字段并持久化保存为快照。快照可用于序列查询、类数据透视功能。开启原生C选项可一并捕获无反射原生内存数值。</sys:String>
    <sys:String x:Key="str.Snapshot.NativeC">原生C原始内存</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.NativeC">可选功能，默认关闭。除反射属性外，将对象无托管原始内存区块生成虚拟字段，通过数据猜测算法解析为标准数字类型，指针/填充字节会过滤掉。开启后序列查询、数据透视可识别血量这类无反射原生数值。捕获速度变慢、快照体积更大；原始字段依靠偏移匹配快照，极少情况下字段类型识别变化会导致跨快照匹配失败。</sys:String>
    <sys:String x:Key="str.Snapshot.CaptureHeader">捕获快照</sys:String>
    <sys:String x:Key="str.Snapshot.CompareHeader">快照对比</sys:String>
    <sys:String x:Key="str.Snapshot.NotConnected">请先连接游戏进程再捕获快照</sys:String>
    <sys:String x:Key="str.Snapshot.Scope">捕获范围：</sys:String>
    <sys:String x:Key="str.Snapshot.Family">数值类型：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Family">在捕获范围基础上进一步筛选数值。全部数字：捕获所有数字类型；仅整数：只保留各类整型，剔除浮点；仅浮点：只保留单/双精度浮点。属于源头过滤，可大幅缩小快照体积；仅查坐标/血量选浮点，计数/ID选整数。该筛选会丢失另一类数据，如需切换需重新捕获。</sys:String>
    <sys:String x:Key="str.Snapshot.MaxDataset">快照最大容量：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.MaxDataset">捕获过程上限开关，到达上限会停止并保留不完整快照。关闭则无限制。与单游戏配额区分：配额是捕获完成后自动删除旧快照，无法限制单次超大捕获；大型游戏建议开启上限并先预估体积。</sys:String>
    <sys:String x:Key="str.Snapshot.Estimate">预估占用</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Estimate">预检测功能，抽样遍历部分对象，按当前配置推算完整快照磁盘占用，不会写入数据库。超大游戏捕获前可先预估，避免生成数GB文件。</sys:String>
    <sys:String x:Key="str.Snapshot.GameOnly">仅游戏自定义对象</sys:String>
    <sys:String x:Key="str.Snapshot.AutoSkipNoise">自动过滤引擎冗余对象</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.AutoSkipNoise">默认开启，捕获源头直接过滤UI、贴图、粒子、动画等引擎内置类，快照更小、捕获更快。过滤不可逆，关闭后重新捕获才能找回引擎类数据。角色、组件、控制器等游戏实体强制保留，坐标、GAS血量不会被过滤。数值搜索、实例查找共用这套过滤逻辑。</sys:String>
    <sys:String x:Key="str.Snapshot.Label">标签：</sys:String>
    <sys:String x:Key="str.Snapshot.LabelWatermark">选填，留空默认时间戳</sys:String>
    <sys:String x:Key="str.Snapshot.Capture">开始捕获</sys:String>
    <sys:String x:Key="str.Snapshot.Cancel">取消</sys:String>
    <sys:String x:Key="str.Snapshot.Refresh">刷新快照列表</sys:String>
    <sys:String x:Key="str.Snapshot.Delete">删除选中快照</sys:String>
    <sys:String x:Key="str.Snapshot.DeleteAll">删除全部快照</sys:String>
    <sys:String x:Key="str.Snapshot.DeleteAllTip">清空当前游戏所有快照数据库并回收磁盘空间，操作不可逆。</sys:String>
    <sys:String x:Key="str.Snapshot.OpenDbFolder">打开数据库目录</sys:String>
    <sys:String x:Key="str.Snapshot.OpenDbFolderTip">打开当前游戏快照数据库文件夹，21天未连接的游戏会在程序启动时自动删除对应库文件。</sys:String>
    <sys:String x:Key="str.Snapshot.Quota">单游戏存储配额：</sys:String>
    <sys:String x:Key="str.Snapshot.QuotaHint">捕获后若超出配额，自动删除该游戏最早的快照释放空间。</sys:String>
    <sys:String x:Key="str.Snapshot.Usage">已占用：</sys:String>
	
    <!-- Free-disk-space guard (blocks ALL captures) -->
    <sys:String x:Key="str.Snapshot.MinFreeDisk">磁盘最低剩余空间：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.MinFreeDisk">磁盘空间安全阈值。所有快照捕获（手动/自动）执行前，都会校验快照所在磁盘剩余空间，不足则直接终止捕获。
系统会取两项规则里数值更小的一项作为判定标准：磁盘总容量百分比 或是 固定GB下限。
示例：1TB硬盘设置10%+50GB → 最低预留50GB；200GB硬盘设置10%+50GB → 最低预留20GB。
将百分比设为0，即可仅使用固定GB数值作为唯一判定依据。</sys:String>

	
    <!-- Auto snapshot (periodic capture) -->
    <sys:String x:Key="str.Snapshot.Auto.Header">自动快照</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.On">开启</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Off">关闭</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Interval">间隔(秒)：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.Interval">两次自动快照**起始时刻**的目标间隔（默认900秒=15分钟，最小60秒）。若单次捕获耗时超过设定间隔，系统会自动顺延；两次快照结束与开始之间至少预留60秒空闲缓冲，给游戏留出运行余量。自动快照不会压低扫描线程优先级，避免游戏繁忙时捕获进程被抢占停滞。</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Retention">留存规则：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.Retention">
保留最新：持续循环捕获，仅留存最新N份快照，旧快照自动清理；
固定次数：本次会话仅捕获N次后停止，全部快照都会保留，同时仍受单游戏存储配额限制。
</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Count">数量(N)：</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.AdjustQuota">自动扩容配额</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Auto.AdjustQuota">默认关闭：总占用严格遵循单游戏配额；若配额仅够存放一份快照、无法满足你设定的留存数量，自动快照将会暂停。
开启后：当现有配额不足以容纳所需快照数量时，会逐级上调预设配额上限（最高无限制）；磁盘剩余空间限制始终为硬性最高门槛。</sys:String>
    <sys:String x:Key="str.Snapshot.Auto.Hint">无人值守定时抓取快照。此开关需要手动开启，连接游戏、重启软件均不会自动启动；仅配置参数会被保存。正在执行的自动快照可点击取消终止。</sys:String>
    <sys:String x:Key="str.Snapshot.Saved">已保存快照列表</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Size">预估大小</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Label">标签</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Captured">捕获时间(世界标准时间)</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Objects">对象总数</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Fields">字段总数</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Scope">捕获范围</sys:String>
    <sys:String x:Key="str.Snapshot.Col.Ue">引擎版本</sys:String>
	
    <!-- Snapshot diff -->
    <sys:String x:Key="str.Snapshot.Diff.Old">旧快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.New">新快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Run">开始对比</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.DeepNote">对比默认开启深层遍历</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.DeepNote">快照差异对比会自动检测嵌套数组、结构体数组内部元素变动（例如 SupportActionGauge[3]，展示格式为 Array[N]），无需额外开启深度选项。深度开关仅存在于分组模式中，用于将数组成员纳入分组匹配范围。</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ClassFilter">类筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.PropFilter">字段筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Dir">变动类型：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.CopyAddr">复制地址</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.OpenWalker">实时查看</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.LocateGWorld">🌍</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.LocateGWorld">GWorld定位：检索从GWorld到当前归属对象的最短指针链路，在实时浏览器打开并跳转至变动字段；仅支持本次游戏会话内的快照对比</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.LocateGameEngine">⚙</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Diff.LocateGameEngine">GameEngine定位：检索从运行中的UGameEngine到归属对象的最短指针路径，跳转至变动字段；可定位GWorld无法触及的引擎层级对象，绝大多数场景实体推荐使用GWorld定位</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ObjectFilter">对象筛选：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Global">全局检索：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.GlobalHint">匹配任意列内容...</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.OldRange">旧值区间：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.NewRange">新值区间：</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ApplyRange">应用区间</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.ResetRange">重置</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Hint">快照对比依靠对象唯一标识匹配数据，仅限同一次游戏进程启动内的两份快照进行比对。</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Change">变动</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Class">所属类</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Object">对象</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Field">字段</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.Old">原值</sys:String>
    <sys:String x:Key="str.Snapshot.Diff.Col.New">新值</sys:String>


    <!-- Snapshot Group Match (Multiple Values over a captured snapshot) -->
    <sys:String x:Key="str.Snapshot.Group.ModeLabel">模式：</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ModeDiff">差异对比</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ModeGroup">多值联合检索</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Snapshot">快照：</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Find">开始检索</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Clear">清空列表</sys:String>
    <sys:String x:Key="str.Snapshot.Group.AddRow">+ 添加数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.RemoveRow">− 移除数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Deep">深度检索（嵌套容器）</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.Deep">可匹配嵌套结构体、数组内部数值（例如深层嵌套 SaveSlotList[1]…Tunes[2]），归属至外层父对象。血量、属性存放在数组/容器内时需要开启；关闭仅检索一级直属字段，速度更快、冗余数据更少。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.ValueHint">数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Value2Hint">至</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CompareWith">参照快照：</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.CompareWith">选择一份较早快照作为对比基准，即可启用相对判定条件：数值变动/未变动、上升、下降。例：查找当前血量下降、最大血量保持不变的玩家对象。留空则仅在单快照内进行固定数值匹配。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CompareClear">✕</sys:String>
    <sys:String x:Key="str.Tip.Snapshot.Group.CompareClear">清空参照快照，切换回单快照固定数值检索模式。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Hint">检索同时包含2~4组指定数值、且存储在不同内存偏移的游戏对象。参照快照留空：单快照绝对值匹配；选定旧快照：跨时间状态比对，支持血量下降、上限不变这类组合条件。</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Class">所属类</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Object">对象实例</sys:String>
    <sys:String x:Key="str.Snapshot.Group.Col.Matched">匹配数值</sys:String>
    <sys:String x:Key="str.Snapshot.Group.OpenWalker">实时查看</sys:String>
    <sys:String x:Key="str.Snapshot.Group.CopyAddr">复制地址</sys:String>
    <sys:String x:Key="str.Snapshot.Group.LocateGWorld">🌍</sys:String>
    <sys:String x:Key="str.Snapshot.Group.LocateGameEngine">⚙</sys:String>

	<!-- SPC Query (experimental) -->
	<sys:String x:Key="str.Spc.Intro">Find fields whose value SEQUENCE across snapshots matches a direction chain — no type, no value. Pick two or more snapshots (they may span game sessions), set how each should compare to the previous one (Increased / Decreased / Unchanged / Changed), and run. This is CE's "Unknown Initial Value + Increased/Decreased" generalised across persisted snapshots and restarts.</sys:String>
	<sys:String x:Key="str.Spc.Join">Join:</sys:String>
	<sys:String x:Key="str.Spc.JoinHint">Strict = same class + normalised path + offset (fewest false positives). Loose = class + outer chain + name (recovers some spawned objects across sessions). In-session = same game launch only (exact).</sys:String>
	<sys:String x:Key="str.Spc.ClassFilter">Class:</sys:String>
	<sys:String x:Key="str.Spc.PropFilter">Field:</sys:String>
	<sys:String x:Key="str.Spc.ResClass">Class:</sys:String>
	<sys:String x:Key="str.Spc.ResField">Field:</sys:String>
	<sys:String x:Key="str.Spc.ResObject">Object:</sys:String>
	<sys:String x:Key="str.Spc.ResGlobal">Filter all:</sys:String>
	<sys:String x:Key="str.Spc.ResGlobalHint">match any column…</sys:String>
	<sys:String x:Key="str.Spc.SeqFirst">First:</sys:String>
	<sys:String x:Key="str.Spc.SeqLast">Last:</sys:String>
	<sys:String x:Key="str.Spc.ApplyRange">Apply range</sys:String>
	<sys:String x:Key="str.Spc.ResetRange">Reset</sys:String>
	<sys:String x:Key="str.Spc.Run">Run SPC</sys:String>
	<sys:String x:Key="str.Spc.Refresh">Refresh</sys:String>
	<sys:String x:Key="str.Spc.OpenWalker">Live</sys:String>
	<sys:String x:Key="str.Spc.LocateGWorld">🌍</sys:String>
	<sys:String x:Key="str.Tip.Spc.LocateGWorld">Locate in GWorld: find the shortest pointer path from GWorld down to this row's owning object and show it in Live Walker, scrolled to the changed field</sys:String>
	<sys:String x:Key="str.Spc.LocateGameEngine">⚙</sys:String>
	<sys:String x:Key="str.Tip.Spc.LocateGameEngine">Locate in GameEngine: shortest pointer path from the live UGameEngine down to this row's owning object, shown in Live Walker scrolled to the changed field. Reaches engine-layer objects the GWorld graph can't — for most world actors, use Locate in GWorld.</sys:String>
	<sys:String x:Key="str.Spc.CopyAddr">Addr</sys:String>
	<sys:String x:Key="str.Spc.PickerHeader">Snapshot sequence</sys:String>
	<sys:String x:Key="str.Spc.BaselineHint">The oldest ticked snapshot is the baseline (its predicate is ignored). Each later snapshot's predicate compares it to the previous ticked one. Hit → Copy Address / Open in Live Walker hands the newest snapshot's live address to CE.</sys:String>
	<sys:String x:Key="str.Spc.Col.Use">Use</sys:String>
	<sys:String x:Key="str.Spc.Col.Label">Label</sys:String>
	<sys:String x:Key="str.Spc.Col.Captured">Captured (UTC)</sys:String>
	<sys:String x:Key="str.Spc.Col.Session">Session</sys:String>
	<sys:String x:Key="str.Spc.Col.Predicate">Compare</sys:String>
	<sys:String x:Key="str.Spc.Col.ValueFilter">Value filter</sys:String>
	<sys:String x:Key="str.Spc.Col.Preview">Matches</sys:String>
	<sys:String x:Key="str.Spc.Res.Class">Class</sys:String>
	<sys:String x:Key="str.Spc.Res.Object">Object</sys:String>
	<sys:String x:Key="str.Spc.Res.Field">Field</sys:String>
	<sys:String x:Key="str.Spc.Res.Type">Type</sys:String>
	<sys:String x:Key="str.Spc.Res.Sequence">Value sequence</sys:String>

	<!-- SPC GROUP (multiple values) — Single/Group toggle + matrix editor -->
	<sys:String x:Key="str.Spc.Group.ModeLabel">Mode:</sys:String>
	<sys:String x:Key="str.Spc.Group.ModeSingle">Single field</sys:String>
	<sys:String x:Key="str.Spc.Group.ModeGroup">Group (Multiple Values)</sys:String>
	<sys:String x:Key="str.Spc.Group.Intro">Find OBJECTS holding ALL of 2–4 fields at distinct offsets, where EACH field follows its own direction chain across the snapshots (e.g. Current HP: ·→↓→↑ while Max HP: ·→=→= over [full, damaged, healed]). Tick the snapshots above, pick a value with the selector, then set that value's Compare + Value filter down the snapshot rows. Repeat per value. Run finds objects where every value's chain holds at the same time.</sys:String>
	<sys:String x:Key="str.Spc.Group.Run">Find group</sys:String>
	<sys:String x:Key="str.Spc.Group.Clear">Clear</sys:String>
	<sys:String x:Key="str.Spc.Group.AddSlot">+ value</sys:String>
	<sys:String x:Key="str.Spc.Group.RemoveSlot">− value</sys:String>
	<sys:String x:Key="str.Spc.Group.Editing">Editing:</sys:String>
	<sys:String x:Key="str.Spc.Group.EditingHint">Pick which value's chain the snapshot grid below edits. Each value also has its own width scope.</sys:String>
	<sys:String x:Key="str.Spc.Group.SlotsHeader">Values (width scope per value):</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Class">Class</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Object">Object</sys:String>
	<sys:String x:Key="str.Spc.Group.Col.Matched">Matched values</sys:String>
