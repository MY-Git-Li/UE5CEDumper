    <sys:String x:Key="str.System.AobMakerConnected">● 已连接</sys:String>
    <sys:String x:Key="str.System.AobMakerOffline">○ 未检测到，请检查CE插件安装</sys:String>
    
	<!-- Always-visible top-toolbar mirror of the System-tab AOBMaker indicator -->
	<sys:String x:Key="str.Toolbar.AobMakerLabel">AOBMaker插件</sys:String>
    <sys:String x:Key="str.Toolbar.AobMakerConnected">已连接</sys:String>
    <sys:String x:Key="str.Toolbar.AobMakerOffline">离线</sys:String>
    <sys:String x:Key="str.Toolbar.AobMakerRefresh">⟳</sys:String>
    <sys:String x:Key="str.Tip.Toolbar.AobMakerRefresh">重新检测Cheat Engine是否加载AOBMaker插件，各类功能按钮使用时也会自动检测，此按钮仅用于快速查看状态。</sys:String>
    <sys:String x:Key="str.System.SelfTest.Button">运行自检</sys:String>
    <sys:String x:Key="str.System.SelfTest.Hint">自动选取蓝图数学库静态原生函数快速调用，校验返回值，确认ProcessEvent钩子挂载至正确虚表槽位。</sys:String>
    <sys:String x:Key="str.System.SelfTest.Running">正在检索蓝图数学库测试函数...</sys:String>
    <sys:String x:Key="str.System.SelfTest.NoCandidate">当前游戏未找到可用于自检的蓝图工具函数库</sys:String>
    <sys:String x:Key="str.System.SelfTest.Error">自检失败：{0}</sys:String>

    <!-- System tab: Pipe Activity (live tail of UI<->DLL pipe traffic) -->
    <sys:String x:Key="str.System.PipeLog.Header">管道通信日志</sys:String>
    <sys:String x:Key="str.System.PipeLog.Hint">实时查看UI与DLL之间的管道通信记录，最新消息置顶。列信息：时间 · 通道(I交互通道 / B批量通道) · 流向(→发送，←带往返耗时的返回，⚡推送事件) · 指令 · 标识。相当于管道日志文件的实时视图，可观察大量扫描在批量通道执行时，交互指令仍保持响应。</sys:String>
    <sys:String x:Key="str.System.PipeLog.Pause">暂停</sys:String>
    <sys:String x:Key="str.System.PipeLog.Clear">清空</sys:String>
    <sys:String x:Key="str.System.PipeLog.Empty">暂无管道通信记录，请连接游戏并操作功能面板。</sys:String>


    <!-- System tab: Maintenance (open log folder + remove all snapshot databases) -->
    <sys:String x:Key="str.System.Maintenance.Header">维护工具</sys:String>

    <!-- Diagnostics (Sense) — what the pipe traffic costs -->
    <sys:String x:Key="str.System.Diag.Header">性能诊断 — DLL调度耗时</sys:String>
    <sys:String x:Key="str.System.Diag.Refresh">刷新</sys:String>
    <sys:String x:Key="str.System.Diag.Reset">重置统计计数</sys:String>
    <sys:String x:Key="str.System.Diag.Auto">自动刷新(5秒)</sys:String>
    <sys:String x:Key="str.System.Diag.AutoTip">每5秒自动读取一次性能数据。刷新间隔刻意设长，因为每次读取本身也会产生调度开销，高频刷新会拉高占用统计值。切换面板时自动暂停，切回后恢复刷新。</sys:String>
    <sys:String x:Key="str.System.Diag.RefreshTip">手动获取最新性能快照，查看各管道指令占用DLL调度时长、内存、CPU、线程、游戏线程运行状态。读取操作无风险，可频繁点击。CPU占用需要两次采样计算差值，首次读取显示横线。注意：内存、CPU、线程统计是整个游戏进程的数据，无法单独拆分本注入DLL；仅上方调度表格为工具自身开销。</sys:String>
    <sys:String x:Key="str.System.Diag.ResetTip">清空所有统计并重置计时，方便单独统计单次操作性能。断开所有连接客户端时计数也会自动重置。</sys:String>
    <sys:String x:Key="str.System.Diag.Summary">共{0}次调度，总时长{1}秒，调度占用{2}% · GObjects总数{3:N0}</sys:String>
    <sys:String x:Key="str.System.Diag.Process">游戏进程：工作集{0} · 私有内存{1} · CPU占用{2}% · {3}线程 · {4}句柄</sys:String>
    <sys:String x:Key="str.System.Diag.GameThread">游戏线程钩子：{0} · {1} · {2} · 触发{3:N0}次</sys:String>
    <sys:String x:Key="str.System.Diag.LastFire">上次触发距今 {0:N0} 毫秒</sys:String>
    <sys:String x:Key="str.System.Diag.NeverFired">从未触发（首次调用函数才会安装钩子）</sys:String>
    <sys:String x:Key="str.System.Diag.Responsable">线程响应正常</sys:String>
    <sys:String x:Key="str.System.Diag.Stalled">线程阻塞卡死</sys:String>
    <sys:String x:Key="str.System.Diag.NotConnected">查看诊断需要已连接游戏DLL</sys:String>
    <sys:String x:Key="str.System.Diag.Reset.Done">统计计数已重置</sys:String>
    <sys:String x:Key="str.System.Diag.Error">读取诊断数据失败：{0}</sys:String>
    <sys:String x:Key="str.System.OpenLogFolder">打开日志文件夹</sys:String>
    <sys:String x:Key="str.System.OpenLogFolderTip">在资源管理器打开程序日志目录 %LOCALAPPDATA%\UE5CEDumper\Logs</sys:String>
    <sys:String x:Key="str.System.OpenLogFolder.Error">无法打开日志目录：{0}</sys:String>
    <sys:String x:Key="str.System.CompressLogs">压缩日志文件</sys:String>
    <sys:String x:Key="str.System.CompressLogsTip">使用NTFS LZX无损压缩本地归档日志，实测压缩比可达12.8:1。压缩后文件名称、后缀不变，可直接用文本编辑器打开。跳过规则：当前会话日志、小于4KB文件、一小时内新文件、已压缩文件、闲置未满7天的最新快照日志。游戏运行时也可执行，采用空闲低优先级。</sys:String>
    <sys:String x:Key="str.System.CompressLogs.Running">正在压缩日志...</sys:String>
    <sys:String x:Key="str.System.CompressLogs.Result">已压缩{0}个日志文件：{1}MB → {2}MB，节省{3}MB，{4}个文件压缩失败</sys:String>
    <sys:String x:Key="str.System.CompressLogs.NothingToDo">无需压缩：{0}个已压缩，{1}个因大小/时间/占用跳过</sys:String>
    <sys:String x:Key="str.System.CompressLogs.Unsupported">磁盘分区非NTFS，不支持日志压缩功能</sys:String>
    <sys:String x:Key="str.System.CompressLogs.Error">日志压缩操作失败：{0}</sys:String>
    <sys:String x:Key="str.System.AutoCompressLogs">程序启动自动压缩7天前旧日志</sys:String>
    <sys:String x:Key="str.System.AutoCompressLogsTip">默认关闭。开启后每次启动后台低优先级压缩7天未改动日志，不修改文件时间戳，21天自动清理规则不受影响。</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots">删除全部快照数据</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshotsTip">永久删除所有游戏的快照数据库文件（snapshots.*.db及附属文件），直接删除磁盘文件而非清空表。正在捕获快照的占用文件会跳过，书签数据不受影响。该操作不可逆，属于实验性功能。</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.ConfirmTitle">确认删除所有快照</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.ConfirmMessage">确定永久删除全部游戏快照数据库文件？此操作无法撤销。</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.ConfirmYes">删除文件</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.None">未找到快照数据库文件</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.Result">已删除{0}个快照数据库文件</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.ResultPartial">成功删除{0}个，{1}个文件正在占用，请停止捕获后重试</sys:String>
    <sys:String x:Key="str.System.RemoveAllSnapshots.Error">删除快照出错：{0}</sys:String>


