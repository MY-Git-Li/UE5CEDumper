    <sys:String x:Key="str.Pointers.Copy">Copy</sys:String>
    <sys:String x:Key="str.Pointers.NotConnected">Not connected — connect to view pointers</sys:String>
    <sys:String x:Key="str.Pointers.VersionWarning">&#x26A0; Version not detected — inferred from engine analysis (custom UE build?)</sys:String>
    <sys:String x:Key="str.Pointers.VersionDetectedBadge">&#x2713; Detected</sys:String>
    <sys:String x:Key="str.Pointers.VersionUserOverrideBadge">&#x1F527; User Override</sys:String>
    <sys:String x:Key="str.Pointers.VersionUserOverrideTooltip">UE version was set manually. The override is saved per-game and reapplied on every launch.</sys:String>
    <sys:String x:Key="str.Pointers.VersionLowConfidenceBadge">&#x26A0; Low Confidence</sys:String>
    <sys:String x:Key="str.Pointers.VersionLowConfidenceText">Detected via fragile fallback path — bare pattern match or publisher bias. If exports look wrong, set the correct UE version using the Override ComboBox below.</sys:String>
    <sys:String x:Key="str.Pointers.VersionOverrideLabel">Override:</sys:String>
    <sys:String x:Key="str.Pointers.VersionOverrideTooltip">Force a specific UE version for this game. Saved per-game and reapplied on every launch. Choose Auto to revert to auto-detection.</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutLabel">Invoke timeout (ms):</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutTooltip">UFunction call wait time. Default 5000 = 5s. Increase if "GameThreadDispatch: invoke timeout" appears in logs (Blueprint widget delegates often need 10-30s). Saved per-game; reset to 5000 to clear.</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutOverrideBadge">&#x23F1; Custom</sys:String>
    <sys:String x:Key="str.Pointers.InvokeTimeoutOverrideTooltip">Per-game timeout override is active (differs from the 5000ms default).</sys:String>
    <sys:String x:Key="str.Pointers.PublisherLabel">Publisher:</sys:String>
    <sys:String x:Key="str.Pointers.AobFailed">&#x26A0; AOB failed — found via</sys:String>
    <sys:String x:Key="str.Pointers.GWorldNotFound">GWorld not found (non-critical)</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegates">FSparseDelegateStorage</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesOptional">Optional (UE 5.0+) &#x2014; powers MulticastSparseDelegateProperty drill-down + Find Refs sparse coverage</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesNotFound">AOB not found &#x2014; sparse delegate drill-down disabled. Bound flag still surfaces; full bindings unavailable.</sys:String>
    <sys:String x:Key="str.Pointers.SparseDelegatesUnsupported">UE &#x003C; 5.0 &#x2014; walker not supported on this version (FObjectKey outer key, separate AOB needed).</sys:String>
    <sys:String x:Key="str.Pointers.PatternIdTooltip">AOB pattern ID that matched this pointer</sys:String>
    <sys:String x:Key="str.Pointers.AobAllFailed">&#x1F534; All AOB patterns failed</sys:String>
    <sys:String x:Key="str.Pointers.ExtraScan">Extra Scan</sys:String>
    <sys:String x:Key="str.Pointers.ExtraScanHint">Some pointers not found. Try aggressive scanning techniques (5-20 seconds).</sys:String>
