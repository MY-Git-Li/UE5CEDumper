    <sys:String x:Key="str.Tools.ExportFreezeHelperLua">Export Freeze Helper Lua File...</sys:String>

    <!-- Property Search -->
    <sys:String x:Key="str.PropertySearch.QueryHint">Property name (e.g. Health, Mana, Gold)</sys:String>
    <sys:String x:Key="str.PropertySearch.TypeHint">Type filter (start typing — e.g. opt, weak)</sys:String>
    <sys:String x:Key="str.PropertySearch.ResultFilterLabel">Filter results:</sys:String>
    <sys:String x:Key="str.PropertySearch.ResultFilterHint">Refine current results (no re-query)</sys:String>
    <sys:String x:Key="str.PropertySearch.Search">Search</sys:String>
    <sys:String x:Key="str.PropertySearch.GameOnly">Game classes only</sys:String>
    <sys:String x:Key="str.PropertySearch.FindInstances">Find Instances</sys:String>
    <sys:String x:Key="str.PropertySearch.CopyOffset">Copy Offset</sys:String>
    <sys:String x:Key="str.PropertySearch.Freeze">Freeze</sys:String>

    <!-- Game Class Filter -->
    <sys:String x:Key="str.GameClassFilter.Load">Load</sys:String>
    <sys:String x:Key="str.GameClassFilter.GameOnly">Game classes only</sys:String>
    <sys:String x:Key="str.GameClassFilter.FilterHint">Filter by name...</sys:String>
    <sys:String x:Key="str.GameClassFilter.FindInstances">Find Instances</sys:String>
    <sys:String x:Key="str.GameClassFilter.WalkClass">Walk Class</sys:String>
    <sys:String x:Key="str.GameClassFilter.SuperLabel">Super:</sys:String>
    <sys:String x:Key="str.GameClassFilter.SuperHint">(All)</sys:String>
    <sys:String x:Key="str.GameClassFilter.PackageLabel">Package:</sys:String>
    <sys:String x:Key="str.GameClassFilter.PackageHint">(All)</sys:String>
    <sys:String x:Key="str.GameClassFilter.Clear">Clear</sys:String>

    <!-- Interesting Functions Finder -->
    <sys:String x:Key="str.IF.Load">Load</sys:String>
    <sys:String x:Key="str.IF.GameOnly">Game Only</sys:String>
    <sys:String x:Key="str.IF.FilterHint">Filter by name (function or class)...</sys:String>
    <sys:String x:Key="str.IF.ShowAll">Show All (incl. low-score)</sys:String>
    <sys:String x:Key="str.IF.ClearFilters">Clear</sys:String>
    <sys:String x:Key="str.IF.OpenLive">Live</sys:String>
    <sys:String x:Key="str.IF.CopyAaScript">AA(B)</sys:String>
    <sys:String x:Key="str.IF.CopyName">Name</sys:String>
    <sys:String x:Key="str.Tip.IF.Load">Scan all UFunctions across all loaded UClasses. Takes 2-10s on large games (1M+ objects). Score is computed client-side from name keywords + class bonus + flag bonus.</sys:String>
    <sys:String x:Key="str.Tip.IF.GameOnly">Skip /Script/Engine, /Script/CoreUObject, etc. Typically reduces the result set ~5x for shipping games. Recheck + re-Load to refresh.</sys:String>
    <sys:String x:Key="str.Tip.IF.Filter">Substring match against function name OR class name (case-insensitive). e.g. "Money" or "PlayerCharacter".</sys:String>
    <sys:String x:Key="str.Tip.IF.Category">Filter by category. Categories are picked from the strongest-scoring keyword bucket per function (Stats &gt; Inventory &gt; Movement &gt; Combat &gt; Utility tied with same score).</sys:String>
    <sys:String x:Key="str.Tip.IF.ShowAll">When off, hide rows with score below the InterestingThreshold (currently 5). When on, show every UFunction regardless of score.</sys:String>
    <sys:String x:Key="str.Tip.IF.OpenLive">Try to open this function in Live Walker. If the class has no live (non-CDO) instance, falls back to the Class Struct tab. Auto-expands the Functions section and selects the target row.</sys:String>
    <sys:String x:Key="str.Tip.IF.CopyAaScript">Open the Copy AA Script (Baked) dialog for this function. Output requires ue5_invoke_helper.lua embedded in your CE table (Tools -&gt; Export CE Helper Lua File...).</sys:String>
    <sys:String x:Key="str.Tip.IF.CopyName">Copy this function's name to the clipboard. Useful when pasting into a CE script or another tool.</sys:String>
    <sys:String x:Key="str.IF.GenerateCT">📦 Generate CT</sys:String>
    <sys:String x:Key="str.Tip.IF.GenerateCT">Generate one .CT file containing baked-invoke entries for every selected row. Use Ctrl/Shift+click in the grid to multi-select first. Functions with parameters: the helper zero-fills PARAMS; edit the baked PARAMS table in the generated entry before activating.</sys:String>

    <!-- Console (UFUNCTION(exec) discovery + invoke) -->
    <sys:String x:Key="str.Con.Load">Load</sys:String>
    <sys:String x:Key="str.Con.GameOnly">Game Only</sys:String>
    <sys:String x:Key="str.Con.FilterHint">Filter exec commands by name...</sys:String>
    <sys:String x:Key="str.Con.ClearFilter">Clear</sys:String>
    <sys:String x:Key="str.Con.CommandHint">type command (e.g. fly, ghost, god)</sys:String>
    <sys:String x:Key="str.Con.Run">Run</sys:String>
    <sys:String x:Key="str.Con.RunSelected">Run Selected</sys:String>
    <sys:String x:Key="str.Con.RunRow">Run</sys:String>
    <sys:String x:Key="str.Con.OpenLive">Live</sys:String>
    <sys:String x:Key="str.Con.CopyAaScript">AA(B)</sys:String>
    <sys:String x:Key="str.Con.HistoryHeader">Recent invocations</sys:String>
    <sys:String x:Key="str.Tip.Con.Load">Scan every UFunction and surface those marked with UFUNCTION(exec) (FUNC_Exec=0x200). Many games leave these intact in cooked Shipping — they're the cheat surface the developer already curated.</sys:String>
    <sys:String x:Key="str.Tip.Con.GameOnly">When OFF (default), engine-side UCheatManager exec commands are included — usually what you want. Flip ON to see only game-specific exec commands.</sys:String>
    <sys:String x:Key="str.Tip.Con.Filter">Substring match against command name OR class name (case-insensitive). Empty = show all.</sys:String>
    <sys:String x:Key="str.Tip.Con.CommandInput">Type an exec command name and press Run. No-arg commands invoke directly; commands with parameters open the InvokeParamDialog. Leading slash is stripped (/fly == fly).</sys:String>
    <sys:String x:Key="str.Tip.Con.RunCommand">Resolve the typed command against the loaded list and invoke. Match is case-insensitive exact funcName; first match wins if multiple classes implement the same name.</sys:String>
    <sys:String x:Key="str.Tip.Con.RunSelected">Invoke the currently selected row. Same code path as Run on a row.</sys:String>
    <sys:String x:Key="str.Tip.Con.RunRow">Invoke this exec command. No-arg commands run directly via pipe; commands with parameters open the InvokeParamDialog.</sys:String>
    <sys:String x:Key="str.Tip.Con.OpenLive">Try to open the implementing class in Live Walker. Falls back to Class Struct on CDO-only classes (UCheatManager subclasses often have no live instance until a PlayerController spawns).</sys:String>
    <sys:String x:Key="str.Tip.Con.CopyAaScript">Open the Copy AA Script (Baked) dialog for this exec command — useful when you want to bake the invoke into a CE Auto Assembler script for table sharing.</sys:String>
    <sys:String x:Key="str.Tip.Con.Replay">Re-run this command. Requires the discovery list to still be loaded (re-launch wipes the cache).</sys:String>

    <!-- Interesting Properties Finder (B' / Unusual Location) -->
    <sys:String x:Key="str.IP.Load">Load</sys:String>
    <sys:String x:Key="str.IP.GameOnly">Game Only</sys:String>
    <sys:String x:Key="str.IP.FilterHint">Filter by name (property or class)...</sys:String>
    <sys:String x:Key="str.IP.UnusualOnly">⚠ Unusual Only</sys:String>
    <sys:String x:Key="str.IP.ShowAll">Show All (incl. low-score)</sys:String>
    <sys:String x:Key="str.IP.ClearFilters">Clear</sys:String>
    <sys:String x:Key="str.IP.OpenLive">Live</sys:String>
    <sys:String x:Key="str.IP.CopyName">Name</sys:String>
    <sys:String x:Key="str.Tip.IP.Load">Fan-out search across the seed keyword list (HP/Damage/Gold/Speed/etc.) and score the results client-side. Highlights properties in non-canonical locations (LocalPlayer / HUD / GameViewportClient) — the kind of cheat-relevant fields a CE user would miss looking only in Character/Pawn.</sys:String>
    <sys:String x:Key="str.Tip.IP.GameOnly">Skip /Script/Engine, /Script/CoreUObject, etc. Recommended on — game-specific properties are the cheat-table targets.</sys:String>
    <sys:String x:Key="str.Tip.IP.Filter">Substring match against property name OR class name (case-insensitive). e.g. "Health" or "PlayerState".</sys:String>
    <sys:String x:Key="str.Tip.IP.Category">Filter by category. Stats / Combat / Resources / Movement / Utility / Other.</sys:String>
    <sys:String x:Key="str.Tip.IP.UnusualOnly">Show only properties whose owning class is in the Unusual Location list (LocalPlayer / GameViewportClient / HUD / CheatManager) — properties developers placed outside the conventional Character/Pawn/PlayerState containers.</sys:String>
    <sys:String x:Key="str.Tip.IP.ShowAll">When off, hide rows below the InterestingThreshold (currently 4). When on, show every property regardless of score.</sys:String>
    <sys:String x:Key="str.Tip.IP.OpenLive">Open this property's owning class in Live Walker (live instance lookup), or fall back to Class Struct if no live instance exists.</sys:String>
    <sys:String x:Key="str.Tip.IP.CopyName">Copy this property's name to the clipboard.</sys:String>
    <sys:String x:Key="str.IP.GenerateCT">📦 Generate CT</sys:String>
    <sys:String x:Key="str.Tip.IP.GenerateCT">Generate one .CT file containing freeze entries for every selected row. Use Ctrl/Shift+click in the grid to multi-select first. Each entry uses ue5_freeze_helper.lua — embed it in the resulting CT via Tools → Inject Freeze Helper, or open the CT in CE and edit CFG.value before enabling. Struct / array / non-scalar rows are skipped.</sys:String>

    <!-- Proxy DLL / Deferred Scan -->
    <sys:String x:Key="str.Toolbar.StartScan">Start Scan</sys:String>
    <sys:String x:Key="str.Toolbar.Scanning">Scanning...</sys:String>

    <!-- Errors -->
    <sys:String x:Key="str.Error.Connection">Failed to connect to pipe server</sys:String>
    <sys:String x:Key="str.Error.ReadFailed">Memory read failed</sys:String>
    <sys:String x:Key="str.Error.AlreadyRunning">Another instance of UE5 Dump UI is already running</sys:String>

    <!-- Tooltips: MainWindow toolbar -->
    <sys:String x:Key="str.Tip.Connect">Connect to injected DLL via named pipe</sys:String>
    <sys:String x:Key="str.Tip.Disconnect">Disconnect from DLL pipe server</sys:String>
    <sys:String x:Key="str.Tip.StartScan">Trigger deferred scan (proxy DLL mode)</sys:String>
    <sys:String x:Key="str.Tip.AddressFormat">Address display format (absolute / module-relative)</sys:String>
    <sys:String x:Key="str.Tip.CollapsePointers">Collapse pointer chain nodes in CE XML export</sys:String>
    <sys:String x:Key="str.Tip.ArrayLimit">Max array elements to read inline (2^N)</sys:String>
    <sys:String x:Key="str.Tip.DropDownLimit">Max CE DropDownList entries (2^N)</sys:String>
    <sys:String x:Key="str.Tip.PreviewLimit">Struct sub-fields shown in Value column (0 = no preview)</sys:String>
    <sys:String x:Key="str.Tip.CsxDepth">Pointer drill-down depth (0 = flat). Applies to both CSX export and CE XML / CE Field copy. 0-4 normal; 5-6 deep — output size grows exponentially per level (depth 6 on UWorld can produce multi-MB CE XML).</sys:String>
    <sys:String x:Key="str.Tip.Toolbar.Options">Export-shape settings: pointer-node collapse, array/dropdown/preview limits, drill depth. Set once per session.</sys:String>
    <sys:String x:Key="str.Tip.Export">Export object data in various formats</sys:String>
    <sys:String x:Key="str.Tip.Tools">Tools that don't depend on a live DLL connection (helper file export/inject, etc.)</sys:String>
    <sys:String x:Key="str.Tip.Tools.InjectCeHelperLua">One-click: send ue5_invoke_helper.lua straight into the currently open CE table via the AOBMaker plugin. Replaces existing copy if present. Skips the manual save-to-disk + Table -&gt; Add File... dance. Requires the AOBMaker CE Plugin to be loaded (open Cheat Engine first); falls back gracefully if unavailable.</sys:String>
    <sys:String x:Key="str.Tip.Tools.ExportCeHelperLua">Save ue5_invoke_helper.lua to a file you can drop next to your .CT and add via Cheat Engine's Table -&gt; Add File... menu. Required by every "Copy AA Script (Baked)" output -- one-time setup per cheat table.</sys:String>
    <sys:String x:Key="str.Tip.Tools.InjectFreezeHelperLua">One-click: send ue5_freeze_helper.lua into the currently open CE table via the AOBMaker plugin. Required once per .CT by every Property Search "Freeze" script. Coexists with ue5_invoke_helper.lua.</sys:String>
    <sys:String x:Key="str.Tip.Tools.ExportFreezeHelperLua">Save ue5_freeze_helper.lua to a file you can drop next to your .CT and add via Cheat Engine's Table -&gt; Add File... menu. Manual fallback when AOBMaker plugin is unavailable.</sys:String>

    <!-- Tooltips: Object Tree -->
    <sys:String x:Key="str.Tip.ObjectTree.Reload">Reload all objects from game process</sys:String>
    <sys:String x:Key="str.Tip.ObjectTree.Cancel">Cancel current loading operation</sys:String>
    <sys:String x:Key="str.Tip.ObjectTree.Search">Search objects by name or class</sys:String>
    <sys:String x:Key="str.Tip.ObjectTree.ClassFilter">Filter by class type</sys:String>
    <sys:String x:Key="str.Tip.ObjectTree.TextFilter">Filter loaded objects by text</sys:String>

    <!-- Tooltips: Instance Finder -->
    <sys:String x:Key="str.Tip.InstanceFinder.Search">Search for instances of the specified class</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.ExactMatch">Match class name exactly (no substring)</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.Lookup">Lookup UObject at the specified address</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.CopyAddr">Copy instance address to clipboard</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.OpenWalker">Open this instance in Live Walker</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.ExportCE">Export instance as CE XML pointer chain</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.CopyFieldAddr">Copy field absolute address</sys:String>
    <sys:String x:Key="str.Tip.InstanceFinder.AA">Generate CE Auto Assembler script</sys:String>

    <!-- Tooltips: Property Search -->
    <sys:String x:Key="str.Tip.PropertySearch.Search">Search across all classes. Either Name or Type must be set; comma-separate multiple types.</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.TypeFilter">Restrict by FProperty type. Type a few characters to filter the suggestion dropdown (e.g. 'opt' → OptionalProperty). Comma-separated for OR.</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.ResultFilter">Filter the current result list locally (case-insensitive substring across Class / Property / Type / Super / Preview). No DLL roundtrip.</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.GameOnly">Show only game-specific classes (exclude engine)</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.FindInstances">Find live instances of this class</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.CopyOffset">Copy property offset to clipboard</sys:String>
    <sys:String x:Key="str.Tip.PropertySearch.Freeze">Generate an AA Script that locks this property across all live instances. Requires AOBMaker plugin in CE.</sys:String>

    <!-- Tooltips: Game Class Filter -->
    <sys:String x:Key="str.Tip.GameClassFilter.Load">Load class list from game process</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.GameOnly">Show only game-specific classes (exclude engine)</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.SuperFilter">Filter by super/parent class</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.PackageFilter">Filter by UE package name</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.TextFilter">Filter classes by name substring</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.Clear">Clear all filters</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.FindInstances">Find live instances of this class</sys:String>
    <sys:String x:Key="str.Tip.GameClassFilter.WalkClass">Open class in Live Walker to inspect fields</sys:String>

    <!-- Live Walker: Functions -->
    <sys:String x:Key="str.LiveWalker.Functions">Functions</sys:String>
    <sys:String x:Key="str.LiveWalker.FuncGenScript">INV</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.FuncGenScript">Generate CE invoke script for this UFunction</sys:String>
    <sys:String x:Key="str.LiveWalker.FuncPipeInvoke">PIPE</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.FuncPipeInvoke">Invoke this function via pipe (DLL executes ProcessEvent in-process, bypasses CE)</sys:String>
    <sys:String x:Key="str.LiveWalker.FuncCopyBaked">AA(Baked)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.FuncCopyBaked">Copy a non-interactive CE AA Script with the parameter values baked in. Requires ue5_invoke_helper.lua embedded in your .CT via Table -&gt; Add File... (Tools -&gt; Export CE Helper Lua File... to obtain it).</sys:String>

    <sys:String x:Key="str.LiveWalker.GuessWhat">Guess?</sys:String>

    <!-- Tooltips: Live Walker -->
    <sys:String x:Key="str.Tip.LiveWalker.StartWorld">Navigate to GWorld and list top-level objects</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.Back">Go back to previous object</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.Refresh">Re-read current object fields from memory</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.FindRefs">Find UObjects that hold a pointer to this one (true logical owner — Outer/Parent often only gives the naming-hierarchy package)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.Go">Navigate to the specified address</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.ExportCE">Copy full CE XML pointer chain to clipboard</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.ExportCEField">Copy CE XML for the selected field(s) only (Ctrl/Shift-click to multi-select)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.AobToggle">Use AOB-scanned GWorld symbol instead of hardcoded address (survives game restarts)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.ExportCsx">Export CE Structure Dissect script (.csx)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.ExportHeader">Export C++ SDK header (.h)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.CeAA">Generate CE Auto Assembler script to clipboard</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.GuessWhat">Fill gaps between known fields with guessed data types (pointer, float, int, etc.)</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.CopyFieldAddr">Copy field absolute address</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.CopyFieldName">Copy field name to clipboard</sys:String>
    <sys:String x:Key="str.Tip.LiveWalker.Search">Search fields by name</sys:String>

    <!-- Tooltips: Pointer Panel -->
    <sys:String x:Key="str.Tip.Pointers.Copy">Copy address to clipboard</sys:String>
    <sys:String x:Key="str.Tip.Pointers.CopyScan">Copy AOB scan hit address to clipboard</sys:String>
    <sys:String x:Key="str.Tip.Pointers.ExtraScan">Run aggressive fallback scan for missing pointers</sys:String>
    <sys:String x:Key="str.Tip.Pointers.TestExtraScan">Simulate scan progress UI (dev testing only)</sys:String>
    <sys:String x:Key="str.Tip.Pointers.ClearGameCache">Remove cached scan hints for the current game (next scan will try all patterns)</sys:String>
    <sys:String x:Key="str.Tip.Pointers.ResetAllCache">Rename the entire cache file with a numbered backup (.001-.010) and start fresh</sys:String>

    <!-- Tooltips: Proxy Deploy -->
    <sys:String x:Key="str.Tip.ProxyDeploy.Scan">Detect Steam-installed UE games</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Refresh">Refresh deploy status for detected games</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Deploy">Deploy proxy DLL to selected games</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Undeploy">Remove proxy DLL from selected games</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.UpdateAll">Update all deployed games to latest version</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Force">Overwrite even if same version or other proxy detected</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Type.Version">Hijack version.dll — broadest game compatibility (loaded by virtually every Windows process)</sys:String>
    <sys:String x:Key="str.Tip.ProxyDeploy.Type.Dinput8">Hijack dinput8.dll — fallback when version.dll conflicts with installer or anti-tamper shim</sys:String>

</ResourceDictionary>
