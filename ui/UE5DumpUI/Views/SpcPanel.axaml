<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.SpcPanel"
             x:DataType="vm:SpcQueryViewModel">

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,170,Auto,*,Auto">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Spc.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Query controls -->
    <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
            BorderBrush="#3C3C3C" BorderThickness="1">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.Join}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding JoinModeOptions}" SelectedItem="{Binding SelectedJoinMode}"
                  MinWidth="120" Margin="0,0,12,0" ToolTip.Tip="{StaticResource str.Spc.JoinHint}"
                  IsEnabled="{Binding !IsQuerying}"/>
        <TextBlock Text="{StaticResource str.Spc.ClassFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding ClassFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsQuerying}"/>
        <TextBlock Text="{StaticResource str.Spc.PropFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding PropFilter}" Width="140" Margin="0,0,12,0" IsEnabled="{Binding !IsQuerying}"/>
        <Button Content="{StaticResource str.Spc.Run}" Command="{Binding RunQueryCommand}"
                IsEnabled="{Binding CanRunQuery}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Spc.Refresh}" Command="{Binding RefreshCommand}"
                Padding="8,4" Margin="0,0,8,0" IsEnabled="{Binding !IsQuerying}"/>
        <Button Content="{StaticResource str.Spc.OpenWalker}" Command="{Binding OpenInLiveWalkerCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Spc.LocateGWorld}" Command="{Binding LocateRowInGWorldCommand}"
                CommandParameter="{Binding SelectedResult}" IsEnabled="{Binding IsGWorldAvailable}"
                ToolTip.Tip="{StaticResource str.Tip.Spc.LocateGWorld}" Padding="8,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Spc.CopyAddr}" Command="{Binding CopyAddressCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4"/>
      </WrapPanel>
    </Border>

    <!-- Picker header -->
    <TextBlock Grid.Row="2" Text="{StaticResource str.Spc.PickerHeader}" Foreground="#9CDCFE"
               FontWeight="SemiBold" Margin="0,0,0,6"/>

    <!-- Snapshot picker: tick the snapshots (oldest selected = baseline) and set
         each one's directional predicate vs the previous selected snapshot. -->
    <DataGrid Grid.Row="3" ItemsSource="{Binding SnapshotPicks}" IsReadOnly="False"
              GridLinesVisibility="Horizontal" Background="#1E1E1E"
              IsEnabled="{Binding !IsQuerying}"
              CanUserResizeColumns="True" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Use}" Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Label}"
                            Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Captured}"
                            Binding="{Binding CapturedAt}" IsReadOnly="True" Width="190"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Col.Session}"
                            Binding="{Binding SessionShort}" IsReadOnly="True" Width="120"/>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.Predicate}" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <ComboBox ItemsSource="{Binding PredicateOptions}"
                        SelectedItem="{Binding SelectedPredicate}"
                        IsEnabled="{Binding PredicateEnabled}"
                        HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{StaticResource str.Spc.Col.ValueFilter}" Width="240">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:SpcSnapshotPick">
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="2" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding AbsKindOptions}" SelectedItem="{Binding AbsKind}"
                          IsEnabled="{Binding AbsEnabled}" MinWidth="96"/>
                <TextBox Text="{Binding AbsLow}" Width="52" IsEnabled="{Binding AbsEnabled}"
                         IsVisible="{Binding ShowAbsLow}" PlaceholderText="lo"/>
                <TextBox Text="{Binding AbsHigh}" Width="52" IsEnabled="{Binding AbsEnabled}"
                         IsVisible="{Binding ShowAbsHigh}" PlaceholderText="hi"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Result filters + hint + status -->
    <StackPanel Grid.Row="4" Spacing="6" Margin="0,8,0,8">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.ResClass}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultClassFilter, Mode=TwoWay}" ItemsSource="{Binding ResultClassOptions}"
                         FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResField}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultFieldFilter, Mode=TwoWay}" ItemsSource="{Binding ResultFieldOptions}"
                         FilterMode="Contains" Width="140" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResObject}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <AutoCompleteBox Text="{Binding ResultObjectFilter, Mode=TwoWay}" ItemsSource="{Binding ResultObjectOptions}"
                         FilterMode="Contains" Width="170" Margin="0,0,8,0"/>
        <TextBlock Text="{StaticResource str.Spc.ResGlobal}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding ResultGlobalFilter}" Width="160" PlaceholderText="{StaticResource str.Spc.ResGlobalHint}"/>
      </WrapPanel>
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{StaticResource str.Spc.SeqFirst}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding SeqFirstMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
        <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
        <TextBox Text="{Binding SeqFirstMax}" Width="70" Margin="0,0,12,0" PlaceholderText="max"/>
        <TextBlock Text="{StaticResource str.Spc.SeqLast}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox Text="{Binding SeqLastMin}" Width="70" Margin="0,0,2,0" PlaceholderText="min"/>
        <TextBlock Text="–" Foreground="#888" VerticalAlignment="Center" Margin="0,0,2,0"/>
        <TextBox Text="{Binding SeqLastMax}" Width="70" Margin="0,0,8,0" PlaceholderText="max"/>
        <Button Content="{StaticResource str.Spc.ApplyRange}" Command="{Binding ApplyResultRangeCommand}" Padding="8,3" Margin="0,0,4,0"/>
        <Button Content="{StaticResource str.Spc.ResetRange}" Command="{Binding ResetResultRangeCommand}" Padding="8,3"/>
      </WrapPanel>
      <ProgressBar IsIndeterminate="True" Height="4" Width="220" HorizontalAlignment="Left"
                   IsVisible="{Binding IsQuerying}"/>
      <TextBlock Text="{StaticResource str.Spc.BaselineHint}" Foreground="#888" FontSize="11"
                 TextWrapping="Wrap"/>
      <TextBlock Text="{Binding WarningText}" Foreground="#D7BA7D" FontSize="12" TextWrapping="Wrap"
                 FontStyle="Italic"
                 IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Results -->
    <DataGrid Grid.Row="5" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Class}"    Binding="{Binding ClassName}"       SortMemberPath="ClassName"       Width="200"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Object}"   Binding="{Binding NormPath}"        SortMemberPath="NormPath"        Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Field}"    Binding="{Binding PropName}"        SortMemberPath="PropName"        Width="150"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Type}"     Binding="{Binding DeclaredType}"    SortMemberPath="DeclaredType"    Width="120"/>
        <DataGridTextColumn Header="{StaticResource str.Spc.Res.Sequence}" Binding="{Binding SequenceDisplay}" SortMemberPath="SequenceDisplay" Width="240"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- N1: noise picker (Top-N class contributors) + active denylist chips.
         Collapsed by default; opens to a fixed height so it doesn't eat the
         result grid. Apply pushes ticked rows into the per-game denylist file
         (snapshots.<pe_hash>.denylist.json) and re-runs the SPC query. -->
    <Expander Grid.Row="6" Header="{StaticResource str.Noise.PanelHeader}"
              IsExpanded="{Binding NoisePanelOpen}" Margin="0,8,0,0"
              Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Orientation="Vertical" Margin="6">
        <TextBlock Text="{StaticResource str.Noise.PanelHint}"
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Top-N picker grid (height-capped) -->
        <DataGrid ItemsSource="{Binding NoiseRows}" IsReadOnly="False"
                  Height="200" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  CanUserResizeColumns="True" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{StaticResource str.Noise.Col.Pick}" Width="50" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:NoiseRowVm">
                  <CheckBox IsChecked="{Binding Picked}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Class}"
                                Binding="{Binding ClassName}" SortMemberPath="ClassName" IsReadOnly="True" Width="*"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.Hits}"
                                Binding="{Binding HitCount}" SortMemberPath="HitCount" IsReadOnly="True" Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.Noise.Col.SampleProps}"
                                Binding="{Binding SamplePropsDisplay}" SortMemberPath="SamplePropsDisplay" IsReadOnly="True" Width="240"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="{StaticResource str.Noise.Apply}"
                  Command="{Binding ApplyNoisePicksCommand}"
                  Classes="accent" Padding="12,4" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Reset}"
                  Command="{Binding ResetNoisePicksCommand}" Padding="8,4" Margin="0,0,12,0"/>
          <TextBlock Text="{StaticResource str.Noise.ActiveHeader}"
                     Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button Content="{StaticResource str.Noise.Clear}"
                  Command="{Binding ClearDenylistCommand}" Padding="8,3" Margin="0,0,6,0"/>
        </StackPanel>

        <!-- Active denylist chips: one button per class, click removes it. -->
        <ItemsControl ItemsSource="{Binding ActiveDenylist}" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Content="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:SpcQueryViewModel)DataContext).RemoveFromDenylistCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Noise.RemoveTip}"
                      Margin="0,0,4,4" Padding="6,2"
                      Background="#3C3C3C" Foreground="#CCCCCC"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
  </Grid>
</UserControl>
