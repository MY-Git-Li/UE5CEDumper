<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.ClassPivotPanel"
             x:DataType="vm:ClassPivotViewModel">

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,170,Auto,*,Auto">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Pivot.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Change-driven discovery: the automatic front-door. Find the (class, prop)
         targets that moved between two snapshots, ranked, so the user doesn't have to
         guess a class/key. "Use →" hands the chosen candidate to the pivot below. -->
    <Expander Grid.Row="1" Margin="0,0,0,8" IsExpanded="True"
              Header="{StaticResource str.Pivot.Discover.Header}">
      <StackPanel Orientation="Vertical" Spacing="6">
        <TextBlock Text="{StaticResource str.Pivot.Discover.Intro}"
                   Foreground="#999" FontSize="11" TextWrapping="Wrap"/>
        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsDiscovering}">
          <TextBlock Text="{StaticResource str.Pivot.Discover.From}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiscoverFrom}"
                    MinWidth="170" Margin="0,0,12,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding PickerDisplay}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{StaticResource str.Pivot.Discover.To}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiscoverTo}"
                    MinWidth="170" Margin="0,0,12,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding PickerDisplay}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{StaticResource str.Pivot.Discover.Run}" Command="{Binding RunDiscoverCommand}"
                  IsEnabled="{Binding CanDiscover}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Pivot.Discover.Use}" Command="{Binding UseDiscoverCandidateCommand}"
                  CommandParameter="{Binding SelectedDiscoverResult}"
                  IsEnabled="{Binding SelectedDiscoverResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Padding="12,4" Margin="0,0,8,0"/>
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="4,0,0,0"
                       IsVisible="{Binding IsDiscovering}"/>
          <TextBlock Text="{Binding DiscoverStatus}" Foreground="#4EC9B0" FontSize="12"
                     VerticalAlignment="Center" Margin="8,0,0,0"
                     IsVisible="{Binding DiscoverStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </WrapPanel>
        <!-- Ranked candidates: highest "looks like game state" first. Select a row →
             Use → pivots it (selects the class, ticks the property, runs). -->
        <DataGrid ItemsSource="{Binding DiscoverResults}" SelectedItem="{Binding SelectedDiscoverResult}"
                  Height="170" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
                  CanUserResizeColumns="True" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Class}"   Binding="{Binding ClassName}"      SortMemberPath="ClassName"        Width="*"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Prop}"    Binding="{Binding PropName}"       SortMemberPath="PropName"         Width="1.2*"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Changed}" Binding="{Binding ChangedDisplay}" SortMemberPath="InstancesChanged" Width="80"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Dir}"     Binding="{Binding Direction}"      SortMemberPath="Direction"        Width="44"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Cat}"     Binding="{Binding CategoryName}"   SortMemberPath="InterestScore"    Width="90"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Seq}"     Binding="{Binding SampleSequence}" SortMemberPath="SampleSequence"   Width="1.5*"/>
            <DataGridTextColumn Header="{StaticResource str.Pivot.Discover.Col.Score}"   Binding="{Binding ScoreDisplay}"   SortMemberPath="Score"            Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Expander>

    <!-- Snapshot / class selection. Grayed during a pivot run so the source /
         snapshot / class can't change mid-operation. -->
    <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
            BorderBrush="#3C3C3C" BorderThickness="1">
      <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
        <TextBlock Text="{StaticResource str.Pivot.Source}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}"
                  MinWidth="120" Margin="0,0,12,0"/>

        <!-- Snapshot + Snapshot Array sources share the snapshot/class pickers -->
        <TextBlock Text="{StaticResource str.Pivot.Snapshot}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding UsesSnapshot}"/>
        <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                  MinWidth="180" Margin="0,0,12,0" IsVisible="{Binding UsesSnapshot}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:SnapshotMeta">
              <TextBlock Text="{Binding PickerDisplay}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{StaticResource str.Pivot.ClassFilter}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding UsesSnapshot}"/>
        <TextBox Text="{Binding ClassFilter}" Width="130" Margin="0,0,8,0" IsVisible="{Binding UsesSnapshot}"/>
        <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                  MinWidth="260" Margin="0,0,12,0" IsVisible="{Binding UsesSnapshot}">
          <!-- N1: right-click the class picker → hide the selected class from the
               Pivot picker (independent Pivot-scope denylist). The ContextMenu
               inherits the ComboBox's VM DataContext, so the command binds cleanly. -->
          <ComboBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{StaticResource str.Pivot.HideClass}"
                        Command="{Binding HideClassCommand}"
                        CommandParameter="{Binding SelectedClass}"/>
            </ContextMenu>
          </ComboBox.ContextMenu>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:PivotClassInfo">
              <TextBlock Text="{Binding Display}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Snapshot Array source (Phase C6: inner-key pivot of a struct array) -->
        <TextBlock Text="{StaticResource str.Pivot.ArrayField}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsArraySource}"/>
        <ComboBox ItemsSource="{Binding ArrayFields}" SelectedItem="{Binding SelectedArrayField}"
                  MinWidth="240" Margin="0,0,12,0" IsVisible="{Binding IsArraySource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:PivotArrayFieldInfo">
              <TextBlock Text="{Binding Display}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- DataTable source (Phase C4: zero-config, RowName is the key) -->
        <TextBlock Text="{StaticResource str.Pivot.DataTable}" Foreground="#CCCCCC"
                   VerticalAlignment="Center" Margin="0,0,4,0" IsVisible="{Binding IsDataTableSource}"/>
        <ComboBox ItemsSource="{Binding DataTables}" SelectedItem="{Binding SelectedDataTable}"
                  MinWidth="300" Margin="0,0,8,0" IsVisible="{Binding IsDataTableSource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:DataTablePick">
              <TextBlock Text="{Binding Display}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="{StaticResource str.Pivot.RefreshDataTables}" Command="{Binding RefreshDataTablesCommand}"
                IsVisible="{Binding IsDataTableSource}" Padding="8,4" Margin="0,0,12,0"/>

        <Button Content="{StaticResource str.Pivot.Run}" Command="{Binding RunPivotCommand}"
                IsEnabled="{Binding CanRunPivot}" Classes="accent" Padding="12,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Pivot.OpenWalker}" Command="{Binding OpenInLiveWalkerCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4" Margin="0,0,8,0"/>
        <Button Content="{StaticResource str.Pivot.CopyAddr}" Command="{Binding CopyAddressCommand}"
                CommandParameter="{Binding SelectedResult}" Padding="8,4"/>
      </WrapPanel>
    </Border>

    <!-- Key mode -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Pivot.GroupBy}" Foreground="#CCCCCC" VerticalAlignment="Center"
                 IsVisible="{Binding IsSnapshotSource}"/>
      <ComboBox ItemsSource="{Binding KeyModeOptions}" SelectedItem="{Binding SelectedKeyMode}" MinWidth="170"
                IsVisible="{Binding IsSnapshotSource}" IsEnabled="{Binding !IsBusy}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyField}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding ShowKeyField}"/>
      <ComboBox ItemsSource="{Binding KeyFieldOptions}" SelectedItem="{Binding SelectedKeyField}"
                MinWidth="200" IsVisible="{Binding ShowKeyField}" IsEnabled="{Binding !IsBusy}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyRowName}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" IsVisible="{Binding IsDataTableSource}"/>
      <TextBlock Text="{StaticResource str.Pivot.KeyInnerKey}" Foreground="#CCCCCC"
                 VerticalAlignment="Center" IsVisible="{Binding IsArraySource}"/>
      <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" Margin="12,0,0,0"
                   IsVisible="{Binding IsBusy}"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12"
                 VerticalAlignment="Center" Margin="12,0,0,0"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12"
                 VerticalAlignment="Center" Margin="12,0,0,0"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <!-- Field picker: tick the value fields to project per group. KeyScore hints
         which fields make good group keys; the best is pre-selected above. -->
    <DataGrid Grid.Row="4" ItemsSource="{Binding Fields}" IsReadOnly="False"
              GridLinesVisibility="Horizontal" Background="#1E1E1E"
              IsEnabled="{Binding !IsBusy}"
              CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{StaticResource str.Pivot.Col.Project}" Width="60" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PivotFieldPick">
              <CheckBox IsChecked="{Binding IsValue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Field}"    Binding="{Binding Name}"            SortMemberPath="Name"          IsReadOnly="True" Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Type}"     Binding="{Binding DeclaredType}"    SortMemberPath="DeclaredType"  IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Distinct}" Binding="{Binding DistinctCount}"   SortMemberPath="DistinctCount" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.Insts}"    Binding="{Binding InstanceCount}"   SortMemberPath="InstanceCount" IsReadOnly="True" Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Col.KeyScore}" Binding="{Binding KeyScoreDisplay}" SortMemberPath="KeyScore"      IsReadOnly="True" Width="80"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="5" Text="{StaticResource str.Pivot.ResultsHint}" Foreground="#888"
               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>

    <!-- Results: one row per group -->
    <DataGrid Grid.Row="6" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Count}"  Binding="{Binding Count}"         SortMemberPath="Count"         Width="70"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Key}"    Binding="{Binding KeyValue}"      SortMemberPath="KeyValue"      Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Pivot.Res.Values}" Binding="{Binding ValuesDisplay}" SortMemberPath="ValuesDisplay" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- N1: hidden-class chips (Pivot-scope denylist). Only shown when non-empty.
         Click a chip to un-hide; "Clear all" empties the Pivot denylist. -->
    <Border Grid.Row="7" Background="#252526" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
            BorderBrush="#3C3C3C" BorderThickness="1"
            IsVisible="{Binding HasHiddenClasses}">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="{StaticResource str.Pivot.HiddenHeader}"
                     Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Content="{StaticResource str.Noise.Clear}"
                  Command="{Binding ClearDenylistCommand}" Padding="8,2"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding ActiveDenylist}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Content="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:ClassPivotViewModel)DataContext).RemoveFromDenylistCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{StaticResource str.Noise.RemoveTip}"
                      Margin="0,0,4,4" Padding="6,2"
                      Background="#3C3C3C" Foreground="#CCCCCC"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
