<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             x:Class="UE5DumpUI.Views.TeleportPanel"
             x:DataType="vm:TeleportViewModel"
             x:Name="Root">

  <ScrollViewer>
    <StackPanel x:Name="ContentRoot" Margin="10" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">

      <!-- Single-player warning -->
      <TextBlock Text="{StaticResource str.TP.Warning}"
                 Foreground="#E0A030" FontSize="12" TextWrapping="Wrap"/>
      <!-- Best-effort disclaimer (reflection-based; may not work on every game) -->
      <TextBlock Text="{StaticResource str.TP.BestEffort}"
                 Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>

      <!-- ── Current pose ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.PoseHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{StaticResource str.TP.Refresh}"
                    Command="{Binding RefreshPoseCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.Refresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,3"/>
            <Button Content="{StaticResource str.TP.Locate}"
                    Command="{Binding LocateCurrentPoseInGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.Locate}"
                    IsEnabled="{Binding CanOperate}" Padding="10,3"/>
            <!-- Locate in GameEngine: ⚙-icon sibling of the 🌍 Locate button; a
                 pawn is usually below GWorld so this is mostly for parity.
                 Connection-gated (CanOperate), not GWorld-gated. -->
            <Button Content="{StaticResource str.TP.LocateGameEngine}"
                    Command="{Binding LocateCurrentPoseInGameEngineCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.LocateGameEngine}"
                    IsEnabled="{Binding CanOperate}"
                    Foreground="#C586C0" Background="Transparent"
                    BorderThickness="1" BorderBrush="#C586C0"
                    Padding="6,2" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            <CheckBox Content="{StaticResource str.TP.Auto}"
                      IsChecked="{Binding AutoRefresh}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.Auto}"
                      Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1"
                    IsVisible="{Binding PoseSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding PoseSource}" Foreground="#7FB6E8"
                         FontSize="11" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource str.TP.Loc}"
                       Foreground="#999999" Margin="0,0,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding PoseX}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PoseY}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PoseZ}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the position FVector (RootComponent.RelativeLocation) in GWorld -->
              <Button Content="{StaticResource str.TP.LocatePos}"
                      Command="{Binding LocatePositionInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocatePos}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource str.TP.Rot}"
                       Foreground="#999999" Margin="0,2,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding PosePitch}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PoseYaw}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PoseRoll}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the rotation (Controller.ControlRotation FRotator) in GWorld -->
              <Button Content="{StaticResource str.TP.LocateRot}"
                      Command="{Binding LocateRotationInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateRot}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource str.TP.Map}"
                       Foreground="#999999" Margin="0,2,8,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PoseMap}"
                       Foreground="#BBBBBB" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
          </Grid>

          <!-- Resolved pawn address (the object the Locate button targets) -->
          <Grid ColumnDefinitions="Auto,*"
                IsVisible="{Binding PawnAddrDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Grid.Column="0" Text="{StaticResource str.TP.Pawn}"
                       Foreground="#999999" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding PawnAddrDisplay}"
                       Foreground="#7FB6E8" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
          </Grid>

          <!-- Live velocity / acceleration (read from the pawn's CharacterMovement) -->
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                ToolTip.Tip="{StaticResource str.Tip.TP.Velocity}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource str.TP.Velocity}"
                       Foreground="#999999" Margin="0,0,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding VelX}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding VelY}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding VelZ}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the velocity FVector (CharacterMovement.Velocity) in GWorld -->
              <Button Content="{StaticResource str.TP.LocateVel}"
                      Command="{Binding LocateVelocityInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateVel}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource str.TP.Speed}"
                       Foreground="#999999" Margin="0,2,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Speed}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Speed is |Velocity| (no own field) — lands on the Velocity vector -->
              <Button Content="{StaticResource str.TP.LocateSpeed}"
                      Command="{Binding LocateSpeedInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateSpeed}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource str.TP.Accel}"
                       Foreground="#999999" Margin="0,2,8,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding AccX}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding AccY}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding AccZ}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the acceleration FVector (CharacterMovement.Acceleration) -->
              <Button Content="{StaticResource str.TP.LocateAccel}"
                      Command="{Binding LocateAccelerationInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateAccel}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- Shown only when velocity/acceleration are unavailable (no CharacterMovement) -->
          <TextBlock Text="{Binding MovementNote}" Foreground="#E0A030"
                     FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding MovementNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- ── Camera POV (read-only) — distinct from the pawn pose above ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.PovHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="{StaticResource str.TP.GetPov}"
                    Command="{Binding GetPovCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GetPov}"
                    IsEnabled="{Binding CanOperate}" Padding="10,3"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                    ToolTip.Tip="{StaticResource str.Tip.TP.PovSource}"
                    IsVisible="{Binding PovSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding PovSource}" Foreground="#7FB6E8"
                         FontSize="11" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.PovHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource str.TP.Loc}"
                       Foreground="#999999" Margin="0,0,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding PovX}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PovY}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PovZ}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the camera's cached POV Location FVector in GWorld -->
              <Button Content="{StaticResource str.TP.LocateCamLoc}"
                      Command="{Binding LocateCameraLocationInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateCamLoc}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource str.TP.Rot}"
                       Foreground="#999999" Margin="0,2,8,2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding PovPitch}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PovYaw}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PovRoll}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the camera's cached POV Rotation FRotator in GWorld -->
              <Button Content="{StaticResource str.TP.LocateCamRot}"
                      Command="{Binding LocateCameraRotationInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateCamRot}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource str.TP.Fov}"
                       Foreground="#999999" Margin="0,2,8,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding PovFov}" Foreground="#DDDDDD" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
              <!-- Locate the camera's cached POV FOV float in GWorld -->
              <Button Content="{StaticResource str.TP.LocateCamFov}"
                      Command="{Binding LocateCameraFovInGWorldCommand}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.LocateCamFov}"
                      IsEnabled="{Binding CanOperate}"
                      Foreground="#4EC9B0" Background="Transparent"
                      BorderThickness="1" BorderBrush="#4EC9B0"
                      Padding="6,1" FontSize="11" Cursor="Hand" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding PovDelta}" Foreground="#7FB6E8"
                     FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding PovDelta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Border>

      <!-- ── Markers ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="6">
          <TextBlock Text="{StaticResource str.TP.MarkersHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding Markers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeleportMarkerRow">
                <Grid ColumnDefinitions="80,Auto,Auto,Auto,Auto,*" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Label}"
                             Foreground="#CCCCCC" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="{StaticResource str.TP.Save}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).SaveMarkerCommand}"
                          CommandParameter="{Binding Slot}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.Save}"
                          IsEnabled="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).CanOperate}"
                          Padding="10,3" Margin="2,0"/>
                  <Button Grid.Column="2" Content="{StaticResource str.TP.Recall}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).RecallMarkerCommand}"
                          CommandParameter="{Binding Slot}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.Recall}"
                          IsEnabled="{Binding Valid}"
                          Padding="10,3" Margin="2,0"/>
                  <Button Grid.Column="3" Content="{StaticResource str.TP.Force}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).ForceRecallMarkerCommand}"
                          CommandParameter="{Binding Slot}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.Force}"
                          IsEnabled="{Binding Valid}"
                          Padding="10,3" Margin="2,0"/>
                  <Button Grid.Column="4" Content="{StaticResource str.TP.Clear}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).ClearMarkerCommand}"
                          CommandParameter="{Binding Slot}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.Clear}"
                          IsEnabled="{Binding Valid}"
                          Padding="10,3" Margin="2,0"/>
                  <TextBlock Grid.Column="5" Text="{Binding Summary}"
                             Foreground="#999999" FontFamily="Consolas, monospace"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ── Last position (system auto-saved; recall-only) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="6">
          <TextBlock Text="{StaticResource str.TP.LastHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <TextBlock Text="{StaticResource str.TP.LastHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
            <Button Grid.Column="0" Content="{StaticResource str.TP.RecallLast}"
                    Command="{Binding RecallLastCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.RecallLast}"
                    IsEnabled="{Binding CanRecallLast}"
                    Padding="12,4" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding LastSummary}"
                       Foreground="#999999" FontFamily="Consolas, monospace"
                       VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Marker hotkeys (user-set via key capture) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10"
              IsVisible="{Binding CanBindCursorHotkey}">
        <StackPanel Spacing="6">
          <TextBlock Text="{StaticResource str.TP.HkHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <TextBlock Text="{StaticResource str.TP.HkHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <!-- Startup conflict banner: a saved combo another app already holds -->
          <Border Background="#3A2A1A" BorderBrush="#E0A030" BorderThickness="1"
                  CornerRadius="3" Padding="8,4"
                  IsVisible="{Binding HasHotkeyWarning}">
            <TextBlock Text="{Binding HotkeyWarning}" Foreground="#E0A030"
                       FontSize="11" TextWrapping="Wrap"/>
          </Border>
          <ItemsControl ItemsSource="{Binding HotkeyRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TeleportHotkeyRow">
                <Grid ColumnDefinitions="150,120,Auto,Auto" Margin="0,2"
                      ToolTip.Tip="{Binding Hint}">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                             Foreground="#CCCCCC" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Background="#333337" CornerRadius="3"
                          Padding="6,2" Margin="2,0" MinWidth="90"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DisplayLabel}"
                               Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Button Grid.Column="2" Content="{Binding CaptureButtonText}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).BeginCaptureCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.HkSet}"
                          Padding="10,3" Margin="2,0" MinWidth="58"/>
                  <Button Grid.Column="3" Content="{StaticResource str.TP.HkClear}"
                          Command="{Binding $parent[UserControl].((vm:TeleportViewModel)DataContext).ClearHotkeyCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding HasBinding}"
                          ToolTip.Tip="{StaticResource str.Tip.TP.HkClear}"
                          Padding="10,3" Margin="2,0"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="#2D2D30" CornerRadius="3" Padding="6,2"
                  HorizontalAlignment="Left"
                  IsVisible="{Binding LastHotkeyFired, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LastHotkeyFired}" Foreground="#9CDCFE" FontSize="11"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ── Cursor teleport ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.TP.CursorHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.ToCursor}"
                    Command="{Binding TeleportToCursorCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.ToCursor}"
                    IsEnabled="{Binding CanOperate}"
                    Classes="accent" Padding="12,4"/>
            <TextBlock Text="{StaticResource str.TP.ZOffset}" Foreground="#999999"
                       VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding ZOffset}" Minimum="0" Maximum="100000"
                           Increment="10" Width="120"
                           ToolTip.Tip="{StaticResource str.Tip.TP.ZOffset}"/>
            <TextBlock Text="{StaticResource str.TP.Channel}" Foreground="#999999"
                       VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding TraceChannel}" Minimum="0" Maximum="32"
                           Increment="1" Width="130" Padding="4,2"
                           ToolTip.Tip="{StaticResource str.Tip.TP.Channel}"/>
          </StackPanel>
          <CheckBox Content="{StaticResource str.TP.FallbackCenter}"
                    IsChecked="{Binding FallbackToCenter}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.FallbackCenter}"
                    Foreground="#CCCCCC" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding CanBindCursorHotkey}">
            <CheckBox Content="{StaticResource str.TP.CursorHotkey}"
                      IsChecked="{Binding CursorHotkeyEnabled}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.CursorHotkey}"
                      Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1"
                    IsVisible="{Binding CursorHotkeyLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CursorHotkeyLabel}" Foreground="#4EC9B0"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Teleport in facing direction ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.TP.RelHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.RelGo}"
                    Command="{Binding TeleportRelativeCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.RelGo}"
                    IsEnabled="{Binding CanOperate}"
                    Classes="accent" Padding="12,4"/>
            <TextBlock Text="{StaticResource str.TP.RelDist}" Foreground="#999999"
                       VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding RelativeDistance}" Minimum="-100000" Maximum="100000"
                           Increment="10" Width="150"
                           ToolTip.Tip="{StaticResource str.Tip.TP.RelDist}"/>
          </StackPanel>
          <CheckBox Content="{StaticResource str.TP.RelHoriz}"
                    IsChecked="{Binding RelativeHorizontal}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.RelHoriz}"
                    Foreground="#CCCCCC" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- ── Teleport to coordinates (force) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.TP.CoordHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource str.TP.CoordXyz}"
                       Foreground="#999999" Margin="0,0,8,4" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Value="{Binding CoordX}" Increment="10" Width="135" FormatString="0.###"/>
              <NumericUpDown Value="{Binding CoordY}" Increment="10" Width="135" FormatString="0.###"/>
              <NumericUpDown Value="{Binding CoordZ}" Increment="10" Width="135" FormatString="0.###"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource str.TP.CoordPyr}"
                       Foreground="#999999" Margin="0,4,8,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
              <NumericUpDown Value="{Binding CoordPitch}" Increment="1" Width="135" FormatString="0.##"
                             IsEnabled="{Binding CoordSetRotation}"/>
              <NumericUpDown Value="{Binding CoordYaw}" Increment="1" Width="135" FormatString="0.##"
                             IsEnabled="{Binding CoordSetRotation}"/>
              <NumericUpDown Value="{Binding CoordRoll}" Increment="1" Width="135" FormatString="0.##"
                             IsEnabled="{Binding CoordSetRotation}"/>
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.CoordGo}"
                    Command="{Binding TeleportToCoordsCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CoordGo}"
                    IsEnabled="{Binding CanOperate}"
                    Classes="accent" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.CoordFill}"
                    Command="{Binding FillCoordsFromCurrentCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CoordFill}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <CheckBox Content="{StaticResource str.TP.CoordSetRot}"
                      IsChecked="{Binding CoordSetRotation}"
                      ToolTip.Tip="{StaticResource str.Tip.TP.CoordSetRot}"
                      Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Debug Camera (free-look) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.DcHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.DcState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding DebugCameraState}"
                         Foreground="{Binding DebugCameraBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.DcHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.DcOn}"
                    Command="{Binding ForceDebugCameraOnCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.DcOn}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.DcOff}"
                    Command="{Binding ForceDebugCameraOffCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.DcOff}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.DcRefresh}"
                    Command="{Binding RefreshDebugCameraCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.DcRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── God Mode (Solitar — force AActor.bCanBeDamaged) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.GmHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.GmState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding GodModeState}"
                         Foreground="{Binding GodModeBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.GmHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.GmOn}"
                    Command="{Binding ForceGodModeOnCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GmOn}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GmOff}"
                    Command="{Binding ForceGodModeOffCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GmOff}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GmRefresh}"
                    Command="{Binding RefreshGodModeCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GmRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
            <Button Content="{StaticResource str.TP.GmCopyScript}"
                    Command="{Binding CopyGodModeScriptCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GmCopyScript}"
                    Padding="10,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Move Speed multiplier (Laufen — force MaxWalkSpeed) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.MsHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.MsState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding MoveSpeedState}"
                         Foreground="{Binding MoveSpeedBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.MsHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding MoveSpeedCurrentText}"
                     Foreground="#BBBBBB" FontSize="12"/>
          <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0" Minimum="-1" Maximum="1"
                    Value="{Binding MoveSpeedExponent}"
                    IsEnabled="{Binding CanOperate}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding MoveSpeedPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="56"
                       TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.MsApply}"
                    Command="{Binding ApplyMoveSpeedCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.MsApply}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.MsReset}"
                    Command="{Binding ResetMoveSpeedCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.MsReset}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.MsRefresh}"
                    Command="{Binding RefreshMoveSpeedCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.MsRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
            <Button Content="{StaticResource str.TP.MsLocate}"
                    Command="{Binding LocateMoveSpeedInGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.MsLocate}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Gravity multiplier (Laufen — force GravityScale) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.GrHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.GrState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding GravityState}"
                         Foreground="{Binding GravityBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.GrHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding GravityCurrentText}"
                     Foreground="#BBBBBB" FontSize="12"/>
          <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0" Minimum="-1" Maximum="1"
                    Value="{Binding GravityExponent}"
                    IsEnabled="{Binding CanOperate}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding GravityPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="56"
                       TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.GrApply}"
                    Command="{Binding ApplyGravityCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GrApply}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GrReset}"
                    Command="{Binding ResetGravityCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GrReset}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GrRefresh}"
                    Command="{Binding RefreshGravityCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GrRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
            <Button Content="{StaticResource str.TP.GrLocate}"
                    Command="{Binding LocateGravityInGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GrLocate}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Super Jump toggle (Laufen — force JumpZVelocity) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.SjHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.SjState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding SuperJumpState}"
                         Foreground="{Binding SuperJumpBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.SjHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SuperJumpCurrentText}"
                     Foreground="#BBBBBB" FontSize="12"/>
          <Grid ColumnDefinitions="*,Auto">
            <!-- Max = log10(30) ≈ 1.4771 → 3000% jump height (velocity ×√30 ≈ 5.48,
                 within the DLL's ×10 multiplier cap). -->
            <Slider Grid.Column="0" Minimum="-1" Maximum="1.4771"
                    Value="{Binding SuperJumpExponent}"
                    IsEnabled="{Binding CanOperate}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding SuperJumpPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="56"
                       TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.SjOn}"
                    Command="{Binding ForceSuperJumpOnCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SjOn}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.SjOff}"
                    Command="{Binding ForceSuperJumpOffCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SjOff}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.SjReset}"
                    Command="{Binding ResetSuperJumpCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SjReset}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.SjRefresh}"
                    Command="{Binding RefreshSuperJumpCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SjRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
            <Button Content="{StaticResource str.TP.SjLocate}"
                    Command="{Binding LocateSuperJumpInGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SjLocate}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.SjHotkeyHint}"
                     Foreground="#777777" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ── Gravity Direction (Laufen — UE5.4+ GravityDirection vector) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.GdHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.GdState}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding GravDirState}"
                         Foreground="{Binding GravDirBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.GdHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding GravDirCurrentText}"
                     Foreground="#BBBBBB" FontSize="12"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#999999"
                       MinWidth="14" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="1"
                    Value="{Binding GravDirX}" IsEnabled="{Binding CanOperate}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GravDirXPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="52"
                       TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Foreground="#999999"
                       MinWidth="14" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1"
                    Value="{Binding GravDirY}" IsEnabled="{Binding CanOperate}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GravDirYPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="52"
                       TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" Foreground="#999999"
                       MinWidth="14" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="1"
                    Value="{Binding GravDirZ}" IsEnabled="{Binding CanOperate}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GravDirZPercentText}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" MinWidth="52"
                       TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.GdApply}"
                    Command="{Binding ApplyGravDirCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GdApply}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GdReset}"
                    Command="{Binding ResetGravDirCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GdReset}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.GdRefresh}"
                    Command="{Binding RefreshGravDirCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GdRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
            <Button Content="{StaticResource str.TP.GdLocate}"
                    Command="{Binding LocateGravDirInGWorldCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.GdLocate}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.GdHotkeyHint}"
                     Foreground="#777777" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ── Force mouse cursor (writes bShowMouseCursor) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{StaticResource str.TP.CursorForceHeader}"
                       Foreground="#DDDDDD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{StaticResource str.TP.CursorStateLabel}" Foreground="#999999"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Background="#333337" CornerRadius="3" Padding="6,1">
              <TextBlock Text="{Binding MouseCursorState}"
                         Foreground="{Binding MouseCursorBadgeColor}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{StaticResource str.TP.CursorForceHint}"
                     Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.CursorOn}"
                    Command="{Binding ForceCursorOnCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CursorOn}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.CursorOff}"
                    Command="{Binding ForceCursorOffCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CursorOff}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
            <Button Content="{StaticResource str.TP.CursorRefresh}"
                    Command="{Binding RefreshCursorCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CursorRefresh}"
                    IsEnabled="{Binding CanOperate}" Padding="10,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── BugItGo interop ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <!-- Near the bottom of the scrollable tab → same upward-flip tooltip
             flicker as the CE export card below. Force the tip above the button. -->
        <Border.Styles>
          <Style Selector="Button">
            <Setter Property="ToolTip.Placement" Value="Top"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
          </Style>
        </Border.Styles>
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.TP.BugHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{StaticResource str.TP.CopyBugItGo}"
                    Command="{Binding CopyAsBugItGoCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.CopyBugItGo}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding BugItGoInput}"
                     PlaceholderText="{StaticResource str.TP.BugHint}"
                     Width="440" Padding="4,2"
                     FontFamily="Consolas, monospace"/>
            <Button Content="{StaticResource str.TP.RunBugItGo}"
                    Command="{Binding RunBugItGoCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.RunBugItGo}"
                    IsEnabled="{Binding CanOperate}" Padding="12,4"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── CE export (records into CE via AOBMaker; .CT is the backup) ── -->
      <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
              CornerRadius="4" Padding="10">
        <!-- This is the bottom-most card in the scrollable tab, so the default
             "Pointer" tooltip placement flips UPWARD and lands on the cursor —
             cursor leaves the button, hover ends, tooltip dismisses, cursor
             re-enters, repeat (seen as the background flickering). Force the tip
             above the button, away from the cursor (same fix as ProxyDeployPanel's
             bottom button bar + LiveWalker's bottom Functions grid). -->
        <Border.Styles>
          <Style Selector="Button">
            <Setter Property="ToolTip.Placement" Value="Top"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-4"/>
          </Style>
        </Border.Styles>
        <StackPanel Spacing="8">
          <TextBlock Text="{StaticResource str.TP.CeHeader}"
                     Foreground="#DDDDDD" FontWeight="SemiBold"/>
          <WrapPanel Orientation="Horizontal">
            <Button Content="{StaticResource str.TP.AddActions}"
                    Command="{Binding AddActionsToCeCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.AddActions}"
                    Padding="12,4" Margin="0,0,8,4"/>
            <Button Content="{StaticResource str.TP.SaveCt}"
                    Command="{Binding SaveCtCommand}"
                    ToolTip.Tip="{StaticResource str.Tip.TP.SaveCt}"
                    Padding="12,4" Margin="0,0,8,4"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Status + error -->
      <TextBlock Text="{Binding StatusText}" Foreground="#9CDCFE"
                 FontSize="12" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F48771"
                 FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
