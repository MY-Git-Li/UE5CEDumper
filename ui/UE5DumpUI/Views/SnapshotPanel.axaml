<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UE5DumpUI.ViewModels"
             xmlns:m="using:UE5DumpUI.Models"
             x:Class="UE5DumpUI.Views.SnapshotPanel"
             x:DataType="vm:SnapshotViewModel">

  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,150,Auto,Auto,*">

    <!-- Intro -->
    <TextBlock Grid.Row="0" Text="{StaticResource str.Snapshot.Intro}"
               Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <!-- Capture controls -->
    <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="12" Margin="0,0,0,10"
            BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{StaticResource str.Snapshot.Scope}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" MinWidth="150"/>
          <CheckBox Content="{StaticResource str.Snapshot.GameOnly}" IsChecked="{Binding GameOnly}" Foreground="#CCCCCC"/>
          <TextBlock Text="{StaticResource str.Snapshot.Quota}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
          <ComboBox ItemsSource="{Binding QuotaOptions}" SelectedItem="{Binding SelectedQuotaLabel}"
                    MinWidth="110" ToolTip.Tip="{StaticResource str.Snapshot.QuotaHint}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{StaticResource str.Snapshot.Label}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Label}" PlaceholderText="{StaticResource str.Snapshot.LabelWatermark}" Width="340"/>
          <Button Content="{StaticResource str.Snapshot.Capture}" Command="{Binding CaptureCommand}"
                  IsEnabled="{Binding CanCapture}" IsVisible="{Binding !IsCapturing}"
                  Classes="accent" Padding="12,5" FontWeight="Bold"/>
          <Button Content="{StaticResource str.Snapshot.Cancel}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsCapturing}" Padding="12,5"/>
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Width="220" Height="6"
                       IsVisible="{Binding IsCapturing}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{StaticResource str.Snapshot.NotConnected}" Foreground="#888" FontSize="11"
                   IsVisible="{Binding !CanCapture}"/>
        <TextBlock Text="{Binding StatusText}" Foreground="#4EC9B0" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F44747" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Usage / quota -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Snapshot.Usage}" Foreground="#999" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding UsageText}" Foreground="#D4D4D4" FontFamily="Consolas"
                 VerticalAlignment="Center" MinWidth="150"/>
      <ProgressBar Value="{Binding UsageRatio}" Minimum="0" Maximum="1" Width="180" Height="6"
                   IsVisible="{Binding ShowUsageBar}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding AllGamesText}" Foreground="#777" FontSize="11"
                 VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>

    <!-- Saved-snapshots header + actions -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6" VerticalAlignment="Center">
      <TextBlock Text="{StaticResource str.Snapshot.Saved}" Foreground="#9CDCFE"
                 FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="{StaticResource str.Snapshot.Refresh}" Command="{Binding RefreshCommand}" Padding="8,3"/>
      <Button Content="{StaticResource str.Snapshot.Delete}" Command="{Binding DeleteCommand}"
              CommandParameter="{Binding SelectedSnapshot}" Padding="8,3"/>
    </StackPanel>

    <!-- Snapshot list (fixed height; diff grid gets the remaining space) -->
    <DataGrid Grid.Row="4" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Label}"    Binding="{Binding Label}"          Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Captured}" Binding="{Binding CapturedAt}"     Width="190"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Objects}"  Binding="{Binding ObjectCount}"    Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Fields}"   Binding="{Binding FieldCount}"     Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Size}"     Binding="{Binding EstSizeDisplay}" Width="90"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Scope}"    Binding="{Binding Scope}"          Width="130"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Col.Ue}"       Binding="{Binding UeVersion}"      Width="60"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Diff controls -->
    <Border Grid.Row="5" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,10,0,8"
            BorderBrush="#3C3C3C" BorderThickness="1">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{StaticResource str.Snapshot.Diff.Header}" Foreground="#9CDCFE"
                     FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.Old}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiffA}" MinWidth="170" Margin="0,0,8,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.New}" Foreground="#CCCCCC"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding DiffB}" MinWidth="170" Margin="0,0,8,0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="m:SnapshotMeta">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{StaticResource str.Snapshot.Diff.Run}" Command="{Binding RunDiffCommand}"
                  IsEnabled="{Binding CanRunDiff}" Classes="accent" Padding="12,4" Margin="0,0,8,0"
                  ToolTip.Tip="{StaticResource str.Snapshot.Diff.Hint}"/>
          <Button Content="{StaticResource str.Snapshot.Diff.CopyAddr}" Command="{Binding CopyDiffAddressCommand}"
                  CommandParameter="{Binding SelectedDiffRow}" Padding="8,4"/>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{StaticResource str.Snapshot.Diff.ClassFilter}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
          <TextBox Text="{Binding DiffClassFilter}" Width="140"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.PropFilter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <TextBox Text="{Binding DiffPropFilter}" Width="140"/>
          <TextBlock Text="{StaticResource str.Snapshot.Diff.Dir}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <ComboBox ItemsSource="{Binding DiffDirectionOptions}" SelectedItem="{Binding SelectedDiffDirection}" MinWidth="120"/>
          <TextBlock Text="{Binding DiffStatusText}" Foreground="#4EC9B0" FontSize="12"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Diff results -->
    <DataGrid Grid.Row="7" ItemsSource="{Binding DiffRows}" SelectedItem="{Binding SelectedDiffRow}"
              IsReadOnly="True" GridLinesVisibility="Horizontal" Background="#1E1E1E"
              CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Change}" Binding="{Binding DirectionGlyph}" Width="40"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Class}"  Binding="{Binding ClassName}"      Width="200"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Object}" Binding="{Binding NormPath}"       Width="*"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Field}"  Binding="{Binding PropName}"       Width="160"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.Old}"    Binding="{Binding OldValue}"       Width="120"/>
        <DataGridTextColumn Header="{StaticResource str.Snapshot.Diff.Col.New}"    Binding="{Binding NewValue}"       Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
